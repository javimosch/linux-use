}

// ---------------------------------------------------------------- constants

// Exit codes (cli-output-spec: semantic, 80-119).
var EX_OK = 0
var EX_USAGE = 80
var EX_NO_A11Y = 81
var EX_APP_NOT_FOUND = 82
var EX_REF_STALE = 83
var EX_REF_NOT_FOUND = 84
var EX_NO_CAPABILITY = 85
var EX_ACTION_FAILED = 86
var EX_NO_DISPLAY = 87
var EX_DAEMON = 88
var EX_REFUSED = 89
var EX_RSS_LIMIT = 90
var EX_NO_INJECTOR = 91
var EX_EXT = 100
var EX_INTERNAL = 110

// AT-SPI enum ordinals (verified against atspi-constants.h on 2.44).
var ST_ACTIVE = 1
var ST_EDITABLE = 7
var ST_ENABLED = 8
var ST_FOCUSABLE = 11
var ST_FOCUSED = 12
var ST_SENSITIVE = 24
var ST_SHOWING = 25
var ST_VISIBLE = 30
var COORD_SCREEN = 0
var KEY_STRING = 4

var VERSION = "0.9.1"
var SCHEMA = "linux-use/v1"

// ---------------------------------------------------------------- json utils

func jesc(s) (r) {
	r = ""
	i := 0
	while i < len(s) {
		c := charat(s, i)
		if c == "\"" {
			r = r + "\\\""
		} else {
			if c == "\\" {
				r = r + "\\\\"
			} else {
				if c == "\n" {
					r = r + "\\n"
				} else {
					if c == "\t" {
						r = r + "\\t"
					} else {
						if c == "\r" {
							r = r + "\\r"
						} else {
							r = r + c
						}
					}
				}
			}
		}
		i = i + 1
	}
}

func jstr(s) (r) {
	r = "\"" + jesc(s) + "\""
}

func jkv(k, v) (r) {
	r = jstr(k) + ":" + v
}

func jarr(items) (r) {
	r = "[" + join(items, ",") + "]"
}

func jbool(b) (r) {
	r = "false"
	if b {
		r = "true"
	}
}

// ---------------------------------------------------------------- errors

// errjson builds the cli-output-spec error envelope.
func errjson(exitcode, typ, msg, recoverable, suggestions) (r) {
	sg := []string{}
	i := 0
	while i < len(suggestions) {
		sg = append(sg, jstr(suggestions[i]))
		i = i + 1
	}
	r = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "false") + "," + jkv("error", "{" + jkv("code", str(exitcode)) + "," + jkv("type", jstr(typ)) + "," + jkv("message", jstr(msg)) + "," + jkv("recoverable", jbool(recoverable)) + "," + jkv("suggestions", jarr(sg)) + "}") + "}"
}

// ---------------------------------------------------------------- fingerprints

// fp is a stable-ish identity for a node: role + name, hashed. Element refs
// carry it so a stale ref is DETECTED rather than silently acting on the
// wrong widget.
func fp(role, name) (r) {
	b := bytes(role + "|" + name)
	h := 2166136261
	i := 0
	n := len(role) + 1 + len(name)
	while i < n {
		h = (h*131 + byte_at(b, i)) % 1000000007
		i = i + 1
	}
	r = str(h)
}

func mkref(app, path, role, name) (r) {
	r = app + ":" + path + "#" + fp(role, name)
}

// splitref returns (app, path, wantfp).
func splitref(ref) (app, path, want) {
	app = ""
	path = ""
	want = ""
	// Split the fingerprint on the LAST '#': the app part may itself contain
	// '#pid<N>' when a name is shared by several processes.
	hp := split(ref, "#")
	left := hp[0]
	if len(hp) > 1 {
		want = hp[len(hp)-1]
		i := 1
		while i < len(hp)-1 {
			left = left + "#" + hp[i]
			i = i + 1
		}
	}
	parts := split(left, ":")
	if len(parts) < 2 {
		return
	}
	path = parts[len(parts)-1]
	app = join(parts[0:len(parts)-1], ":")
}

// ---- geometry refs -------------------------------------------------------
//
// Some toolkits break parent/child reciprocity: a node's get_parent() returns
// a container that does NOT list it among its children (observed in
// gnome-control-center/libadwaita, where a `filler` reports a parent panel
// with children=1 that does not contain it, and index_in_parent = -1). Such a
// node is reachable top-down but has no provable child-index path, so a
// path-shaped ref is impossible — not merely unknown.
//
// Those nodes get a GEOMETRY ref instead:
//     app:@<roleId>~<x>,<y>,<w>,<h>#<fingerprint>
// resolved by a collection query for that role, matched on exact extents and
// verified by the same role+name fingerprint. Ambiguity (two widgets with the
// same role at the same rectangle) is reported, never guessed.

func geomref(app, roleid, x, y, w, h, role, name) (r) {
	r = app + ":@" + str(roleid) + "~" + str(x) + "," + str(y) + "," + str(w) + "," + str(h) + "#" + fp(role, name)
}

func is_geom(path) (b) {
	b = has_prefix(path, "@")
}

// resolve_geom finds the unique showing node of the given role at exactly the
// given rectangle. Returns (node, count) — count != 1 means ambiguous/absent.
func resolve_geom(app, spec) (node, found) {
	node = 0
	found = 0
	body := substr(spec, 1, len(spec))
	parts := split(body, "~")
	if len(parts) < 2 {
		return
	}
	roleid := parse_int(parts[0])
	nums := split(parts[1], ",")
	if len(nums) < 4 {
		return
	}
	wx := parse_int(nums[0])
	wy := parse_int(nums[1])
	ww := parse_int(nums[2])
	wh := parse_int(nums[3])

	ra := lu_roles_new()
	lu_roles_add(ra, roleid)
	rule := lu_rule_new(ra, 1)
	nwin := atspi_accessible_get_child_count(app, 0)
	i := 0
	while i < nwin {
		win := atspi_accessible_get_child_at_index(app, i, 0)
		if win != 0 {
			arr := lu_matches(win, rule, 20000)
			if arr != 0 {
				cnt := lu_arr_len(arr)
				j := 0
				while j < cnt {
					c := lu_arr_get(arr, j)
					if c != 0 {
						x, y, w, h := extents(c)
						if x == wx && y == wy && w == ww && h == wh {
							found = found + 1
							if found == 1 {
								node = g_object_ref(c)
							}
						}
					}
					j = j + 1
				}
				lu_arr_free(arr)
			}
			g_object_unref(win)
		}
		i = i + 1
	}
	lu_rule_free(rule)
	lu_roles_free(ra)
	if found != 1 && node != 0 {
		g_object_unref(node)
		node = 0
	}
}

// ---------------------------------------------------------------- atspi core

var desktop = 0
var wantPid = 0
var appAmbiguous = 0

func a11y_up() (ok) {
	ok = false
	if desktop != 0 {
		ok = true
		return
	}
	rc := atspi_init()
	if rc < 0 {
		return
	}
	desktop = atspi_get_desktop(0)
	if desktop == 0 {
		return
	}
	ok = true
}

// takestr consumes a heap `gchar*` from AT-SPI: alias it, copy it into an
// owned MFL string, then free the original. A `string` returned across the FFI
// boundary ALIASES the C buffer rather than copying it, so the copy here is
// load-bearing — without it the value dangles the moment the pointer is freed.
// takestr_borrowed copies a C string the caller does NOT own (so no free).
func takestr_borrowed(v) (r) {
	r = bytes_str(bytes(v))
}

func takestr(p) (r) {
	r = ""
	if p == 0 {
		return
	}
	// bytes_str(bytes(...)) forces a MATERIALIZED copy. substr()/len() on an
	// FFI-aliased string are lazy enough that the g_free below would otherwise
	// leave the result reading freed memory (observed as silently TRUNCATED
	// strings, not a crash).
	r = bytes_str(bytes(lu_cstr(p)))
	g_free(p)
}

func nodename(node) (r) {
	r = takestr(atspi_accessible_get_name(node, 0))
}

func noderole(node) (r) {
	r = takestr(atspi_accessible_get_role_name(node, 0))
}

func hasstate(node, st) (b) {
	b = false
	ss := atspi_accessible_get_state_set(node)
	if ss != 0 {
		b = atspi_state_set_contains(ss, st)
		g_object_unref(ss)
	}
}

// apps_named counts how many applications publish a name — used to decide
// whether an emitted ref must be qualified with a pid to stay resolvable.
func apps_named(nm) (n) {
	n = 0
	c := atspi_accessible_get_child_count(desktop, 0)
	i := 0
	while i < c {
		a := atspi_accessible_get_child_at_index(desktop, i, 0)
		if a != 0 {
			if nodename(a) == nm {
				n = n + 1
			}
			g_object_unref(a)
		}
		i = i + 1
	}
}

// qualify_app returns the app name to embed in refs: bare when unique, or
// "<name>#pid<PID>" when the name is shared, so that every ref this tool hands
// out can actually be resolved.
func qualify_app(a, nm) (r) {
	r = nm
	if apps_named(nm) > 1 {
		r = nm + "#pid" + str(atspi_accessible_get_process_id(a, 0))
	}
}

// app_matches reports whether an application satisfies a --app/--pid filter,
// honouring the "<name>#pid<PID>" form so windows/find filter the same way
// findapp resolves.
func app_matches(a, nm, filter) (b) {
	sel := filter
	pid := wantPid
	hp := split(filter, "#pid")
	if len(hp) == 2 {
		sel = hp[0]
		pid = parse_int(hp[1])
	}
	b = len(sel) == 0 || nm == sel
	if b && pid > 0 {
		b = atspi_accessible_get_process_id(a, 0) == pid
	}
}

// findapp resolves an application selector to a NEW ref (caller unrefs), or 0.
//
// The selector is either a plain accessible name, or "<name>#pid<PID>" to
// disambiguate when two processes publish the same name (two browser windows
// of different profiles both call themselves "Microsoft Edge"). `wantPid` set
// non-zero has the same effect and wins.
//
// A plain name matching MORE THAN ONE application is REFUSED (appAmbiguous is
// set and 0 returned) rather than silently resolving to whichever comes first
// in the desktop's child list — picking one at random is exactly the kind of
// confident wrong answer this tool refuses to give.
func findapp(want) (app) {
	app = 0
	appAmbiguous = 0
	sel := want
	pid := wantPid
	hp := split(want, "#pid")
	if len(hp) == 2 {
		sel = hp[0]
		pid = parse_int(hp[1])
	}
	matches := 0
	n := atspi_accessible_get_child_count(desktop, 0)
	i := 0
	while i < n {
		a := atspi_accessible_get_child_at_index(desktop, i, 0)
		if a != 0 {
			hit := nodename(a) == sel
			if hit && pid > 0 {
				hit = atspi_accessible_get_process_id(a, 0) == pid
			}
			if hit {
				matches = matches + 1
				if app == 0 {
					app = a
				} else {
					g_object_unref(a)
				}
			} else {
				g_object_unref(a)
			}
		}
		i = i + 1
	}
	if matches > 1 {
		appAmbiguous = matches
		g_object_unref(app)
		app = 0
	}
}

// resolve walks a slash path from app. Returns a NEW ref, or 0.
func resolve(app, path) (node) {
	node = app
	first := true
	segs := split(path, "/")
	i := 0
	while i < len(segs) {
		s := segs[i]
		if len(s) > 0 {
			c := atspi_accessible_get_child_at_index(node, parse_int(s), 0)
			if !first {
				g_object_unref(node)
			}
			first = false
			node = c
			if node == 0 {
				return
			}
		}
		i = i + 1
	}
	if first {
		// path was empty: hand back an owned ref to the app itself
		node = atspi_accessible_get_child_at_index(app, 0, 0)
	}
}

// extents returns (x, y, w, h); w<=0 means unknown.
func extents(node) (x, y, w, h) {
	x = 0
	y = 0
	w = 0
	h = 0
	comp := atspi_accessible_get_component_iface(node)
	if comp == 0 {
		return
	}
	r := atspi_component_get_extents(comp, COORD_SCREEN, 0)
	if r != 0 {
		x = peek_i32(r, 0)
		y = peek_i32(r, 4)
		w = peek_i32(r, 8)
		h = peek_i32(r, 12)
		free(r)
	}
	g_object_unref(comp)
}

func interactive(role) (b) {
	b = false
	rs := interactive_roles()
	i := 0
	while i < len(rs) {
		if rs[i] == role {
			b = true
			return
		}
		i = i + 1
	}
}

// interactive_roles is the default element filter, as role NAMES. The walk
// matches these by string; the collection query converts them to AtspiRole
// ordinals and lets the server do the matching.
func interactive_roles() (r) {
	r = []string{}
	r = append(r, "push button")
	r = append(r, "toggle button")
	r = append(r, "check box")
	r = append(r, "radio button")
	r = append(r, "menu item")
	r = append(r, "check menu item")
	r = append(r, "radio menu item")
	r = append(r, "entry")
	r = append(r, "text")
	r = append(r, "password text")
	r = append(r, "combo box")
	r = append(r, "link")
	r = append(r, "list item")
	r = append(r, "page tab")
	r = append(r, "slider")
	r = append(r, "menu")
	r = append(r, "table cell")
	r = append(r, "spin button")
}

// collect runs a server-side collection query and returns JSON rows. ok=false
// means the app exposes no Collection interface and the caller must fall back
// to walking. Unmatched roles are reported so a typo is not silent.
func collect(appname, app, rolefilter, maxnodes) (out, keys, n, ok, unknown, unpathed) {
	out = []string{}
	keys = []string{}
	n = 0
	ok = false
	unknown = ""
	unpathed = 0
	geomrefs = 0
	cacheOn = true
	pcache_reset()
	names := interactive_roles()
	if len(rolefilter) > 0 {
		names = []string{rolefilter}
	}
	ra := lu_roles_new()
	added := 0
	i := 0
	while i < len(names) {
		rid := lu_role_from_name(names[i])
		if rid >= 0 {
			lu_roles_add(ra, rid)
			added = added + 1
		} else {
			if len(unknown) == 0 {
				unknown = names[i]
			}
		}
		i = i + 1
	}
	if added == 0 {
		lu_roles_free(ra)
		return
	}
	rule := lu_rule_new(ra, 1)
	// The Collection interface does not traverse down from an APPLICATION
	// node — it is implemented per top-level window. Query each window.
	nwin := atspi_accessible_get_child_count(app, 0)
	w := 0
	while w < nwin {
		win := atspi_accessible_get_child_at_index(app, w, 0)
		if win != 0 {
			arr := lu_matches(win, rule, maxnodes)
			if arr != 0 {
				ok = true
				cnt := lu_arr_len(arr)
				i = 0
				while i < cnt {
					node := lu_arr_get(arr, i)
					if node != 0 {
						role := noderole(node)
						name := nodename(node)
						if len(wantText) == 0 || contains(to_lower(name), to_lower(wantText)) {
							x, y, wd, ht := extents(node)
							if wd > 0 && ht > 0 {
								// A match whose path cannot be rebuilt is still a
								// real element: emit it with ref_ok:false rather
								// than silently dropping it from the answer.
								path, an, pok := pathof(node)
								// appname may be pid-qualified for refs, but
								// pathof reports the RAW name — compare on that
								// or every ref silently downgrades to geometry.
								rawname := split(appname, "#pid")[0]
								refok := pok && an == rawname
								if !refok {
									// No provable path (broken parent/child
									// reciprocity). Addressable by geometry
									// instead of unusable.
									rid := lu_role_from_name(role)
									if rid >= 0 && wd > 0 && ht > 0 {
										geomrefs = geomrefs + 1
										gjs, gln, gk := nodegeomrow(appname, node, rid, x, y, wd, ht, role, name)
										out = append(out, pickfmt(gjs, gln))
										keys = append(keys, gk)
										n = n + 1
									} else {
										unpathed = unpathed + 1
										ujs, uln, uk := noderow(appname, node, path, role, name, false)
										out = append(out, pickfmt(ujs, uln))
										keys = append(keys, uk)
										n = n + 1
									}
								} else {
									ejs, eln, ek := noderow(appname, node, path, role, name, true)
									out = append(out, pickfmt(ejs, eln))
									keys = append(keys, ek)
									n = n + 1
								}
							}
						}
					}
					i = i + 1
				}
				lu_arr_free(arr)
			}
			g_object_unref(win)
		}
		w = w + 1
	}
	lu_rule_free(rule)
	lu_roles_free(ra)
}

// ---------------------------------------------------------------- tree walk

var rows = []string{}
var budget = 0
var visited = 0
var deepest = 0
var depthCut = false
var forceWalk = false
var forceCollection = false
var geomrefs = 0
var findMethod = "collection"
var wantAll = false
var wantRole = ""
var wantText = ""
var wantExpand = false
var wantInjector = ""
var wantExpandMax = 25
var wantExpandWait = 400
var wantFormat = "json"
var rowkeys = []string{}

// cleanline strips characters that would break one-element-per-line output.
func cleanline(s) (r) {
	r = replace(replace(s, "\t", " "), "\n", " ")
}

// pickfmt selects the row representation per --format.
func pickfmt(js, ln) (r) {
	r = js
	if wantFormat == "lines" {
		r = ln
	}
}

// stateflags renders the compact flag column for --format lines:
// d=isabled, f=focused, e=editable, plus caller extras (u=unpathable,
// g=geometry ref).
func stateflags(en, fo, ed, extra) (r) {
	r = ""
	if !en {
		r = r + "d"
	}
	if fo {
		r = r + "f"
	}
	if ed {
		r = r + "e"
	}
	r = r + extra
	if len(r) == 0 {
		r = "-"
	}
}

// noderow renders one element in BOTH output formats plus a dedup key. js is
// the JSON object, ln the --format lines row, and key identifies the node
// across expand passes (path for provable refs, role+name otherwise).
func noderow(appname, node, path, role, name, refok) (js, ln, key) {
	x, y, w, h := extents(node)
	nacts := 0
	act0 := ""
	ai := atspi_accessible_get_action_iface(node)
	if ai != 0 {
		nacts = atspi_action_get_n_actions(ai, 0)
		if nacts > 0 {
			act0 = takestr(atspi_action_get_action_name(ai, 0, 0))
		}
		g_object_unref(ai)
	}
	rf := ""
	if refok {
		rf = mkref(appname, path, role, name)
	}
	key = path
	if !refok {
		key = "U|" + role + "|" + name
	}
	en := hasstate(node, ST_ENABLED)
	fo := hasstate(node, ST_FOCUSED)
	ed := hasstate(node, ST_EDITABLE)
	fields := []string{}
	fields = append(fields, jkv("ref", jstr(rf)))
	fields = append(fields, jkv("ref_ok", jbool(refok)))
	fields = append(fields, jkv("ref_kind", jstr("path")))
	fields = append(fields, jkv("role", jstr(role)))
	fields = append(fields, jkv("name", jstr(name)))
	fields = append(fields, jkv("x", str(x)))
	fields = append(fields, jkv("y", str(y)))
	fields = append(fields, jkv("w", str(w)))
	fields = append(fields, jkv("h", str(h)))
	fields = append(fields, jkv("cx", str(x+w/2)))
	fields = append(fields, jkv("cy", str(y+h/2)))
	fields = append(fields, jkv("actions", str(nacts)))
	fields = append(fields, jkv("action", jstr(act0)))
	fields = append(fields, jkv("enabled", jbool(en)))
	fields = append(fields, jkv("focused", jbool(fo)))
	fields = append(fields, jkv("editable", jbool(ed)))
	js = "{" + join(fields, ",") + "}"
	lact := act0
	if nacts > 1 {
		lact = lact + "+" + str(nacts-1)
	}
	lxtra := ""
	if !refok {
		lxtra = "u"
	}
	ln = rf + "\t" + role + "\t" + cleanline(name) + "\t" + str(x) + "," + str(y) + "," + str(w) + "," + str(h) + "\t" + lact + "\t" + stateflags(en, fo, ed, lxtra)
}

// nodegeomrow is noderow for elements addressed by on-screen rectangle.
func nodegeomrow(appname, node, roleid, x, y, w, h, role, name) (js, ln, key) {
	nacts := 0
	act0 := ""
	ai := atspi_accessible_get_action_iface(node)
	if ai != 0 {
		nacts = atspi_action_get_n_actions(ai, 0)
		if nacts > 0 {
			act0 = takestr(atspi_action_get_action_name(ai, 0, 0))
		}
		g_object_unref(ai)
	}
	grf := geomref(appname, roleid, x, y, w, h, role, name)
	key = "G|" + role + "|" + name
	en := hasstate(node, ST_ENABLED)
	fo := hasstate(node, ST_FOCUSED)
	ed := hasstate(node, ST_EDITABLE)
	f := []string{}
	f = append(f, jkv("ref", jstr(grf)))
	f = append(f, jkv("ref_ok", "true"))
	f = append(f, jkv("ref_kind", jstr("geometry")))
	f = append(f, jkv("role", jstr(role)))
	f = append(f, jkv("name", jstr(name)))
	f = append(f, jkv("x", str(x)))
	f = append(f, jkv("y", str(y)))
	f = append(f, jkv("w", str(w)))
	f = append(f, jkv("h", str(h)))
	f = append(f, jkv("cx", str(x+w/2)))
	f = append(f, jkv("cy", str(y+h/2)))
	f = append(f, jkv("actions", str(nacts)))
	f = append(f, jkv("action", jstr(act0)))
	f = append(f, jkv("enabled", jbool(en)))
	f = append(f, jkv("focused", jbool(fo)))
	f = append(f, jkv("editable", jbool(ed)))
	js = "{" + join(f, ",") + "}"
	lact := act0
	if nacts > 1 {
		lact = lact + "+" + str(nacts-1)
	}
	ln = grf + "\t" + role + "\t" + cleanline(name) + "\t" + str(x) + "," + str(y) + "," + str(w) + "," + str(h) + "\t" + lact + "\t" + stateflags(en, fo, ed, "g")
}

func keep(role, name) (b) {
	b = true
	if !wantAll {
		b = interactive(role)
	}
	if b && len(wantRole) > 0 {
		b = role == wantRole
	}
	if b && len(wantText) > 0 {
		b = contains(to_lower(name), to_lower(wantText))
	}
}

// walk consumes `node` (does NOT unref it — the caller owns it).
func walk(appname, node, path, depth, maxdepth) {
	if budget <= 0 {
		return
	}
	if depth > maxdepth {
		// A subtree was cut off by --depth. Silently returning a SHALLOW
		// answer is the dangerous failure (an agent concludes "no such
		// widget"), so record it and surface it in the envelope.
		depthCut = true
		return
	}
	budget = budget - 1
	visited = visited + 1
	if depth > deepest {
		deepest = depth
	}
	role := noderole(node)
	name := nodename(node)
	if keep(role, name) && hasstate(node, ST_SHOWING) {
		x, y, w, h := extents(node)
		if w > 0 && h > 0 {
			wjs, wln, wk := noderow(appname, node, path, role, name, true)
			rows = append(rows, pickfmt(wjs, wln))
			rowkeys = append(rowkeys, wk)
		}
	}
	n := atspi_accessible_get_child_count(node, 0)
	i := 0
	while i < n {
		c := atspi_accessible_get_child_at_index(node, i, 0)
		if c != 0 {
			walk(appname, c, path+"/"+str(i), depth+1, maxdepth)
			g_object_unref(c)
		}
		i = i + 1
	}
}

// ---------------------------------------------------------------- commands

func cmd_apps() (out, code) {
	code = EX_OK
	items := []string{}
	names := []string{}
	dupes := []string{}
	n := atspi_accessible_get_child_count(desktop, 0)
	i := 0
	while i < n {
		a := atspi_accessible_get_child_at_index(desktop, i, 0)
		if a != 0 {
			nm := nodename(a)
			kids := atspi_accessible_get_child_count(a, 0)
			pid := atspi_accessible_get_process_id(a, 0)
			tk := takestr(atspi_accessible_get_toolkit_name(a, 0))
			// A name shared by two applications is ambiguous for --app, so say
			// so rather than letting the caller silently address the wrong one.
			j := 0
			while j < len(names) {
				if names[j] == nm {
					seen := false
					k := 0
					while k < len(dupes) {
						if dupes[k] == nm {
							seen = true
						}
						k = k + 1
					}
					if !seen {
						dupes = append(dupes, nm)
					}
				}
				j = j + 1
			}
			names = append(names, nm)
			items = append(items, "{"+jkv("name", jstr(nm))+","+jkv("pid", str(pid))+","+jkv("toolkit", jstr(tk))+","+jkv("windows", str(kids))+","+jkv("ref", jstr(nm+"#pid"+str(pid)))+"}")
			g_object_unref(a)
		}
		i = i + 1
	}
	dj := []string{}
	i = 0
	while i < len(dupes) {
		dj = append(dj, jstr(dupes[i]))
		i = i + 1
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("applications", jarr(items)) + "," + jkv("count", str(len(items))) + "," + jkv("ambiguous_names", jarr(dj)) + "}"
	if len(dupes) > 0 {
		write(2, "warning: " + str(len(dupes)) + " application name(s) are shared by more than one process; address them as '<name>#pid<PID>' or with --pid\n")
	}
}

func cmd_windows(appfilter) (out, code) {
	code = EX_OK
	items := []string{}
	n := atspi_accessible_get_child_count(desktop, 0)
	i := 0
	while i < n {
		a := atspi_accessible_get_child_at_index(desktop, i, 0)
		if a != 0 {
			nm := nodename(a)
			if app_matches(a, nm, appfilter) {
				wc := atspi_accessible_get_child_count(a, 0)
				j := 0
				while j < wc {
					w := atspi_accessible_get_child_at_index(a, j, 0)
					if w != 0 {
						wr := noderole(w)
						wn := nodename(w)
						x, y, ww, wh := extents(w)
						f := []string{}
						f = append(f, jkv("app", jstr(nm)))
						f = append(f, jkv("ref", jstr(mkref(nm, "/"+str(j), wr, wn))))
						f = append(f, jkv("title", jstr(wn)))
						f = append(f, jkv("role", jstr(wr)))
						f = append(f, jkv("x", str(x)))
						f = append(f, jkv("y", str(y)))
						f = append(f, jkv("w", str(ww)))
						f = append(f, jkv("h", str(wh)))
						f = append(f, jkv("active", jbool(hasstate(w, ST_ACTIVE))))
						items = append(items, "{"+join(f, ",")+"}")
						g_object_unref(w)
					}
					j = j + 1
				}
			}
			g_object_unref(a)
		}
		i = i + 1
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("windows", jarr(items)) + "," + jkv("count", str(len(items))) + "}"
}

// statepass runs ONE perception pass — collection first, walk fallback — and
// fills the globals rows/rowkeys. Shared by cmd_state and the expand loop.
func statepass(appname, app, maxdepth, maxnodes) (method, unknown) {
	rows = []string{}
	rowkeys = []string{}
	budget = maxnodes
	method = "collection"
	unknown = ""
	cok := false
	if !forceWalk {
		crows, ckeys, _, okc, unk, unp := collect(appname, app, wantRole, maxnodes)
		unknown = unk
		cok = okc
		if okc {
			rows = crows
			rowkeys = ckeys
			// A collection match whose path could not be proven has no ref.
			// Unless the caller explicitly asked for the collection path,
			// prefer a complete answer over a fast one and re-run as a walk.
			if unp > 0 && !forceCollection {
				cok = false
				method = "collection+walk"
				rows = []string{}
				rowkeys = []string{}
			}
		}
	}
	if !cok {
		if method == "collection" {
			method = "walk"
		}
		walk(appname, app, "", 0, maxdepth)
	}
}

// scrollfwdidx returns the scrollForward (preferred) or scrollDown action
// index on a node, -1 if it has neither.
func scrollfwdidx(node) (idx) {
	idx = -1
	ai := atspi_accessible_get_action_iface(node)
	if ai == 0 {
		return
	}
	na := atspi_action_get_n_actions(ai, 0)
	i := 0
	while i < na {
		an := to_lower(takestr(atspi_action_get_action_name(ai, i, 0)))
		if an == "scrollforward" {
			idx = i
		}
		if an == "scrolldown" && idx < 0 {
			idx = i
		}
		i = i + 1
	}
	g_object_unref(ai)
}

// findscrollnode returns the first scrollable container exposing a scroll
// FORWARD/DOWN action — e.g. Chromium's document web — as a NEW ref the
// caller must unref, plus the action index. Collection query over the
// document/scroll-pane roles first (one D-Bus call per window); bounded DFS
// fallback for apps without the Collection interface.
func findscrollnode(app) (sn, sidx) {
	sn = 0
	sidx = -1
	ra := lu_roles_new()
	names := []string{"document web", "document frame", "scroll pane"}
	i := 0
	while i < len(names) {
		rid := lu_role_from_name(names[i])
		if rid >= 0 {
			lu_roles_add(ra, rid)
		}
		i = i + 1
	}
	rule := lu_rule_new(ra, 1)
	nwin := atspi_accessible_get_child_count(app, 0)
	w := 0
	while w < nwin && sn == 0 {
		win := atspi_accessible_get_child_at_index(app, w, 0)
		if win != 0 {
			arr := lu_matches(win, rule, 200)
			if arr != 0 {
				cnt := lu_arr_len(arr)
				i = 0
				while i < cnt && sn == 0 {
					node := lu_arr_get(arr, i)
					if node != 0 {
						si := scrollfwdidx(node)
						if si >= 0 {
							sn = g_object_ref(node)
							sidx = si
						}
					}
					i = i + 1
				}
				lu_arr_free(arr)
			}
			g_object_unref(win)
		}
		w = w + 1
	}
	lu_rule_free(rule)
	lu_roles_free(ra)
	if sn == 0 {
		fsVisited = 0
		sn, sidx = findscrollnode_dfs(app, 0)
	}
}

var fsVisited = 0
func findscrollnode_dfs(node, depth) (sn, sidx) {
	sn = 0
	sidx = -1
	if fsVisited > 1500 || depth > 15 {
		return
	}
	fsVisited = fsVisited + 1
	role := to_lower(noderole(node))
	if contains(role, "scroll") || contains(role, "document") {
		sidx = scrollfwdidx(node)
	}
	if sidx >= 0 {
		sn = node
		return
	}
	k := atspi_accessible_get_child_count(node, 0)
	i := 0
	while i < k && i < 40 && sn == 0 {
		c := atspi_accessible_get_child_at_index(node, i, 0)
		if c != 0 {
			sn, sidx = findscrollnode_dfs(c, depth+1)
			if sn == 0 {
				g_object_unref(c)
			}
			i = i + 1
		}
	}
}

// scrollbackidx finds the scroll BACKWARD/UP action index on a node (-1).
func scrollbackidx(node) (idx) {
	idx = -1
	ai := atspi_accessible_get_action_iface(node)
	if ai == 0 {
		return
	}
	na := atspi_action_get_n_actions(ai, 0)
	i := 0
	while i < na {
		an := to_lower(takestr(atspi_action_get_action_name(ai, i, 0)))
		if an == "scrollbackward" {
			idx = i
		}
		if an == "scrollup" && idx < 0 {
			idx = i
		}
		i = i + 1
	}
	g_object_unref(ai)
}

// expandsweep scrolls the app's scrollable container forward — its own
// scrollForward/scrollDown accessible action when it exposes one (a full
// viewport per call, works occluded, no pointer), else XTEST wheel clicks at
// the window center — running a perception pass after each scroll and
// merging new rows by ref-path key into the caller's `rows`. Stops after
// wantExpandMax scrolls or two consecutive settled passes with nothing new,
// then scrolls back. Seeds seen/merged from the global rows+rowkeys of the
// pass already taken; returns (merged rows, scrolls, passes, method, ms).
func expandsweep(appname, app, maxdepth, maxnodes) (merged, scrolled, passes, method, ms) {
	method = "wheel"
	snode, saction := findscrollnode(app)
	if snode != 0 {
		method = "action"
	}
	cx := 0
	cy := 0
	win := atspi_accessible_get_child_at_index(app, 0, 0)
	if win != 0 {
		wx, wy, ww, wh := extents(win)
		g_object_unref(win)
		cx = wx + ww / 2
		cy = wy + wh / 2
	}
	seen := "|" + join(rowkeys, "|") + "|"
	merged = []string{}
	i := 0
	while i < len(rows) {
		merged = append(merged, rows[i])
		i = i + 1
	}
	// Passes must see every realized node, not only find's text matches —
	// otherwise "nothing new" fires while the page is still scrolling and the
	// sweep idles out before reaching below-fold matches. Callers re-filter
	// merged rows afterwards; restored before returning.
	savedWantText := wantText
	wantText = ""
	canScroll := snode != 0 || (cx > 0 && cy > 0)
	if !canScroll {
		write(2, "warning: --expand found no scroll action and no window geometry; returning the first pass\n")
	}
	idle := 0
	keepGoing := canScroll
	t0 := now_ms()
	while keepGoing {
		scrolledOk := false
		if snode != 0 {
			sai := atspi_accessible_get_action_iface(snode)
			if sai != 0 {
				scrolledOk = atspi_action_do_action(sai, saction, 0)
				g_object_unref(sai)
			}
		} else {
			scrolledOk = clickxy(cx, cy, 5)
		}
		if !scrolledOk {
			write(2, "warning: --expand could not scroll; returning what was seen\n")
			keepGoing = false
		} else {
			scrolled = scrolled + 1
			// Adaptive settle: a short pre-probe delay lets the new viewport
			// finish realizing (probing at t=0 snapshots a half-materialized
			// window and permanently skips the lagging rows), then re-probe
			// once after the full wait only when nothing new surfaced — that
			// is what makes idle passes distinguishable from slow settles.
			sleep(wantExpandWait / 2)
			_, _ = statepass(appname, app, maxdepth, maxnodes)
			added := 0
			i = 0
			while i < len(rowkeys) {
				k := rowkeys[i]
				if !contains(seen, "|"+k+"|") {
					seen = seen + k + "|"
					merged = append(merged, rows[i])
					added = added + 1
				}
				i = i + 1
			}
			if added == 0 {
				sleep(wantExpandWait)
				_, _ = statepass(appname, app, maxdepth, maxnodes)
				i = 0
				while i < len(rowkeys) {
					k := rowkeys[i]
					if !contains(seen, "|"+k+"|") {
						seen = seen + k + "|"
						merged = append(merged, rows[i])
						added = added + 1
					}
					i = i + 1
				}
			}
			if added == 0 {
				idle = idle + 1
			} else {
				idle = 0
			}
			passes = passes + 1
			if passes >= wantExpandMax || idle >= 2 {
				keepGoing = false
			}
		}
	}
	ms = now_ms() - t0
	wantText = savedWantText
	// Put the scroll position back roughly where it was.
	i = 0
	if snode != 0 {
		bidx := scrollbackidx(snode)
		if bidx >= 0 {
			sai := atspi_accessible_get_action_iface(snode)
			if sai != 0 {
				while i < scrolled {
					atspi_action_do_action(sai, bidx, 0)
					i = i + 1
				}
				g_object_unref(sai)
			}
		}
		g_object_unref(snode)
	} else {
		while i < scrolled {
			clickxy(cx, cy, 4)
			i = i + 1
		}
	}
}

// recordmetric appends one JSON line to ~/.cache/linux-use/metrics.jsonl —
// the trail that keeps speed claims honest. Fire-and-forget via the shell: a
// broken metrics file must never break a command.
func recordmetric(op, app, ms, count, method, passes) {
	safe := replace(replace(cleanline(app), "'", ""), "\"", "")
	line := "{\"ts\":" + str(now_ms()) + ",\"op\":\"" + op + "\",\"app\":\"" + safe + "\",\"ms\":" + str(ms) + ",\"count\":" + str(count) + ",\"method\":\"" + method + "\",\"passes\":" + str(passes) + "}"
	system("mkdir -p \"$HOME/.cache/linux-use\" && printf '%s\\n' '" + line + "' >> \"$HOME/.cache/linux-use/metrics.jsonl\"")
}

func jfieldstr(s, key) (v) {
	v = ""
	parts := split(s, "\""+key+"\":\"")
	if len(parts) > 1 {
		v = split(parts[1], "\"")[0]
	}
}

func jfieldnum(s, key) (v) {
	v = 0
	parts := split(s, "\""+key+"\":")
	if len(parts) > 1 {
		rest := split(parts[1], ",")[0]
		rest = split(rest, "}")[0]
		v = parse_int(rest)
	}
}

// cmd_stats aggregates the metrics trail: per op, calls and min/avg/max ms.
func cmd_stats(last) (out, code) {
	code = EX_OK
	out = ""
	if last <= 0 {
		last = 200
	}
	_, content, _ := exec("tail -n " + str(last) + " \"$HOME/.cache/linux-use/metrics.jsonl\" 2>/dev/null")
	lines := split(content, "\n")
	ops := "|"
	n := 0
	i := 0
	while i < len(lines) {
		ln := lines[i]
		if len(ln) > 0 {
			n = n + 1
			op := jfieldstr(ln, "op")
			if len(op) > 0 && !contains(ops, "|"+op+"|") {
				ops = ops + op + "|"
			}
		}
		i = i + 1
	}
	entries := []string{}
	names := split(ops, "|")
	i = 0
	while i < len(names) {
		op := names[i]
		i = i + 1
		if len(op) > 0 {
			calls := 0
			sum := 0
			mn := 0
			mx := 0
			elems := 0
			j := 0
			while j < len(lines) {
				ln := lines[j]
				j = j + 1
				if len(ln) > 0 && jfieldstr(ln, "op") == op {
					m := jfieldnum(ln, "ms")
					calls = calls + 1
					sum = sum + m
					if calls == 1 || m < mn {
						mn = m
					}
					if m > mx {
						mx = m
					}
					elems = elems + jfieldnum(ln, "count")
				}
			}
			if calls > 0 {
				entries = append(entries, "{"+jkv("op", jstr(op))+","+jkv("calls", str(calls))+","+jkv("min_ms", str(mn))+","+jkv("avg_ms", str(sum / calls))+","+jkv("max_ms", str(mx))+","+jkv("elements", str(elems))+"}")
			}
		}
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("window", str(n)) + "," + jkv("file", jstr("~/.cache/linux-use/metrics.jsonl")) + "," + jkv("ops", jarr(entries)) + "}"
}

func cmd_state(appname, maxdepth, maxnodes) (out, code) {
	code = EX_OK
	out = ""
	app := findapp(appname)
	if app == 0 {
		if appAmbiguous > 1 {
			code = EX_USAGE
			out = errjson(EX_USAGE, "app_ambiguous", str(appAmbiguous)+" applications are named '"+appname+"'", true, []string{"disambiguate with the pid: --app '" + appname + "#pid<PID>' or --pid <PID>", "list pids with: linux-use apps"})
			return
		}
		code = EX_APP_NOT_FOUND
		out = errjson(EX_APP_NOT_FOUND, "app_not_found", "no application named '"+appname+"' in the accessibility tree", true, []string{"run: linux-use apps", "the app may not be running, or may not export accessibility (see: linux-use doctor)"})
		return
	}
	budget = maxnodes
	visited = 0
	deepest = 0
	depthCut = false
	t0 := now_ms()
	method, unknown := statepass(appname, app, maxdepth, maxnodes)
	geomCount := geomrefs
	ms := now_ms() - t0
	merged := rows
	passes := 0
	scrolled := 0
	expanded := false
	expandMs := 0
	if wantExpand {
		mrows, s, p, expandMethod, ems := expandsweep(appname, app, maxdepth, maxnodes)
		merged = mrows
		scrolled = s
		passes = p
		expandMs = ems
		expanded = scrolled > 0
		if expanded {
			write(2, "expand: "+str(scrolled)+" scrolls via "+expandMethod+", "+str(len(merged))+" elements merged\n")
		}
	}
	rows = merged
	g_object_unref(app)
	trunc := budget <= 0
	if wantFormat == "lines" {
		hdr := "# linux-use state app=" + appname + " count=" + str(len(rows)) + " method=" + method + " walk_ms=" + str(ms) + " truncated=" + jbool(trunc) + " depth_limited=" + jbool(depthCut) + " expanded=" + jbool(expanded) + " expand_passes=" + str(passes)
		out = hdr + "\n" + join(rows, "\n")
	} else {
		f := []string{}
		f = append(f, jkv("schema", jstr(SCHEMA)))
		f = append(f, jkv("ok", "true"))
		f = append(f, jkv("app", jstr(appname)))
		f = append(f, jkv("elements", jarr(rows)))
		f = append(f, jkv("count", str(len(rows))))
		f = append(f, jkv("walk_ms", str(ms)))
		f = append(f, jkv("expand_ms", str(expandMs)))
		f = append(f, jkv("nodes_visited", str(visited)))
		f = append(f, jkv("deepest", str(deepest)))
		f = append(f, jkv("depth_limit", str(maxdepth)))
		f = append(f, jkv("depth_limited", jbool(depthCut)))
		f = append(f, jkv("truncated", jbool(trunc)))
		f = append(f, jkv("method", jstr(method)))
		f = append(f, jkv("geometry_refs", str(geomCount)))
		f = append(f, jkv("expanded", jbool(expanded)))
		f = append(f, jkv("expand_passes", str(passes)))
		out = "{" + join(f, ",") + "}"
	}
	recordmetric("state", appname, ms+expandMs, len(rows), method, passes)
	if len(unknown) > 0 {
		write(2, "warning: unknown role '" + unknown + "' — it matched nothing; check: linux-use roles\n")
	}
	if trunc {
		write(2, "warning: node budget exhausted — results are TRUNCATED; narrow with --role/--app or raise --max-nodes\n")
	}
	if depthCut && method == "walk" {
		write(2, "warning: subtrees were cut at --depth " + str(maxdepth) + " — deeper widgets are NOT in this result; raise --depth\n")
	}
}

// ---- CDP fast path (--via cdp) --------------------------------------
// For dedicated-profile browsers launched with --remote-debugging-port:
// one Runtime.evaluate DOM query returns every interactive element in
// ~20ms — the whole document, no scroll sweep. Refs carry the pid and an
// xpath ("cdp<PID>:/html/...#fp") so `act` re-discovers the ws url and
// fires a real DOM click — works occluded, no pointer. NEVER used on the
// live profile (its port is unreachable by policy anyway).

// cdppid parses the pid out of a cdp ref's app field ("cdp<PID>").
func cdppid(app) (pid) {
	pid = 0
	if len(app) > 3 && substr(app, 0, 3) == "cdp" {
		pid = parse_int(substr(app, 3, len(app)))
	}
}

// cdp_port reads --remote-debugging-port=N off a process cmdline (0 none).
func cdp_port(pid) (port) {
	port = 0
	_, cl, _ := exec("tr '\\0' ' ' </proc/" + str(pid) + "/cmdline 2>/dev/null")
	parts := split(cl, "--remote-debugging-port=")
	if len(parts) > 1 {
		port = parse_int(split(parts[1], " ")[0])
	}
}

// cdp_ws_url returns the ws debugger url of the browser's LAST page target
// (the most recently opened tab), "" when the process has no debug port.
func cdp_ws_url(pid) (ws) {
	ws = ""
	port := cdp_port(pid)
	if port <= 0 {
		return
	}
	body := takestr(lu_http_get("127.0.0.1", port, "/json/list"))
	segs := split(body, "{")
	i := 0
	while i < len(segs) {
		s := segs[i]
		if contains(s, "\"type\": \"page\"") && contains(s, "webSocketDebuggerUrl") {
			ws = split(split(s, "\"webSocketDebuggerUrl\": \"")[1], "\"")[0]
		}
		i = i + 1
	}
}

func jsesc(s) (r) {
	r = replace(s, "\\", "\\\\")
	r = replace(r, "\"", "\\\"")
	r = replace(r, "\n", "\\n")
	r = replace(r, "\r", "\\r")
	r = replace(r, "\t", "\\t")
}

var cdpCallId = 0
// cdp_eval sends Runtime.evaluate and returns the string result value.
// Our expressions emit TSV with fields pre-sanitized, so the only JSON
// escape inside "value" is \n — unescaped back to real newlines here.
func cdp_eval(wsurl, expr) (v, ok) {
	v = ""
	ok = false
	fd := lu_ws_open(wsurl)
	if fd < 0 {
		return
	}
	cdpCallId = cdpCallId + 1
	msg := "{\"id\":" + str(cdpCallId) + ",\"method\":\"Runtime.evaluate\",\"params\":{\"expression\":\"" + jsesc(expr) + "\",\"returnByValue\":true}}"
	resp := takestr(lu_ws_call(fd, msg))
	lu_ws_close(fd)
	if len(resp) == 0 || contains(resp, "\"exceptionDetails\"") {
		return
	}
	v = replace(replace(jfieldstr(resp, "value"), "\\n", "\n"), "\\t", "\t")
	ok = true
}

var cdpElementsJS = "(()=>{const xp=e=>{let p=[];while(e&&e.nodeType===1){let i=1,s=e.previousElementSibling;while(s){if(s.tagName===e.tagName)i++;s=s.previousElementSibling}p.unshift(e.tagName.toLowerCase()+'['+i+']');e=e.parentElement}return'/'+p.join('/')};const MR=e=>{const t=e.tagName.toLowerCase();const r=(e.getAttribute('role')||'').toLowerCase();if(r)return r;if(t==='a')return'link';if(t==='button')return'push button';if(t==='select')return'combo box';if(t==='textarea')return'entry';if(t==='summary')return'push button';if(t==='input'){const y=(e.getAttribute('type')||'text').toLowerCase();if(y==='checkbox')return'check box';if(y==='radio')return'radio button';if(y==='submit'||y==='button')return'push button';if(y==='password')return'password text';return'entry'}return t};const out=[];document.querySelectorAll('a[href],button,input,select,textarea,[role],summary,[tabindex],[contenteditable=\"true\"]').forEach(el=>{const r=el.getBoundingClientRect();if(r.width<1||r.height<1)return;const cs=getComputedStyle(el);if(cs.display==='none'||cs.visibility==='hidden')return;const n=(el.getAttribute('aria-label')||el.innerText||el.value||el.getAttribute('title')||'').replace(/[\\t\\n\\r\\\\\"']/g,' ').trim().slice(0,120);out.push([MR(el),n,Math.round(r.x+scrollX),Math.round(r.y+scrollY),Math.round(r.width),Math.round(r.height),xp(el)].join('\\t'))});return out.join('\\n')})()"

// cmd_state_cdp is the --via cdp perception path: one DOM query for every
// interactive element on the page, document coordinates, xpath refs.
func cmd_state_cdp(appname) (out, code) {
	code = EX_OK
	out = ""
	app := findapp(appname)
	if app == 0 {
		if appAmbiguous > 1 {
			code = EX_USAGE
			out = errjson(EX_USAGE, "app_ambiguous", str(appAmbiguous)+" applications are named '"+appname+"'", true, []string{"disambiguate with the pid: --app '" + appname + "#pid<PID>' or --pid <PID>", "list pids with: linux-use apps"})
			return
		}
		code = EX_APP_NOT_FOUND
		out = errjson(EX_APP_NOT_FOUND, "app_not_found", "no application named '"+appname+"' in the accessibility tree", true, []string{"run: linux-use apps", "the app may not be running, or may not export accessibility (see: linux-use doctor)"})
		return
	}
	pid := atspi_accessible_get_process_id(app, 0)
	g_object_unref(app)
	ws := cdp_ws_url(pid)
	if len(ws) == 0 {
		code = EX_USAGE
		out = errjson(EX_USAGE, "cdp_unavailable", "'"+appname+"' has no --remote-debugging-port on its command line", true, []string{"relaunch the dedicated profile with the flag — contrib/a11y-browser: A11Y_CDP_PORT=PORT", "the live profile cannot expose a debug port (Chromium refuses it) — plain 'state' works there"})
		return
	}
	t0 := now_ms()
	tsv, ok := cdp_eval(ws, cdpElementsJS)
	ms := now_ms() - t0
	if !ok {
		code = EX_ACTION_FAILED
		out = errjson(EX_ACTION_FAILED, "cdp_call_failed", "Runtime.evaluate failed or returned no result", true, []string{"the page may be navigating — retry", "check the ws url: "+ws})
		return
	}
	rows := []string{}
	lns := split(tsv, "\n")
	i := 0
	while i < len(lns) {
		f := split(lns[i], "\t")
		i = i + 1
		if len(f) >= 7 {
			role := f[0]
			nm := f[1]
			ref := "cdp" + str(pid) + ":" + f[6] + "#" + fp(role, nm)
			geom := f[2] + "," + f[3] + "," + f[4] + "," + f[5]
			if wantFormat == "lines" {
				rows = append(rows, ref + "\t" + role + "\t" + cleanline(nm) + "\t" + geom + "\tclick+1\t-")
			} else {
				rows = append(rows, "{"+jkv("ref", jstr(ref))+","+jkv("ref_kind", jstr("cdp"))+","+jkv("ref_ok", "true")+","+jkv("role", jstr(role))+","+jkv("name", jstr(nm))+","+jkv("x", f[2])+","+jkv("y", f[3])+","+jkv("w", f[4])+","+jkv("h", f[5])+","+jkv("actions", jarr([]string{jstr("click")}))+"}")
			}
		}
	}
	recordmetric("state", appname+" via:cdp", ms, len(rows), "cdp", 0)
	if wantFormat == "lines" {
		out = "# linux-use state app=" + appname + " count=" + str(len(rows)) + " method=cdp walk_ms=" + str(ms) + "\n" + join(rows, "\n")
	} else {
		f := []string{}
		f = append(f, jkv("schema", jstr(SCHEMA)))
		f = append(f, jkv("ok", "true"))
		f = append(f, jkv("app", jstr(appname)))
		f = append(f, jkv("elements", jarr(rows)))
		f = append(f, jkv("count", str(len(rows))))
		f = append(f, jkv("walk_ms", str(ms)))
		f = append(f, jkv("method", jstr("cdp")))
		f = append(f, jkv("note", jstr("document coordinates; refs are cdp<pid>:xpath")))
		out = "{" + join(f, ",") + "}"
	}
}

// cmd_act_cdp fires a real DOM click() through CDP — no pointer, no focus,
// works while the window is occluded. Refs come from 'state --via cdp'.
func cmd_act_cdp(ref) (out, code) {
	code = EX_OK
	out = ""
	app, path, want := splitref(ref)
	pid := cdppid(app)
	if pid <= 0 || len(path) == 0 || substr(path, 0, 1) != "/" {
		code = EX_USAGE
		out = errjson(EX_USAGE, "bad_ref", "cdp ref must look like 'cdp<PID>:/html/...#fp' — take one from 'state --via cdp'", true, []string{"run: linux-use state --app <app> --via cdp"})
		return
	}
	ws := cdp_ws_url(pid)
	if len(ws) == 0 {
		code = EX_USAGE
		out = errjson(EX_USAGE, "cdp_unavailable", "pid "+str(pid)+" has no --remote-debugging-port on its command line", true, []string{"the browser must have been launched with the flag"})
		return
	}
	v, ok := cdp_eval(ws, "(()=>{var e=document.evaluate(\""+path+"\",document,null,9,null).singleNodeValue;if(!e)return 'missing';e.click();return 'ok'})()")
	if !ok {
		code = EX_ACTION_FAILED
		out = errjson(EX_ACTION_FAILED, "cdp_call_failed", "Runtime.evaluate failed", true, []string{"the page may be navigating — retry", "re-run: linux-use state --app <app> --via cdp"})
		return
	}
	if v == "missing" {
		code = EX_REF_STALE
		out = errjson(EX_REF_STALE, "ref_stale", "no element at "+path+" — the page changed since the ref was issued", true, []string{"re-run: linux-use state --app <app> --via cdp"})
		return
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("ref", jstr(ref)) + "," + jkv("action", jstr("click")) + "," + jkv("via", jstr("cdp")) + "}"
}

// rowname extracts the element name from an emitted row — "name" field in
// JSON, third tab-separated field in lines format.
func rowname(r) (n) {
	if wantFormat == "lines" {
		parts := split(r, "\t")
		if len(parts) > 2 {
			n = parts[2]
		}
	} else {
		n = jfieldstr(r, "name")
	}
}

func cmd_find(query, appfilter, maxdepth, maxnodes) (out, code) {
	code = EX_OK
	out = ""
	if wantExpand && len(appfilter) == 0 {
		code = EX_USAGE
		out = errjson(EX_USAGE, "bad_flags", "find --expand requires --app — sweeping every desktop application would scroll all of them", true, []string{"example: linux-use find \"Submit\" --app \"Microsoft Edge\" --expand"})
		return
	}
	wantText = query
	findMethod = "collection"
	all := []string{}
	visited = 0
	deepest = 0
	depthCut = false
	expanded := false
	passes := 0
	scrolled := 0
	expandMs := 0
	t0 := now_ms()
	n := atspi_accessible_get_child_count(desktop, 0)
	i := 0
	while i < n {
		a := atspi_accessible_get_child_at_index(desktop, i, 0)
		if a != 0 {
			nm := qualify_app(a, nodename(a))
			if app_matches(a, nodename(a), appfilter) {
				rows = []string{}
				rowkeys = []string{}
				budget = maxnodes
				cok := false
				if !forceWalk {
					crows, _, _, okc, _, unp := collect(nm, a, wantRole, maxnodes)
					cok = okc
					if okc {
						rows = crows
						if unp > 0 && !forceCollection {
							cok = false
							findMethod = "collection+walk"
							rows = []string{}
						}
					}
				}
				if !cok {
					findMethod = "walk"
					walk(nm, a, "", 0, maxdepth)
				}
				if wantExpand {
					mrows, s, p, em, ems := expandsweep(nm, a, maxdepth, maxnodes)
					// expandsweep sees all nodes (correct idle detection); the
					// answer keeps only name matches, same as a plain find.
					rows = []string{}
					qlow := to_lower(query)
					mi := 0
					while mi < len(mrows) {
						if contains(to_lower(rowname(mrows[mi])), qlow) {
							rows = append(rows, mrows[mi])
						}
						mi = mi + 1
					}
					scrolled = scrolled + s
					passes = passes + p
					expandMs = expandMs + ems
					if s > 0 {
						expanded = true
						findMethod = findMethod + "+" + em
					}
				}
				j := 0
				while j < len(rows) {
					all = append(all, rows[j])
					j = j + 1
				}
			}
			g_object_unref(a)
		}
		i = i + 1
	}
	ms := now_ms() - t0
	if wantFormat == "lines" {
		out = "# linux-use find query=" + cleanline(query) + " count=" + str(len(all)) + " search_ms=" + str(ms) + " method=" + findMethod + " depth_limited=" + jbool(depthCut) + " expanded=" + jbool(expanded) + " expand_passes=" + str(passes) + "\n" + join(all, "\n")
	} else {
		f := []string{}
		f = append(f, jkv("schema", jstr(SCHEMA)))
		f = append(f, jkv("ok", "true"))
		f = append(f, jkv("query", jstr(query)))
		f = append(f, jkv("matches", jarr(all)))
		f = append(f, jkv("count", str(len(all))))
		f = append(f, jkv("search_ms", str(ms)))
		f = append(f, jkv("nodes_visited", str(visited)))
		f = append(f, jkv("deepest", str(deepest)))
		f = append(f, jkv("depth_limited", jbool(depthCut)))
		f = append(f, jkv("method", jstr(findMethod)))
		f = append(f, jkv("expanded", jbool(expanded)))
		f = append(f, jkv("expand_passes", str(passes)))
		f = append(f, jkv("expand_ms", str(expandMs)))
		out = "{" + join(f, ",") + "}"
	}
	recordmetric("find", appfilter+" "+query, ms+expandMs, len(all), findMethod, passes)
	if depthCut && findMethod == "walk" {
		write(2, "warning: subtrees were cut at --depth " + str(maxdepth) + "; raise --depth if the target is missing\n")
	}
}

// getnode resolves a ref and VERIFIES its fingerprint. Returns (node, errjson, code).
// node is a new ref the caller must unref when code == EX_OK.
func getnode(ref) (node, out, code) {
	node = 0
	out = ""
	code = EX_OK
	appname, path, want := splitref(ref)
	if len(appname) == 0 {
		code = EX_USAGE
		out = errjson(EX_USAGE, "bad_ref", "ref must look like 'app:/0/1/2#fingerprint'", true, []string{"take refs verbatim from: linux-use state --app <app>"})
		return
	}
	app := findapp(appname)
	if app == 0 {
		if appAmbiguous > 1 {
			code = EX_USAGE
			out = errjson(EX_USAGE, "app_ambiguous", str(appAmbiguous)+" applications are named '"+appname+"'", true, []string{"disambiguate with the pid: '" + appname + "#pid<PID>'", "list pids with: linux-use apps"})
			return
		}
		code = EX_APP_NOT_FOUND
		out = errjson(EX_APP_NOT_FOUND, "app_not_found", "no application named '"+appname+"'", true, []string{"run: linux-use apps"})
		return
	}
	if is_geom(path) {
		n2, cnt := resolve_geom(app, path)
		g_object_unref(app)
		node = n2
		if cnt == 0 {
			code = EX_REF_NOT_FOUND
			out = errjson(EX_REF_NOT_FOUND, "ref_not_found", "no widget of that role at that rectangle in "+appname, true, []string{"the UI moved or closed; re-run: linux-use state --app " + appname})
			return
		}
		if cnt > 1 {
			code = EX_REF_STALE
			out = errjson(EX_REF_STALE, "ref_ambiguous", str(cnt)+" widgets share that role and rectangle in "+appname, true, []string{"the layout changed; re-run: linux-use state --app " + appname})
			return
		}
	} else {
		node = resolve(app, path)
		g_object_unref(app)
		if node == 0 {
			code = EX_REF_NOT_FOUND
			out = errjson(EX_REF_NOT_FOUND, "ref_not_found", "path '"+path+"' does not exist in "+appname, true, []string{"the UI changed; re-run: linux-use state --app " + appname})
			return
		}
	}
	if len(want) > 0 {
		got := fp(noderole(node), nodename(node))
		if got != want {
			g_object_unref(node)
			node = 0
			code = EX_REF_STALE
			out = errjson(EX_REF_STALE, "ref_stale", "ref points at a different widget than when it was captured", true, []string{"the UI changed; re-run: linux-use state --app " + appname, "then use the fresh ref"})
			return
		}
	}
}

func cmd_act(ref, which) (out, code) {
	if len(ref) > 3 && substr(ref, 0, 3) == "cdp" {
		out, code = cmd_act_cdp(ref)
		return
	}
	node, out, code := getnode(ref)
	if code != EX_OK {
		return
	}
	role := noderole(node)
	name := nodename(node)
	ai := atspi_accessible_get_action_iface(node)
	if ai == 0 {
		g_object_unref(node)
		code = EX_NO_CAPABILITY
		out = errjson(EX_NO_CAPABILITY, "no_action", "'"+role+"' exposes no accessible action", true, []string{"use: linux-use click " + ref + " (synthetic pointer fallback)"})
		return
	}
	nacts := atspi_action_get_n_actions(ai, 0)
	idx := 0
	if len(which) > 0 {
		idx = parse_int(which)
	}
	if idx >= nacts {
		g_object_unref(ai)
		g_object_unref(node)
		code = EX_USAGE
		out = errjson(EX_USAGE, "bad_action_index", "action "+str(idx)+" out of range (element has "+str(nacts)+")", true, []string{"omit --action to use action 0"})
		return
	}
	an := takestr(atspi_action_get_action_name(ai, idx, 0))
	ok := atspi_action_do_action(ai, idx, 0)
	g_object_unref(ai)
	g_object_unref(node)
	if !ok {
		code = EX_ACTION_FAILED
		out = errjson(EX_ACTION_FAILED, "action_failed", "the toolkit refused action '"+an+"'", true, []string{"use: linux-use click " + ref})
		return
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("ref", jstr(ref)) + "," + jkv("role", jstr(role)) + "," + jkv("name", jstr(name)) + "," + jkv("action", jstr(an)) + "}"
}

func cmd_read(ref) (out, code) {
	node, out, code := getnode(ref)
	if code != EX_OK {
		return
	}
	role := noderole(node)
	name := nodename(node)
	txt := ""
	nc := 0
	ti := atspi_accessible_get_text_iface(node)
	if ti != 0 {
		nc = atspi_text_get_character_count(ti, 0)
		if nc > 0 {
			txt = takestr(atspi_text_get_text(ti, 0, nc, 0))
		}
		g_object_unref(ti)
	}
	desc := takestr(atspi_accessible_get_description(node, 0))
	g_object_unref(node)
	f := []string{}
	f = append(f, jkv("schema", jstr(SCHEMA)))
	f = append(f, jkv("ok", "true"))
	f = append(f, jkv("ref", jstr(ref)))
	f = append(f, jkv("role", jstr(role)))
	f = append(f, jkv("name", jstr(name)))
	f = append(f, jkv("description", jstr(desc)))
	f = append(f, jkv("chars", str(nc)))
	f = append(f, jkv("text", jstr(txt)))
	out = "{" + join(f, ",") + "}"
}

func cmd_type(ref, text, replace, allowpw) (out, code) {
	node, out, code := getnode(ref)
	if code != EX_OK {
		return
	}
	role := noderole(node)
	if role == "password text" && !allowpw {
		g_object_unref(node)
		code = EX_REFUSED
		out = errjson(EX_REFUSED, "refused_password_field", "refusing to type into a password field", false, []string{"pass --allow-password if this is genuinely intended"})
		return
	}
	method := ""
	ok := false
	et := atspi_accessible_get_editable_text_iface(node)
	if et != 0 {
		if replace {
			ok = atspi_editable_text_set_text_contents(et, text, 0)
			method = "editable_text.set_contents"
		} else {
			pos := 0
			ti := atspi_accessible_get_text_iface(node)
			if ti != 0 {
				pos = atspi_text_get_caret_offset(ti, 0)
				g_object_unref(ti)
			}
			ok = atspi_editable_text_insert_text(et, pos, text, len(text), 0)
			method = "editable_text.insert"
		}
		g_object_unref(et)
	}
	if !ok {
		// Fallback: focus the widget, then synthesize the string.
		//
		// VERIFY the focus landed before typing. grab_focus silently does
		// nothing on some web elements (Chromium), and synthesizing a string
		// into an unknown focus is genuinely dangerous: a space character
		// presses whatever button happens to be focused. That is not
		// hypothetical — it closed a browser during testing.
		if has_xclip() {
			ie, ic := injector_check()
			if ic != EX_OK {
				g_object_unref(node)
				out = ie
				code = ic
				return
			}
		}
		comp := atspi_accessible_get_component_iface(node)
		if comp != 0 {
			atspi_component_grab_focus(comp, 0)
			g_object_unref(comp)
			sleep(120)
		}
		if !hasstate(node, ST_FOCUSED) {
			g_object_unref(node)
			code = EX_NO_CAPABILITY
			out = errjson(EX_NO_CAPABILITY, "focus_refused", "could not focus '"+role+"', so typing would go somewhere unknown", true, []string{"click it first: linux-use click " + ref, "then verify focused:true in: linux-use state --app <app>", "then: linux-use sendtext '<text>'"})
			return
		}
		// Focus is verified, so prefer the clipboard route: AT-SPI key
		// synthesis crashes a11y-forced Chromium (issue #4).
		if has_xclip() {
			ok, _ = clip_paste(text, true)
			method = "clipboard+ctrl_v(focus-verified)"
		} else {
			ok = atspi_generate_keyboard_event(0, text, KEY_STRING, 0)
			method = "keyboard.string(focus-verified)"
			write(2, "warning: xclip not found, used AT-SPI key synthesis — crashes a11y-forced Chromium (issue #4)\n")
		}
	}
	g_object_unref(node)
	if !ok {
		code = EX_ACTION_FAILED
		out = errjson(EX_ACTION_FAILED, "type_failed", "could not insert text into '"+role+"'", true, []string{"try: linux-use click " + ref + " then linux-use key <keys>"})
		return
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("ref", jstr(ref)) + "," + jkv("method", jstr(method)) + "," + jkv("chars", str(len(text))) + "}"
}

// ---------------------------------------------------------------- X11 input

func xopen() (dpy) {
	dpy = XOpenDisplay(env("DISPLAY"))
}

// ---------------------------------------------------------------- injector

// Every synthetic-input call goes through the injector_* functions below.
// XTEST is the only backend; Wayland backends are not planned (issue #1).

// injector_select picks a backend: --injector, then LINUX_USE_INJECTOR, then
// autodetect. name is "" when nothing is usable; reason then says why.
func injector_select() (name, source, reason) {
	name = ""
	reason = ""
	req := wantInjector
	source = "flag"
	if len(req) == 0 {
		req = env("LINUX_USE_INJECTOR")
		source = "env"
	}
	if len(req) > 0 && req != "auto" {
		if req == "xtest" {
			name = "xtest"
		} else {
			reason = "unknown injector '" + req + "' (implemented: xtest)"
		}
		return
	}
	source = "autodetect"
	st := env("XDG_SESSION_TYPE")
	if st == "wayland" || (st != "x11" && len(env("WAYLAND_DISPLAY")) > 0) {
		reason = "Wayland session: XTEST cannot reach native Wayland clients and no Wayland-capable injector is implemented yet"
		return
	}
	name = "xtest"
}

// injector_check returns code EX_OK when a backend is usable, otherwise the
// typed error envelope. Call it BEFORE any side effect (focus, clipboard).
func injector_check() (out, code) {
	code = EX_OK
	out = ""
	name, source, reason := injector_select()
	if len(name) > 0 {
		return
	}
	if source != "autodetect" {
		code = EX_USAGE
		out = errjson(EX_USAGE, "unknown_injector", reason, true, []string{"use --injector xtest, or --injector auto", "check LINUX_USE_INJECTOR"})
		return
	}
	code = EX_NO_INJECTOR
	out = errjson(EX_NO_INJECTOR, "no_injector", reason, true, []string{"use the accessibility action instead: linux-use act <ref>", "for text fields: linux-use type <ref> <text> (works when the widget is natively editable)", "only if the target is an XWayland app: --injector xtest (or LINUX_USE_INJECTOR=xtest)"})
}

// injector_open returns 0 when no backend is selected or it cannot be opened.
func injector_open() (h) {
	h = 0
	name, _, _ := injector_select()
	if name == "xtest" {
		h = xopen()
	}
}

func injector_move(h, x, y) {
	XTestFakeMotionEvent(h, -1, x, y, 0)
}

func injector_button(h, button, press) {
	XTestFakeButtonEvent(h, button, press, 0)
}

func injector_key(h, keycode, press) {
	XTestFakeKeyEvent(h, keycode, press, 0)
}

// injector_keycode is layout-dependent.
func injector_keycode(h, keysym) (kc) {
	kc = XKeysymToKeycode(h, keysym)
}

func injector_sync(h) {
	XSync(h, false)
}

func injector_close(h) {
	XCloseDisplay(h)
}

func keysym_alias(tok) (name, found) {
	name = ""
	found = true
	if tok == "ctrl" || tok == "control" {
		name = "Control_L"
	} else {
		if tok == "shift" {
			name = "Shift_L"
		} else {
			if tok == "alt" {
				name = "Alt_L"
			} else {
				if tok == "altgr" {
					name = "ISO_Level3_Shift"
				} else {
					if tok == "super" || tok == "meta" || tok == "cmd" || tok == "win" {
						name = "Super_L"
					} else {
						if tok == "enter" || tok == "return" {
							name = "Return"
						} else {
							if tok == "esc" || tok == "escape" {
								name = "Escape"
							} else {
								if tok == "tab" {
									name = "Tab"
								} else {
									if tok == "space" {
										name = "space"
									} else {
										if tok == "backspace" {
											name = "BackSpace"
										} else {
											if tok == "delete" || tok == "del" {
												name = "Delete"
											} else {
												if tok == "insert" || tok == "ins" {
													name = "Insert"
												} else {
													name = keysym_alias2(tok)
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
	if len(name) == 0 {
		found = false
	}
}

// keysym_alias2 is the tail of the alias table, split out only because MFL has
// no switch and the nesting would otherwise get silly.
func keysym_alias2(tok) (name) {
	name = ""
	if tok == "up" {
		name = "Up"
		return
	}
	if tok == "down" {
		name = "Down"
		return
	}
	if tok == "left" {
		name = "Left"
		return
	}
	if tok == "right" {
		name = "Right"
		return
	}
	if tok == "home" {
		name = "Home"
		return
	}
	if tok == "end" {
		name = "End"
		return
	}
	if tok == "pageup" || tok == "pgup" {
		name = "Prior"
		return
	}
	if tok == "pagedown" || tok == "pgdn" {
		name = "Next"
		return
	}
	if tok == "printscreen" || tok == "prtsc" || tok == "print" {
		name = "Print"
		return
	}
	if tok == "menu" {
		name = "Menu"
		return
	}
	if tok == "pause" {
		name = "Pause"
		return
	}
	if tok == "capslock" {
		name = "Caps_Lock"
		return
	}
	if tok == "numlock" {
		name = "Num_Lock"
		return
	}
	if tok == "scrolllock" || tok == "scroll_lock" {
		name = "Scroll_Lock"
		return
	}
	// f1..f24 in either case: the X keysyms are F1..F24
	if len(tok) >= 2 && len(tok) <= 3 {
		if charat(tok, 0) == "f" {
			n := parse_int(substr(tok, 1, len(tok)))
			if n >= 1 && n <= 24 {
				name = "F" + str(n)
			}
		}
	}
}

// capitalise upper-cases the first character only, turning "print" into "Print"
// and "f4" into "F4" — the shape most X keysym names take.
func capitalise(t) (r) {
	r = t
	if len(t) == 0 {
		return
	}
	r = to_upper(substr(t, 0, 1)) + substr(t, 1, len(t))
}

// resolve_keysym tries, in order: the alias table (case-insensitive), the token
// EXACTLY as written, then the token capitalised. X keysym names are
// CASE-SENSITIVE, so lowercasing the whole combo before lookup — as this used
// to do — made every capitalised name ("F4", "Print", "Menu") unresolvable.
func resolve_keysym(tok) (name, ks) {
	name = ""
	ks = 0
	alias, found := keysym_alias(to_lower(tok))
	if found {
		ks = XStringToKeysym(alias)
		if ks != 0 {
			name = alias
			return
		}
	}
	ks = XStringToKeysym(tok)
	if ks != 0 {
		name = tok
		return
	}
	cap := capitalise(tok)
	ks = XStringToKeysym(cap)
	if ks != 0 {
		name = cap
		return
	}
	name = tok
	ks = 0
}

func cmd_sendtext(text, via) (out, code) {
	code = EX_OK
	if len(text) == 0 {
		code = EX_USAGE
		out = errjson(EX_USAGE, "missing_text", "sendtext needs a string", true, []string{"example: linux-use sendtext 'hello'"})
		return
	}
	mech := via
	if mech == "" {
		mech = "auto"
	}
	if mech != "auto" && mech != "clipboard" && mech != "atspi" {
		code = EX_USAGE
		out = errjson(EX_USAGE, "bad_via", "--via takes auto|clipboard|atspi", true, []string{"omit --via for the safe default"})
		return
	}
	if mech == "auto" {
		if has_xclip() {
			mech = "clipboard"
		} else {
			mech = "atspi"
			write(2, "warning: xclip not found, falling back to AT-SPI key synthesis — this CRASHES Chromium/Edge started with --force-renderer-accessibility (issue #4). Install xclip to avoid it.\n")
		}
	}
	if mech == "clipboard" {
		if !has_xclip() {
			code = EX_NO_CAPABILITY
			out = errjson(EX_NO_CAPABILITY, "xclip_missing", "--via clipboard needs xclip on PATH", true, []string{"sudo apt install xclip"})
			return
		}
		ie, ic := injector_check()
		if ic != EX_OK {
			out = ie
			code = ic
			return
		}
		ok, restored := clip_paste(text, true)
		if !ok {
			code = EX_ACTION_FAILED
			out = errjson(EX_ACTION_FAILED, "sendtext_failed", "clipboard paste failed", true, []string{"run: linux-use doctor"})
			return
		}
		out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("chars", str(len(text))) + "," + jkv("method", jstr("clipboard+ctrl_v")) + "," + jkv("clipboard_restored", jbool(restored)) + "}"
		return
	}
	ok := atspi_generate_keyboard_event(0, text, KEY_STRING, 0)
	if !ok {
		code = EX_ACTION_FAILED
		out = errjson(EX_ACTION_FAILED, "sendtext_failed", "the a11y registry refused to synthesize the string", true, []string{"check: linux-use doctor"})
		return
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("chars", str(len(text))) + "," + jkv("method", jstr("keyboard.string")) + "," + jkv("warning", jstr("AT-SPI key synthesis crashes a11y-forced Chromium")) + "}"
}

// cmd_paste puts text on the clipboard and presses ctrl+v via XTEST.
//
// This exists because atspi_generate_keyboard_event (what `sendtext` uses)
// CRASHES Chromium/Edge launched with --force-renderer-accessibility —
// reproduced on a bare <input> page with focus verified, so it is not
// app-specific. The clipboard route never touches the AT-SPI device-event
// controller, so it is the safe way to put text into an a11y-forced browser.
//
// The text goes to the clipboard via a temp FILE, never through a shell
// argument, so quotes/newlines/$ in the payload cannot be reinterpreted.
func has_xclip() (b) {
	b = system("command -v xclip >/dev/null 2>&1") == 0
}

// clip_paste puts text on the CLIPBOARD selection and sends ctrl+v via XTEST.
// Returns (ok, restored). It deliberately avoids the AT-SPI input controller,
// which crashes Chromium built with forced renderer accessibility (issue #4).
// The payload is staged through a FILE, never a shell argument, so quotes,
// newlines and $ in the text cannot be reinterpreted.
func clip_paste(text, restore) (ok, restored) {
	ok = false
	restored = false
	tmp := "/tmp/.linux-use-clip"
	old := ""
	if restore {
		_, o, _ := exec("xclip -selection clipboard -o 2>/dev/null")
		old = o
	}
	if write_file(tmp, text) < 0 {
		return
	}
	// xclip stays alive to OWN the selection, so it must be backgrounded —
	// a foreground system() call never returns.
	system("xclip -selection clipboard -i " + tmp + " >/dev/null 2>&1 &")
	sleep(200)

	h := injector_open()
	if h == 0 {
		return
	}
	ctrl := injector_keycode(h, XStringToKeysym("Control_L"))
	v := injector_keycode(h, XStringToKeysym("v"))
	injector_key(h, ctrl, 1)
	injector_key(h, v, 1)
	injector_key(h, v, 0)
	injector_key(h, ctrl, 0)
	injector_sync(h)
	injector_close(h)
	sleep(250)
	ok = true

	if restore && len(old) > 0 {
		if write_file(tmp, old) >= 0 {
			system("xclip -selection clipboard -i " + tmp + " >/dev/null 2>&1 &")
			sleep(200)
			restored = true
		}
	}
}

func cmd_paste(text, restore) (out, code) {
	code = EX_OK
	if len(text) == 0 {
		code = EX_USAGE
		out = errjson(EX_USAGE, "missing_text", "paste needs a string", true, []string{"example: linux-use paste 'hello'"})
		return
	}
	if !has_xclip() {
		code = EX_NO_CAPABILITY
		out = errjson(EX_NO_CAPABILITY, "xclip_missing", "paste needs xclip on PATH", true, []string{"sudo apt install xclip", "or force the unsafe path: linux-use sendtext --via atspi '<text>'"})
		return
	}
	ie, ic := injector_check()
	if ic != EX_OK {
		out = ie
		code = ic
		return
	}
	ok, restored := clip_paste(text, restore)
	if !ok {
		code = EX_ACTION_FAILED
		out = errjson(EX_ACTION_FAILED, "paste_failed", "could not set the clipboard or send ctrl+v", true, []string{"run: linux-use doctor"})
		return
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("chars", str(len(text))) + "," + jkv("method", jstr("clipboard+ctrl_v")) + "," + jkv("clipboard_restored", jbool(restored)) + "}"
}

func cmd_key(combo, dryrun) (out, code) {
	code = EX_OK
	// --dry-run sends nothing, so it only needs a display to resolve keycodes.
	if !dryrun {
		ie, ic := injector_check()
		if ic != EX_OK {
			out = ie
			code = ic
			return
		}
	}
	dpy := 0
	if dryrun {
		dpy = xopen()
	} else {
		dpy = injector_open()
	}
	if dpy == 0 {
		code = EX_NO_DISPLAY
		out = errjson(EX_NO_DISPLAY, "no_display", "cannot open X display '"+env("DISPLAY")+"'", false, []string{"this build injects input via XTEST and needs an X11 session", "run: linux-use doctor"})
		return
	}
	toks := split(combo, "+")
	codes := []int{}
	resolved := []string{}
	i := 0
	while i < len(toks) {
		t := trim(toks[i])
		if len(t) > 0 {
			nm, ks := resolve_keysym(t)
			if ks == 0 {
				injector_close(dpy)
				code = EX_USAGE
				out = errjson(EX_USAGE, "unknown_key", "'"+t+"' is not a known key name", true, []string{"keysym names are CASE-SENSITIVE: F4 not f4 (f1-f12 are accepted either way)", "aliases: ctrl shift alt super enter esc tab space backspace delete insert up down left right home end pageup pagedown print menu pause", "list every valid name with: xmodmap -pke"})
				return
			}
			kc := injector_keycode(dpy, ks)
			if kc == 0 {
				injector_close(dpy)
				code = EX_USAGE
				out = errjson(EX_USAGE, "unmapped_key", "'"+nm+"' has no keycode in the current layout", true, []string{"the active keyboard layout cannot produce this key"})
				return
			}
			codes = append(codes, kc)
			resolved = append(resolved, nm)
		}
		i = i + 1
	}
	if len(codes) == 0 {
		injector_close(dpy)
		code = EX_USAGE
		out = errjson(EX_USAGE, "empty_combo", "no keys given", true, []string{"example: linux-use key ctrl+shift+t"})
		return
	}
	if dryrun {
		injector_close(dpy)
		q := []string{}
		i = 0
		while i < len(resolved) {
			q = append(q, jstr(resolved[i]))
			i = i + 1
		}
		out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("combo", jstr(combo)) + "," + jkv("keys", jarr(q)) + "," + jkv("sent", "false") + "}"
		return
	}
	i = 0
	while i < len(codes) {
		injector_key(dpy, codes[i], 1)
		i = i + 1
	}
	i = len(codes) - 1
	while i >= 0 {
		injector_key(dpy, codes[i], 0)
		i = i - 1
	}
	injector_sync(dpy)
	injector_close(dpy)
	q := []string{}
	i = 0
	while i < len(resolved) {
		q = append(q, jstr(resolved[i]))
		i = i + 1
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("combo", jstr(combo)) + "," + jkv("keys", jarr(q)) + "}"
}

func clickxy(x, y, button) (ok) {
	ok = false
	h := injector_open()
	if h == 0 {
		return
	}
	injector_move(h, x, y)
	injector_sync(h)
	sleep(40)
	injector_button(h, button, 1)
	injector_button(h, button, 0)
	injector_sync(h)
	injector_close(h)
	ok = true
}

func cmd_click(ref, px, py, button) (out, code) {
	code = EX_OK
	ie, ic := injector_check()
	if ic != EX_OK {
		out = ie
		code = ic
		return
	}
	x := px
	y := py
	label := "coordinates"
	if len(ref) > 0 {
		node, e, c := getnode(ref)
		if c != EX_OK {
			out = e
			code = c
			return
		}
		ex, ey, w, h := extents(node)
		g_object_unref(node)
		if w <= 0 || h <= 0 {
			code = EX_NO_CAPABILITY
			out = errjson(EX_NO_CAPABILITY, "no_extents", "element has no on-screen geometry to click", true, []string{"use: linux-use act " + ref})
			return
		}
		x = ex + w/2
		y = ey + h/2
		label = ref
	}
	if !clickxy(x, y, button) {
		code = EX_NO_DISPLAY
		out = errjson(EX_NO_DISPLAY, "no_display", "cannot open X display", false, []string{"run: linux-use doctor"})
		return
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("target", jstr(label)) + "," + jkv("x", str(x)) + "," + jkv("y", str(y)) + "," + jkv("button", str(button)) + "}"
}

func cmd_launch(command, waitfor, timeoutms) (out, code) {
	code = EX_OK
	rc := system(command + " >/dev/null 2>&1 &")
	appeared := false
	waited := 0
	if len(waitfor) > 0 {
		while waited < timeoutms {
			a := findapp(waitfor)
			if a != 0 {
				g_object_unref(a)
				appeared = true
				waited = timeoutms
			} else {
				sleep(200)
				waited = waited + 200
			}
		}
		if !appeared {
			code = EX_APP_NOT_FOUND
			out = errjson(EX_APP_NOT_FOUND, "launch_timeout", "'"+waitfor+"' did not appear in the accessibility tree within "+str(timeoutms)+"ms", true, []string{"the app may be slow to start, or may not export accessibility", "run: linux-use apps"})
			return
		}
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("command", jstr(command)) + "," + jkv("spawn_rc", str(rc)) + "," + jkv("appeared", jbool(appeared)) + "}"
}

// cmd_roles lists every role name the toolkit knows, flagging the ones in the
// default interactive filter. --role takes these verbatim.
func cmd_roles() (out, code) {
	code = EX_OK
	items := []string{}
	n := lu_role_count()
	i := 0
	while i <= n {
		nm := takestr(atspi_role_get_name(i))
		if len(nm) > 0 {
			items = append(items, "{" + jkv("role", jstr(nm)) + "," + jkv("interactive", jbool(interactive(nm))) + "}")
		}
		i = i + 1
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("roles", jarr(items)) + "," + jkv("count", str(len(items))) + "}"
}

func cmd_doctor() (out, code) {
	code = EX_OK
	f := []string{}
	f = append(f, jkv("schema", jstr(SCHEMA)))
	f = append(f, jkv("session_type", jstr(env("XDG_SESSION_TYPE"))))
	f = append(f, jkv("display", jstr(env("DISPLAY"))))
	f = append(f, jkv("wayland_display", jstr(env("WAYLAND_DISPLAY"))))

	_, tk, _ := exec("gsettings get org.gnome.desktop.interface toolkit-accessibility 2>/dev/null")
	tkon := contains(tk, "true")
	f = append(f, jkv("toolkit_accessibility", jbool(tkon)))

	a11y := a11y_up()
	f = append(f, jkv("atspi", jbool(a11y)))
	napps := 0
	if a11y {
		napps = atspi_accessible_get_child_count(desktop, 0)
	}
	f = append(f, jkv("applications", str(napps)))

	dpy := xopen()
	xok := dpy != 0
	if xok {
		XCloseDisplay(dpy)
	}
	f = append(f, jkv("xtest", jbool(xok)))
	xc := has_xclip()
	f = append(f, jkv("clipboard_backend", jbool(xc)))
	f = append(f, jkv("text_entry_default", jstr("clipboard+ctrl_v")))
	if !xc {
		f = append(f, jkv("text_entry_actual", jstr("atspi.keystring (UNSAFE for a11y-forced Chromium)")))
	} else {
		f = append(f, jkv("text_entry_actual", jstr("clipboard+ctrl_v")))
	}

	iname, isource, ireason := injector_select()
	f = append(f, jkv("injector", jstr(iname)))
	f = append(f, jkv("injector_source", jstr(isource)))
	f = append(f, jkv("injectors_available", jarr([]string{jstr("xtest")})))
	f = append(f, jkv("injector_reason", jstr(ireason)))

	probs := []string{}
	if !tkon {
		probs = append(probs, jstr("toolkit-accessibility is off — Qt/Java/Electron apps may expose nothing. Fix: gsettings set org.gnome.desktop.interface toolkit-accessibility true"))
	}
	if !a11y {
		probs = append(probs, jstr("the AT-SPI bus is unreachable — perception will not work at all"))
	}
	if !xc {
		probs = append(probs, jstr("xclip is missing, so text entry falls back to AT-SPI key synthesis, which CRASHES Chromium/Edge started with --force-renderer-accessibility (issue #4). Fix: sudo apt install xclip"))
	}
	if !xok {
		probs = append(probs, jstr("no X display — click/key actuation unavailable (AT-SPI actions still work)"))
	}
	if len(iname) == 0 {
		probs = append(probs, jstr("no usable input injector — " + ireason + ". Prefer 'act'; click/key exit " + str(EX_NO_INJECTOR) + "."))
	} else {
		if env("XDG_SESSION_TYPE") == "wayland" {
			probs = append(probs, jstr("Wayland session with xtest forced: input reaches XWayland apps only."))
		}
	}
	f = append(f, jkv("ok", jbool(len(probs) == 0)))
	f = append(f, jkv("problems", jarr(probs)))
	out = "{" + join(f, ",") + "}"
	if len(probs) > 0 {
		code = EX_NO_A11Y
		if a11y {
			code = EX_OK
		}
	}
}

func cmd_pointer() (out, code) {
	code = EX_OK
	dpy := xopen()
	if dpy == 0 {
		code = EX_NO_DISPLAY
		out = errjson(EX_NO_DISPLAY, "no_display", "cannot open X display", false, []string{"run: linux-use doctor"})
		return
	}
	root := XDefaultRootWindow(dpy)
	buf := alloc(64)
	XQueryPointer(dpy, root, buf, buf+8, buf+16, buf+20, buf+24, buf+28, buf+32)
	x := peek_i32(buf, 16)
	y := peek_i32(buf, 20)
	free(buf)
	XCloseDisplay(dpy)
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("x", str(x)) + "," + jkv("y", str(y)) + "}"
}

// ---------------------------------------------------------------- watch

// The AT-SPI callback is compiled to a raw C function pointer, so it must be
// CAPTURELESS — every knob it reads is a package global.
var wchApp = ""
var wchRole = ""
var wchSeen = 0
var wchMax = 0
var wchMaxRss = 0

// pathof reconstructs an actionable ref by walking UP from an event source to
// its application, collecting child indices. Events give us a node, not a path.
// indexof is atspi_accessible_get_index_in_parent with a fallback. Some nodes
// report -1; silently DROPPING such a level builds a path that looks valid but
// resolves to the wrong widget, so scan the parent's children instead.
// sameobj tests accessible identity by POINTER only. atspi_accessible_get_id
// was tried as a fallback and rejected: it is not unique per object here and
// produced false matches, i.e. confidently WRONG refs. A ref we cannot prove
// is better reported as unusable than guessed.
func sameobj(a, b) (r) {
	r = a == b
}

var icache = make(map[string]string)

func indexof(node) (idx) {
	idx = -1
	ck := ""
	cv := ""
	if cacheOn {
		ck = str(node)
		cv = icache[ck]
	}
	if len(cv) > 0 {
		idx = parse_int(cv) - 1
		return
	}
	par := atspi_accessible_get_parent(node, 0)
	if par == 0 {
		return
	}
	// index_in_parent is a HINT, not the truth: it can return a non-negative
	// value that disagrees with get_child_at_index (observed in
	// gnome-control-center, where it said 0 for a child actually at 1).
	// Refs are resolved with get_child_at_index, so that is the authority —
	// take the hint only when it verifies against it.
	hint := atspi_accessible_get_index_in_parent(node, 0)
	if hint >= 0 {
		c := atspi_accessible_get_child_at_index(par, hint, 0)
		if c != 0 {
			same := sameobj(c, node)
			g_object_unref(c)
			if same {
				idx = hint
				if cacheOn {
					icache[ck] = str(idx + 1)
				}
				g_object_unref(par)
				return
			}
		}
	}
	n := atspi_accessible_get_child_count(par, 0)
	i := 0
	while i < n {
		c := atspi_accessible_get_child_at_index(par, i, 0)
		if c != 0 {
			same := sameobj(c, node)
			g_object_unref(c)
			if same {
				idx = i
				if cacheOn {
					icache[ck] = str(idx + 1)
				}
				g_object_unref(par)
				return
			}
		}
		i = i + 1
	}
	g_object_unref(par)
}

// pcache memoizes "path from the application root" per accessible, keyed by
// pointer. Collection matches are siblings in a tree: each one climbs through
// the SAME ancestors, so without memoization the climb is re-walked once per
// match and eats the whole benefit of the server-side query.
//
// Lifetime is ONE query. Paths are only valid for the tree as it was; keeping
// entries across a UI change would resurrect the exact bug this tool exists to
// avoid — a ref that resolves to the wrong widget.
var pcache = make(map[string]string)
var cacheOn = false

func pcache_reset() {
	pcache = make(map[string]string)
	icache = make(map[string]string)
}

// pathof reconstructs a ref by walking UP to the application, memoizing every
// ancestor it passes. ok=false means an ancestor index could not be determined
// — the ref would be WRONG, so it is reported as unusable rather than emitted
// as a plausible lie.
func pathof(node) (path, appname, ok) {
	path = ""
	appname = ""
	ok = false
	keys := []string{}
	idxs := []int{}
	prefix := ""
	cur := node
	owned := false
	hops := 0
	basePath := ""
	baseApp := ""
	done := false
	bad := false
	while !done && !bad && hops < 64 {
		k := ""
		cv := ""
		if cacheOn {
			k = str(cur)
			cv = pcache[k]
		}
		if len(cv) > 0 {
			parts := split(cv, "\t")
			baseApp = parts[0]
			basePath = parts[1]
			done = true
		} else {
			if noderole(cur) == "application" {
				baseApp = nodename(cur)
				basePath = ""
				if cacheOn {
					pcache[k] = baseApp + "\t"
				}
				done = true
			} else {
				idx := indexof(cur)
				if idx < 0 {
					bad = true
				} else {
					if cacheOn {
						keys = append(keys, k)
						idxs = append(idxs, idx)
					} else {
						// Uncached (watch): accumulate directly. The two arrays
						// exist only to backfill the cache, and allocating them
						// per event is a slow leak in a long-lived listener.
						prefix = "/" + str(idx) + prefix
					}
					nxt := atspi_accessible_get_parent(cur, 0)
					if owned {
						g_object_unref(cur)
					}
					cur = nxt
					owned = true
					if cur == 0 {
						bad = true
					}
					hops = hops + 1
				}
			}
		}
	}
	if owned && cur != 0 {
		g_object_unref(cur)
	}
	if bad || !done {
		return
	}
	appname = baseApp
	if !cacheOn {
		path = basePath + prefix
		ok = true
		return
	}
	acc := basePath
	j := len(keys) - 1
	while j >= 0 {
		acc = acc + "/" + str(idxs[j])
		pcache[keys[j]] = appname + "\t" + acc
		j = j - 1
	}
	path = acc
	ok = true
}

// on_event runs for the life of the process, so every allocation it makes
// would accumulate. The body lives in an `arena` block whose memory is
// reclaimed in bulk at the end of each event; nothing escapes it (the JSON is
// written to stdout inside the block), so the reclamation is safe.
// NOTE: no `return` may appear inside an arena block (it would skip cleanup),
// hence the `emit` flag instead of early returns.
func on_event(ev, data) {
	src := lu_ev_source(ev)
	if src == 0 {
		return
	}
	if wchMax > 0 && wchSeen >= wchMax {
		return
	}
	// No path cache here: one event means one climb, so the cache would buy
	// nothing — and its maps are allocated OUTSIDE the arena below, so they
	// would leak once per event. (Measured at ~17 kB/event before the arena.)
	cacheOn = false
	arena {
		emit := true
		etype := takestr_borrowed(lu_ev_type(ev))
		path, appname, pathok := pathof(src)
		if len(wchApp) > 0 && appname != wchApp {
			emit = false
		}
		if emit && len(wchRole) > 0 {
			if noderole(src) != wchRole {
				emit = false
			}
		}
		if emit {
			role := noderole(src)
			name := nodename(src)
			f := []string{}
			f = append(f, jkv("event", jstr(etype)))
			f = append(f, jkv("app", jstr(appname)))
			f = append(f, jkv("role", jstr(role)))
			f = append(f, jkv("name", jstr(name)))
			rf := ""
			if pathok {
				rf = mkref(appname, path, role, name)
			}
			f = append(f, jkv("ref", jstr(rf)))
			f = append(f, jkv("ref_ok", jbool(pathok)))
			f = append(f, jkv("detail1", str(lu_ev_detail1(ev))))
			f = append(f, jkv("detail2", str(lu_ev_detail2(ev))))
			f = append(f, jkv("ts", str(now_ms())))
			println("{" + join(f, ",") + "}")
			flush()
			wchSeen = wchSeen + 1
		}
	}
	if wchMax > 0 && wchSeen >= wchMax {
		atspi_event_quit()
	}
	// libatspi's event delivery grows ~0.14 kB per event on at-spi2-core 2.44,
	// independent of what this callback does (measured with a no-op callback).
	// It is not ours to fix, so make it BOUNDED: exit cleanly at a ceiling and
	// let a supervisor restart, rather than growing without limit.
	if wchMaxRss > 0 {
		if wchSeen % 64 == 0 {
			if lu_rss_kb() > wchMaxRss {
				write(2, "linux-use watch: rss ceiling reached (" + str(lu_rss_kb()) + " kB > " + str(wchMaxRss) + " kB) after " + str(wchSeen) + " events; exiting " + str(EX_RSS_LIMIT) + " for a supervisor to restart\n")
				flush()
				exit(EX_RSS_LIMIT)
			}
		}
	}
}

func default_events() (r) {
	r = []string{}
	r = append(r, "object:state-changed:focused")
	r = append(r, "object:text-changed:insert")
	r = append(r, "object:text-changed:delete")
	r = append(r, "object:selection-changed")
	r = append(r, "window:activate")
	r = append(r, "window:deactivate")
	r = append(r, "window:create")
	r = append(r, "window:destroy")
}

func cmd_watch(appfilter, rolefilter, evspec, maxev, duration, maxrss) (out, code) {
	code = EX_OK
	out = ""
	wchApp = appfilter
	wchRole = rolefilter
	wchMaxRss = maxrss
	wchSeen = 0
	wchMax = maxev

	evs := default_events()
	if len(evspec) > 0 {
		evs = split(evspec, ",")
	}

	lst := atspi_event_listener_new(func(ev, data) { on_event(ev, data) }, 0, 0)
	if lst == 0 {
		code = EX_NO_A11Y
		out = errjson(EX_NO_A11Y, "watch_unavailable", "could not create an AT-SPI event listener", false, []string{"run: linux-use doctor"})
		return
	}
	reg := []string{}
	i := 0
	while i < len(evs) {
		e := trim(evs[i])
		if len(e) > 0 {
			if atspi_event_listener_register(lst, e, 0) {
				reg = append(reg, jstr(e))
			} else {
				write(2, "warning: could not register for '" + e + "'\n")
			}
		}
		i = i + 1
	}
	if len(reg) == 0 {
		code = EX_USAGE
		out = errjson(EX_USAGE, "no_events_registered", "none of the requested event types could be registered", true, []string{"omit --events for the default set"})
		return
	}
	// Banner on stderr so stdout stays pure NDJSON.
	banner := "linux-use watch: " + str(len(reg)) + " event types registered; NDJSON on stdout"
	if wchMaxRss > 0 {
		banner = banner + "; rss ceiling " + str(wchMaxRss) + " kB (exit " + str(EX_RSS_LIMIT) + ")"
	}
	write(2, banner + "\n")
	if duration > 0 {
		g_timeout_add(duration, func(d) { atspi_event_quit()  return false }, 0)
	}
	atspi_event_main()
}

// ---------------------------------------------------------------- guide

func guide_json() (r) {
	c := []string{}
	c = append(c, jkv("linux-use", jstr("Control a Linux desktop GUI at the accessibility layer — read widget trees, act on widgets, no screenshots or pixel coordinates needed.")))
	c = append(c, jkv("version", jstr(VERSION)))
	c = append(c, jkv("schema", jstr(SCHEMA)))
	c = append(c, jkv("one_liner", jstr("linux-use reads the AT-SPI2 accessibility tree every GUI app publishes and acts on named widgets — perception and actuation only. There is no LLM inside; you are the loop.")))

	m := []string{}
	m = append(m, jkv("tree", jstr("Every GUI app publishes a tree of widgets over AT-SPI2. linux-use reads that tree and acts on it. You do NOT need screenshots or pixel coordinates for most work.")))
	m = append(m, jkv("ref", jstr("An element ref looks like 'gnome-calculator:/0/1/0/3#824713' — application name, child-index path, and a fingerprint of role+name. Pass refs back verbatim; never construct or edit one by hand.")))
	m = append(m, jkv("ambiguity", jstr("Two applications can publish the SAME accessible name (two browser profiles both called \"Microsoft Edge\"). A plain --app matching more than one is REFUSED with app_ambiguous rather than picking one; disambiguate with --app 'Name#pid1234' or --pid 1234. 'linux-use apps' lists each pid and flags ambiguous_names.")))
	m = append(m, jkv("ref_kinds", jstr("A ref comes in two kinds, and ref_kind says which. A PATH ref (app:/0/1/2#fp) addresses a node by child indices. A GEOMETRY ref (app:@<roleId>~x,y,w,h#fp) addresses it by role and on-screen rectangle, and is issued when a node has no provable path — some toolkits report a parent that does not list the node among its children, so climbing to it is impossible, not merely unknown. Both are used identically: pass them back verbatim.")))
	m = append(m, jkv("geometry_refs", jstr("A geometry ref is tied to screen position, so moving or resizing the window invalidates it — you get exit 84, never a silent hit on the wrong widget. If two widgets share a role and rectangle the ref is refused as ambiguous rather than guessed.")))
	m = append(m, jkv("staleness", jstr("Refs go stale when the UI changes. That is DETECTED, not silently ignored: you get exit 83 ref_stale. The fix is always to re-run 'state' and use fresh refs.")))
	m = append(m, jkv("actuation", jstr("Prefer 'act' over 'click'. 'act' invokes the widget's own accessible action — it needs no focus, no pointer, and works even when the window is fully occluded by another window. 'click' synthesizes a real pointer event and is the fallback for widgets that expose no action.")))
	c = append(c, jkv("model", "{" + join(m, ",") + "}"))

	l := []string{}
	l = append(l, jstr("1. linux-use apps            — what is running and exposes accessibility"))
	l = append(l, jstr("2. linux-use state --app X   — the interactive elements of that app, with refs"))
	l = append(l, jstr("3. linux-use act <ref>       — act on one; or type/key/click as needed"))
	l = append(l, jstr("4. linux-use read <ref> or state again — VERIFY the effect before the next step"))
	l = append(l, jstr("Instead of polling step 4 in a sleep loop, run: linux-use watch --app X --duration 5000 (NDJSON, one event per line). Use --max-events N to stop after exactly N."))
	c = append(c, jkv("loop", jarr(l)))

	k := []string{}
	k = append(k, jkv("ref", jstr("a widget address: app:path#fingerprint or app:@role~x,y,w,h#fingerprint. Opaque — pass verbatim.")))
	k = append(k, jkv("fingerprint", jstr("hash of role+name inside a ref. A changed name makes the ref stale on purpose: the staleness IS the change signal.")))
	k = append(k, jkv("ref_kind", jstr("path | geometry — geometry refs die when the window moves; path refs die when the tree reshapes. Both are detected, never guessed.")))
	k = append(k, jkv("act", jstr("the widget's own accessible action — works with no focus and no pointer, even fully occluded. Always prefer it over click.")))
	k = append(k, jkv("collection", jstr("server-side AT-SPI match query: one D-Bus round trip for all matching nodes. state/find use it when a --role filter is set; method reports which ran.")))
	k = append(k, jkv("expand", jstr("scroll-driven realization: asks the app to materialize below-fold nodes, merges passes by ref path, scrolls back. --expand on state/find.")))
	k = append(k, jkv("watch", jstr("NDJSON event stream over AT-SPI (object:state-changed etc.) — block on UI change instead of polling.")))
	k = append(k, jkv("daemon", jstr("a warm AT-SPI registry over loopback HTTP: /_health, /_shutdown, /v1/<command>/... — keeps the bus connection hot between invocations.")))
	k = append(k, jkv("cdp", jstr("Chrome DevTools Protocol path (--via cdp): whole-DOM perception + real DOM clicks for dedicated-profile browsers launched with --remote-debugging-port. Never on the live profile.")))
	c = append(c, jkv("concepts", "{" + join(k, ",") + "}"))

	cd := []string{}
	cd = append(cd, jkv("perceive", jarr([]string{jstr("linux-use apps"), jstr("linux-use windows [--app X]"), jstr("linux-use state --app X [--role R] [--all] [--expand] [--via cdp] [--format lines]"), jstr("linux-use find <query> --app X [--role R] [--expand]"), jstr("linux-use read <ref>"), jstr("linux-use pointer")})))
	cd = append(cd, jkv("act", jarr([]string{jstr("linux-use act <ref> [--action N]"), jstr("linux-use click <ref|--x N --y N> [--button B]"), jstr("linux-use type <ref> <text> [--replace] [--allow-password]"), jstr("linux-use paste <text>"), jstr("linux-use sendtext <text> [--via auto|clipboard|atspi]"), jstr("linux-use key <combo> [--dry-run]")})))
	cd = append(cd, jkv("observe", jarr([]string{jstr("linux-use watch [--app X] [--role R] [--events T,...] [--max-events N] [--duration MS] [--max-rss KB]"), jstr("linux-use stats [--last N]")})))
	cd = append(cd, jkv("lifecycle", jarr([]string{jstr("linux-use launch <command> [--wait-for APP] [--timeout MS]"), jstr("linux-use serve [--host H] [--port P]"), jstr("linux-use daemon start|stop|status [--host H] [--port P]")})))
	cd = append(cd, jkv("meta", jarr([]string{jstr("linux-use guide [--human]"), jstr("linux-use help-json"), jstr("linux-use doctor"), jstr("linux-use roles"), jstr("linux-use version"), jstr("linux-use feedback <message>"), jstr("linux-use update [--check|--force]"), jstr("linux-use install|uninstall [--prefix D]"), jstr("linux-use telemetry [--off]")})))
	c = append(c, jkv("commands", "{" + join(cd, ",") + "}"))

	ex := []string{}
	ex = append(ex, "{" + jkv("goal", jstr("press a button in a GTK app")) + "," + jkv("do", jarr([]string{jstr("linux-use apps"), jstr("linux-use state --app gnome-calculator"), jstr("linux-use act 'gnome-calculator:/0/1/0/3#824713'"), jstr("linux-use state --app gnome-calculator --format lines")})) + "}")
	ex = append(ex, "{" + jkv("goal", jstr("fill a form field in a dedicated-profile browser")) + "," + jkv("do", jarr([]string{jstr("contrib/a11y-browser -n work https://example.com"), jstr("linux-use find 'Email' --app 'Microsoft Edge'"), jstr("linux-use type '<ref>' 'me@example.com'"), jstr("linux-use act '<submit ref>'")})) + "}")
	ex = append(ex, "{" + jkv("goal", jstr("wait for a UI change instead of polling")) + "," + jkv("do", jarr([]string{jstr("linux-use watch --app gedit --max-events 1 --duration 10000")})) + "}")
	ex = append(ex, "{" + jkv("goal", jstr("keep the a11y registry warm across many invocations")) + "," + jkv("do", jarr([]string{jstr("linux-use daemon start"), jstr("curl -s localhost:7777/_health"), jstr("curl -s localhost:7777/v1/state/--app/gedit"), jstr("linux-use daemon stop")})) + "}")
	c = append(c, jkv("examples", jarr(ex)))

	g := []string{}
	g = append(g, jstr("SHOWING does not mean visible. An element can be SHOWING while completely hidden behind another window. Never tell a user 'you can see X' based on this tool."))
	g = append(g, jstr("Coverage is not universal. GTK/Qt/Chromium/Electron expose good trees. Java needs java-atk-wrapper. Flutter, games, and canvas-drawn UIs may expose almost nothing — 'state' returning 0 elements means no accessibility, not an empty window."))
	g = append(g, jstr("state is filtered to interactive roles by default. Use --all for the full tree (labels, panels) when you need to READ the UI rather than act on it."))
	g = append(g, jstr("CHROMIUM CRASH (issue #4): AT-SPI key synthesis CRASHES Chromium/Edge launched with --force-renderer-accessibility — reproduced on a bare input page with focus verified. Since 0.6.2 text entry therefore goes through the CLIPBOARD by default (set CLIPBOARD, send ctrl+v via XTEST): 'paste', 'sendtext' and the 'type' fallback are all safe out of the box. 'sendtext --via atspi' opts back into the crashing path deliberately; 'linux-use doctor' reports which backend is actually in use."))
	g = append(g, jstr("SAFETY: 'type <ref>' now verifies the element actually took focus before synthesizing keystrokes, and fails with focus_refused rather than typing into an unknown target. 'sendtext' does NOT — it types wherever focus is, by design, so confirm focus yourself (check focused:true in state) before using it. A stray space presses whatever button is focused."))
	g = append(g, jstr("'type' uses the editable-text interface when available (deterministic, no focus needed) and falls back to synthesized keystrokes. It REFUSES password fields unless --allow-password."))
	g = append(g, jstr("X keysym names are CASE-SENSITIVE: 'F4' resolves and plain 'f4' would not — except f1-f12 are accepted in either case, alongside aliases (ctrl shift alt super enter esc tab space backspace delete insert up down left right home end pageup pagedown print menu pause). Check a combo without firing it: 'linux-use key alt+F4 --dry-run'."))
	g = append(g, jstr("INPUT INJECTOR: click, key, paste, sendtext (clipboard route) and the type keyboard fallback inject input through a backend chosen by --injector, then LINUX_USE_INJECTOR, then autodetect. Only 'xtest' exists, so on a Wayland session these exit 91 (no_injector) instead of silently doing nothing — use 'act' there. --injector xtest forces it, which reaches XWayland apps only. 'key' maps keysyms through the active keyboard layout. 'doctor' reports the selected backend and why."))
	g = append(g, jstr("state/find run a SERVER-SIDE collection query when you pass --role (measured ~9x faster on a large app: 5ms vs 47ms) and a recursive tree walk otherwise. The `method` field says which ran; force either with --collection / --walk."))
	g = append(g, jstr("A collection result may contain elements with ref_ok:false — matched, on screen, but their path could not be proven, so no ref is given. They are still listed rather than dropped. Use --walk if you need a ref for every element."))
	g = append(g, jstr("Valid --role names come from `linux-use roles` (130 of them, 18 interactive by default). An unrecognised role matches nothing and warns on stderr."))
	g = append(g, jstr("watch's memory grows ~0.14 kB per event — that is libatspi's event delivery on at-spi2-core 2.44, not linux-use (a no-op callback leaks identically). For a long-lived listener pass --max-rss <kB> and restart on exit 90, or bound the run with --duration/--max-events."))
	g = append(g, jstr("watch takes --role too, which is the cheapest way to cut event noise: filtering to one role took a sample run from 54 events to the 6 that mattered."))
	g = append(g, jstr("watch emits a ref plus ref_ok. ref_ok:false means the path could not be reconstructed reliably — use the app/role/name fields, do not fabricate a ref."))
	g = append(g, jstr("For a label whose NAME IS ITS TEXT, the fingerprint changes whenever the text changes, so a ref captured from an event will report ref_stale on the next read. That is the mechanism working: the staleness IS the signal that the content changed. Re-run state, or drop the #fingerprint to address the path alone."))
	g = append(g, jstr("OBSERVER EFFECT: reading the tree (state/find) can itself make toolkits emit accessibility events. If you run 'watch' while also polling 'state', expect self-induced noise — especially object:state-changed:*, which is why it is not in the default event set."))
	g = append(g, jstr("Large apps (browsers) have huge trees. Use --role, --depth, or 'find' rather than dumping everything; a truncated walk warns on stderr and sets truncated:true."))
	g = append(g, jstr("On long web pages, state/find only see the nodes Chromium has realized — roughly the viewport plus a margin (measured: a 300-row table exposed ~55 rows). Widgets below the fold are absent from the tree entirely, so find returns no match for them. 'state --expand' automates the fix: it invokes the scrollable container's scrollForward/scrollDown accessible action when one exists (a full viewport per call, works occluded, no pointer) or XTEST wheel clicks at the window center otherwise, merges each pass by ref path, then scrolls back — envelope fields expanded/expand_passes/expand_ms report what happened; --expand-passes/--expand-wait tune it. To reach ONE below-fold widget prefer 'find <query> --app X --expand' — same sweep, returns only matches. If the browser is a dedicated-profile instance with --remote-debugging-port, 'state --via cdp' reads the whole DOM in one ~60ms query and act on its cdp<pid>:xpath refs fires a real DOM click — never usable on the live profile, which cannot expose a debug port. Manual equivalent: scroll (click --button 5) then re-run state."))
	g = append(g, jstr("state and find take --format lines: one element per line (ref, role, name, x,y,w,h, action, flags) — roughly half the tokens of the JSON envelope. Metadata moves to a leading # line; errors stay JSON."))
	g = append(g, jstr("NEVER automate the user's LIVE browser profile with Playwright/CDP: the forced --use-mock-keychain makes the cookie DB undecryptable and Chromium RESETS it (all site sessions wiped, unrecoverable — secure_delete zeroes deleted rows). Same for --user-data-dir=<real profile>. Always use a dedicated profile dir (contrib/a11y-browser) or a throwaway COPY of the profile. Driving the live session via AT-SPI (this tool) is safe; it touches no profile internals. Also note: the Edge process is 'msedge', not 'microsoft-edge' — a pgrep for the latter sees nothing while the browser is running."))
	c = append(c, jkv("gotchas", jarr(g)))

	e := []string{}
	e = append(e, jstr("0 ok | 80 usage | 81 no_a11y | 82 app_not_found | 83 ref_stale | 84 ref_not_found | 85 no_capability | 86 action_failed | 87 no_display | 88 daemon | 89 refused | 90 rss_limit (watch hit --max-rss; restart it)"))
	c = append(c, jkv("exit_codes", jarr(e)))

	o := []string{}
	o = append(o, jstr("stdout is JSON only — the answer. stderr carries warnings and progress. Branch on the exit code and error.code, never on message text."))
	o = append(o, jstr("Errors carry recoverable:true/false and a suggestions[] array telling you what to do next. Follow the suggestion before retrying."))
	c = append(c, jkv("output_contract", jarr(o)))

	d := []string{}
	d = append(d, jstr("Each invocation connects to the AT-SPI bus from cold. For repeated calls run 'linux-use daemon start' and the registry stays warm. 'serve' binds 127.0.0.1 by default — a wider bind needs an explicit --host, and /_shutdown becomes bearer-token gated (token in ~/.linux-use/shutdown.token)."))
	c = append(c, jkv("daemon", jarr(d)))

	t := []string{}
	t = append(t, jstr("linux-use sends anonymous usage counts: tool, version, os/arch, which verb ran, exit-class. No identity, arguments or data — one allow-listed POST per run, detached, silent on failure."))
	t = append(t, jstr("Inspect the exact payload with 'linux-use telemetry'. Disable: LINUX_USE_TELEMETRY=0, DO_NOT_TRACK=1, or 'linux-use telemetry --off'. Off by default in CI. Endpoint override: LINUX_USE_TELEMETRY_URL."))
	c = append(c, jkv("telemetry", jarr(t)))

	r = "{" + join(c, ",") + "}"
}

func guide_human() (r) {
	ls := []string{}
	ls = append(ls, "linux-use " + VERSION + " — GUI control for Linux at the accessibility layer.")
	ls = append(ls, "")
	ls = append(ls, "THE LOOP")
	ls = append(ls, "  apps  ->  state --app X  ->  act/type/key/click  ->  read/state (verify)")
	ls = append(ls, "")
	ls = append(ls, "REFS")
	ls = append(ls, "  'gnome-calculator:/0/1/0/3#824713' = app : child-path # fingerprint(role+name).")
	ls = append(ls, "  Pass them back verbatim. Stale refs are detected (exit 83), never guessed at.")
	ls = append(ls, "")
	ls = append(ls, "ACT vs CLICK")
	ls = append(ls, "  act   — the widget's own accessible action. No focus, no pointer, works occluded.")
	ls = append(ls, "  click — synthetic XTEST pointer. Fallback for widgets exposing no action.")
	ls = append(ls, "")
	ls = append(ls, "GOTCHAS")
	ls = append(ls, "  SHOWING != visible to the user (an occluded widget is still SHOWING).")
	ls = append(ls, "  0 elements means 'no accessibility', not 'empty window'.")
	ls = append(ls, "  key/click/paste need X11 (Wayland: exit 91, use act).")
	ls = append(ls, "  NEVER point Playwright/CDP at the user's LIVE browser profile — it wipes")
	ls = append(ls, "  the cookie DB (undecryptable under --use-mock-keychain -> reset). Copy first.")
	ls = append(ls, "")
	ls = append(ls, "Run 'linux-use guide' for the full JSON version, 'linux-use help-json' for the surface.")
	r = join(ls, "\n")
}

func helpjson() (r) {
	cmds := []string{}
	cmds = append(cmds, "{"+jkv("name", jstr("apps"))+","+jkv("args", jarr([]string{}))+","+jkv("summary", jstr("list applications with pid, toolkit and window count; flags ambiguous names"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("windows"))+","+jkv("args", jarr([]string{jstr("--app")}))+","+jkv("summary", jstr("list top-level windows with geometry and active state"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("state"))+","+jkv("args", jarr([]string{jstr("--app (required)"), jstr("--depth"), jstr("--role"), jstr("--all"), jstr("--expand"), jstr("--via cdp"), jstr("--format")}))+","+jkv("summary", jstr("interactive elements of an app, with refs; --expand scrolls to realize below-fold nodes, --via cdp reads the whole DOM in one query (debugging-port browsers), --format lines is compact"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("find"))+","+jkv("args", jarr([]string{jstr("<query>"), jstr("--app"), jstr("--role"), jstr("--depth"), jstr("--expand"), jstr("--format")}))+","+jkv("summary", jstr("search elements by name substring; --expand sweeps below the fold (needs --app)"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("stats"))+","+jkv("args", jarr([]string{jstr("--last N")}))+","+jkv("summary", jstr("aggregate ~/.cache/linux-use/metrics.jsonl — per-op calls and min/avg/max ms"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("act"))+","+jkv("args", jarr([]string{jstr("<ref>"), jstr("--action N")}))+","+jkv("summary", jstr("invoke the element's accessible action (preferred); cdp: refs fire a real DOM click"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("read"))+","+jkv("args", jarr([]string{jstr("<ref>")}))+","+jkv("summary", jstr("read an element's text, name and description"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("type"))+","+jkv("args", jarr([]string{jstr("<ref>"), jstr("<text>"), jstr("--replace"), jstr("--allow-password")}))+","+jkv("summary", jstr("insert text via the editable-text interface"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("paste"))+","+jkv("args", jarr([]string{jstr("<text>"), jstr("--no-restore")}))+","+jkv("summary", jstr("put text on the clipboard and ctrl+v it — the safe way to type into Chromium"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("sendtext"))+","+jkv("args", jarr([]string{jstr("<text>"), jstr("--via auto|clipboard|atspi")}))+","+jkv("summary", jstr("type a literal string at the current focus (no ref; works without a11y)"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("key"))+","+jkv("args", jarr([]string{jstr("<combo>"), jstr("--dry-run")}))+","+jkv("summary", jstr("send a key combo via XTEST, e.g. ctrl+shift+t"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("click"))+","+jkv("args", jarr([]string{jstr("<ref>"), jstr("--x"), jstr("--y"), jstr("--button")}))+","+jkv("summary", jstr("synthetic pointer click at an element or coordinates"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("launch"))+","+jkv("args", jarr([]string{jstr("<command>"), jstr("--wait-for"), jstr("--timeout")}))+","+jkv("summary", jstr("spawn a program, optionally waiting for it to register"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("watch"))+","+jkv("args", jarr([]string{jstr("--app"), jstr("--role"), jstr("--events"), jstr("--max-events"), jstr("--duration"), jstr("--max-rss")}))+","+jkv("summary", jstr("stream AT-SPI events as NDJSON — block on UI change instead of polling"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("pointer"))+","+jkv("args", jarr([]string{}))+","+jkv("summary", jstr("current pointer position"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("roles"))+","+jkv("args", jarr([]string{}))+","+jkv("summary", jstr("every valid --role name, with which are interactive by default"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("doctor"))+","+jkv("args", jarr([]string{}))+","+jkv("summary", jstr("environment health: session type, a11y bus, XTEST"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("serve"))+","+jkv("args", jarr([]string{jstr("--host"), jstr("--port")}))+","+jkv("summary", jstr("run the warm-registry HTTP daemon in the foreground; binds 127.0.0.1 by default"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("daemon"))+","+jkv("args", jarr([]string{jstr("start|stop|status"), jstr("--host"), jstr("--port")}))+","+jkv("summary", jstr("manage the background daemon — idempotent, health-probed"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("guide"))+","+jkv("args", jarr([]string{jstr("--human")}))+","+jkv("summary", jstr("the full operator manual"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("feedback"))+","+jkv("args", jarr([]string{jstr("<message>"), jstr("--kind"), jstr("--context")}))+","+jkv("summary", jstr("send feedback to the central relay — best-effort, never fails"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("update"))+","+jkv("args", jarr([]string{jstr("--check"), jstr("--force")}))+","+jkv("summary", jstr("content-hash self-update from the published binary"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("install"))+","+jkv("args", jarr([]string{jstr("--prefix")}))+","+jkv("summary", jstr("copy this binary onto PATH (default ~/.local/bin)"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("uninstall"))+","+jkv("args", jarr([]string{jstr("--prefix")}))+","+jkv("summary", jstr("remove the installed binary — no-op if absent"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("telemetry"))+","+jkv("args", jarr([]string{jstr("--off")}))+","+jkv("summary", jstr("print the exact anonymous-usage payload and on/off state"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("version"))+","+jkv("args", jarr([]string{}))+","+jkv("summary", jstr("version string"))+"}")
	xc := []string{}
	xc = append(xc, jkv("0", jstr("success")))
	xc = append(xc, jkv("3", jstr("daemon status: daemon is stopped")))
	xc = append(xc, jkv("5", jstr("update --check: update available")))
	xc = append(xc, jkv("80", jstr("usage error: bad/missing arguments")))
	xc = append(xc, jkv("81", jstr("no_a11y: cannot reach the AT-SPI bus")))
	xc = append(xc, jkv("82", jstr("app_not_found")))
	xc = append(xc, jkv("83", jstr("ref_stale: UI changed, re-run state")))
	xc = append(xc, jkv("84", jstr("ref_not_found")))
	xc = append(xc, jkv("85", jstr("no_capability (no accessible action, password field, no X display path)")))
	xc = append(xc, jkv("86", jstr("action_failed: the toolkit refused")))
	xc = append(xc, jkv("87", jstr("no_display: cannot open the X display")))
	xc = append(xc, jkv("89", jstr("refused (safety refusal)")))
	xc = append(xc, jkv("90", jstr("rss_limit (watch --max-rss) or permission denied")))
	xc = append(xc, jkv("91", jstr("no_injector: no usable input backend (e.g. Wayland) — use act")))
	xc = append(xc, jkv("100", jstr("external/integration: download, daemon start, network")))
	xc = append(xc, jkv("110", jstr("internal: daemon stop did not complete")))
	envs := []string{}
	envs = append(envs, jstr("LINUX_USE_HOST"))
	envs = append(envs, jstr("LINUX_USE_PORT"))
	envs = append(envs, jstr("LINUX_USE_INJECTOR"))
	envs = append(envs, jstr("LINUX_USE_SERVER"))
	envs = append(envs, jstr("LINUX_USE_NO_NUDGE"))
	envs = append(envs, jstr("LINUX_USE_TELEMETRY"))
	envs = append(envs, jstr("LINUX_USE_TELEMETRY_URL"))
	envs = append(envs, jstr("FEEDBACK_RELAY"))
	envs = append(envs, jstr("DO_NOT_TRACK"))
	envs = append(envs, jstr("DISPLAY"))
	envs = append(envs, jstr("USER"))
	r = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("tool", jstr("linux-use")) + "," + jkv("version", jstr(VERSION)) + "," + jkv("output", jstr("json")) + "," + jkv("commands", jarr(cmds)) + "," + jkv("exit_codes", "{" + join(xc, ",") + "}") + "," + jkv("env", jarr(envs)) + "," + jkv("see_also", jarr([]string{jstr("linux-use guide"), jstr("linux-use guide --human")})) + "}"
}

// ---------------------------------------------------------------- daemon

var srv_port = 7777
var shutdown_token = ""

func state_dir() (d) {
	home := env("HOME")
	if len(home) == 0 {
		home = "/tmp"
	}
	d = home + "/.linux-use"
	mkdir(d)
}

func health_json() (r) {
	napps := 0
	if desktop != 0 {
		napps = atspi_accessible_get_child_count(desktop, 0)
	}
	r = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("service", jstr("linux-use")) + "," + jkv("pid", str(getpid())) + "," + jkv("tool", jstr("linux-use")) + "," + jkv("version", jstr(VERSION)) + "," + jkv("warm", jbool(desktop != 0)) + "," + jkv("applications", str(napps)) + "," + jkv("port", str(srv_port)) + "}"
}

func delayed_exit() {
	sleep(80)
	exit(0)
}

func llms_txt() (r) {
	ls := []string{}
	ls = append(ls, "# linux-use — agent-first GUI control for Linux desktops")
	ls = append(ls, "Reads the AT-SPI2 accessibility tree and acts on named widgets; no screenshots, no pixel coordinates, no LLM inside — the agent is the loop.")
	ls = append(ls, "")
	ls = append(ls, "GET /guide for the full operator manual (JSON). With the binary:")
	ls = append(ls, "  linux-use guide")
	ls = append(ls, "")
	ls = append(ls, "Quick start: linux-use apps -> linux-use state --app <name> -> linux-use act <ref> -> re-run state to verify.")
	ls = append(ls, "Drive it over HTTP here: GET /v1/<command>/<arg>/... (e.g. /v1/state/--app/gedit).")
	r = join(ls, "\n")
}

func lu_route(req) (res) {
	if req.path == "/_health" {
		res = ok_json(health_json())
		return
	}
	if req.path == "/guide" {
		res = ok_json(guide_json())
		return
	}
	if req.path == "/llms.txt" {
		res = response("200 OK", "text/plain; charset=utf-8", llms_txt())
		return
	}
	if req.path == "/_shutdown" {
		if req.method != "POST" {
			res = response("405 Method Not Allowed", "application/json", errjson(EX_USAGE, "method_not_allowed", "POST required", true, []string{"use POST /_shutdown"}))
			return
		}
		if len(shutdown_token) > 0 {
			auth := header(req, "authorization")
			if auth != "Bearer " + shutdown_token {
				res = response("403 Forbidden", "application/json", errjson(EX_REFUSED, "forbidden", "POST /_shutdown requires a bearer token on a non-loopback bind", false, []string{"the token is in ~/.linux-use/shutdown.token on this machine"}))
				return
			}
		}
		write(2, "linux-use: shutdown requested\n")
		res = ok_json("{" + jkv("ok", "true") + "," + jkv("stopping", "true") + "}")
		go delayed_exit()
		return
	}
	if has_prefix(req.path, "/v1/") {
		rest := param(req.path, "/v1/")
		argv := []string{"linux-use"}
		parts := split(rest, "/")
		i := 0
		while i < len(parts) {
			if len(parts[i]) > 0 {
				argv = append(argv, replace(parts[i], "%20", " "))
			}
			i = i + 1
		}
		out, code := run_cmd(argv)
		if code == EX_OK {
			res = ok_json(out)
		} else {
			res = response("400 Bad Request", "application/json", out)
		}
		return
	}
	res = response("404 Not Found", "application/json", errjson(EX_EXT, "not_found", "no such endpoint", true, []string{"GET /_health", "POST /_shutdown", "GET /guide", "GET /v1/<command>/<arg>/..."}))
}

func is_loopback(host) (b) {
	b = host == "127.0.0.1" || host == "localhost" || host == "::1"
}

func cmd_serve(host, port) (out, code) {
	code = EX_OK
	out = ""
	srv_port = port
	if !a11y_up() {
		write(2, "linux-use: WARNING starting without an AT-SPI connection\n")
	}
	if !is_loopback(host) {
		shutdown_token = to_hex(rand_bytes(16))
		tf := state_dir() + "/shutdown.token"
		write_file(tf, shutdown_token)
		system("chmod 600 " + tf)
		write(2, "[serve] non-loopback bind — /_shutdown requires the bearer token in " + tf + "\n")
	}
	write(2, "[serve] listening on http://" + host + ":" + str(port) + "\n")
	flush()
	// a long-running server sends at most one run event, at startup — never
	// per-request (cli-telemetry-spec §4.4).
	tel_send("run", "serve", 0)
	serve_on_quiet(host, port, func(req) { return lu_route(req) })
}

func dial_host(host) (h) {
	h = host
	if host == "0.0.0.0" || host == "::" {
		h = "127.0.0.1"
	}
}

func daemon_health(host, port) (up, body) {
	st, b, e := http_get("http://" + dial_host(host) + ":" + str(port) + "/_health")
	up = st == 200 && len(e) == 0
	body = b
}

func cmd_daemon(sub, host, port) (out, code) {
	code = EX_OK
	if sub == "status" {
		up, _ := daemon_health(host, port)
		if up {
			out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("daemon", jstr("running")) + "," + jkv("host", jstr(host)) + "," + jkv("port", str(port)) + "}"
			return
		}
		out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("daemon", jstr("stopped")) + "}"
		code = 3
		return
	}
	if sub == "start" {
		up, _ := daemon_health(host, port)
		if up {
			out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("daemon", jstr("already_running")) + "," + jkv("host", jstr(host)) + "," + jkv("port", str(port)) + "}"
			return
		}
		self := args()[0]
		logpath := "/tmp/linux-use-daemon.log"
		system("setsid " + self + " serve --host " + host + " --port " + str(port) + " >>" + logpath + " 2>&1 < /dev/null &")
		waited := 0
		while waited < 5000 {
			sleep(100)
			waited = waited + 100
			u2, _ := daemon_health(host, port)
			if u2 {
				out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("daemon", jstr("started")) + "," + jkv("host", jstr(host)) + "," + jkv("port", str(port)) + "," + jkv("log", jstr(logpath)) + "}"
				return
			}
		}
		code = EX_EXT
		out = errjson(EX_EXT, "daemon_start_failed", "daemon did not become healthy within 5s (see " + logpath + ")", true, []string{"cat " + logpath, "try: linux-use serve --host " + host + " --port " + str(port) + " (foreground)"})
		return
	}
	if sub == "stop" {
		up, _ := daemon_health(host, port)
		if !up {
			out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("daemon", jstr("already_stopped")) + "}"
			return
		}
		hdrs := []string{}
		tok := trim(read_file(state_dir() + "/shutdown.token"))
		if len(tok) > 0 {
			hdrs = append(hdrs, "Authorization: Bearer " + tok)
		}
		_, _, _ = http_request("POST", "http://" + dial_host(host) + ":" + str(port) + "/_shutdown", hdrs, "")
		waited := 0
		while waited < 5000 {
			sleep(100)
			waited = waited + 100
			u2, _ := daemon_health(host, port)
			if !u2 {
				out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("daemon", jstr("stopped")) + "}"
				return
			}
		}
		code = EX_INTERNAL
		out = errjson(EX_INTERNAL, "daemon_stop_failed", "daemon still responding after its shutdown grace period", true, []string{"kill it manually: pkill -f 'linux-use serve'"})
		return
	}
	code = EX_USAGE
	out = errjson(EX_USAGE, "bad_subcommand", "daemon takes start|stop|status", true, []string{"linux-use daemon status"})
}

// ---------------------------------------------------------------- feedback (cli-feedback-spec)
// Relay-only adoption: linux-use has no hosted feedback endpoint of its own,
// so the submission goes straight to the central relay. Never fails the caller.

func cmd_feedback(msg, kind, ctx) (out, code) {
	code = EX_OK
	if len(trim(msg)) == 0 {
		code = EX_USAGE
		out = errjson(EX_USAGE, "missing_message", "feedback needs a message", true, []string{"example: linux-use feedback \"the ref went stale too fast\""})
		return
	}
	id := to_hex(rand_bytes(8))
	reporter := env("USER")
	if len(reporter) == 0 {
		reporter = "agent"
	}
	body := "{" + jkv("message", jstr(msg)) + "," + jkv("app", jstr("linux-use")) + "," + jkv("version", jstr(VERSION)) + "," + jkv("kind", jstr(kind)) + "," + jkv("context", jstr(ctx)) + "," + jkv("reporter", jstr(reporter)) + "," + jkv("id", jstr(id)) + "}"
	relayed := 0
	relay := env("FEEDBACK_RELAY")
	if len(relay) == 0 {
		relay = "https://feedback.intrane.fr"
	}
	if relay != "off" {
		resp := https_post(relay + "/v1/feedback", body)
		rk, rerr := json_get(resp, ".ok")
		if len(rerr) == 0 && strip_quotes(rk) == "true" {
			relayed = 1
		}
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("data", "{" + jkv("id", jstr(id)) + "," + jkv("stored", "0") + "," + jkv("relayed", str(relayed)) + "}") + "}"
}

// ---------------------------------------------------------------- telemetry (cli-telemetry-spec)
// Anonymous, allow-listed usage counts. Off-switches are checked before any
// network code; sends are detached and silent. `linux-use telemetry` prints
// the real next payload.

var telemetry_endpoint = "https://grange.intrane.fr/t"
var current_verb = ""

func tel_enabled() (ok) {
	ok = false
	if env("DO_NOT_TRACK") == "1" {
		return
	}
	t := env("LINUX_USE_TELEMETRY")
	if t == "0" || t == "false" || t == "off" || t == "no" {
		return
	}
	k, _, _ := stat(state_dir() + "/telemetry-off")
	if k == 1 {
		return
	}
	if len(env("CI")) > 0 || len(env("CONTINUOUS_INTEGRATION")) > 0 || len(env("GITHUB_ACTIONS")) > 0 || len(env("GITLAB_CI")) > 0 || len(env("BUILDKITE")) > 0 {
		return
	}
	ok = true
}

func tel_notice() {
	nf := state_dir() + "/telemetry-notice-shown"
	k, _, _ := stat(nf)
	if k == 1 {
		return
	}
	write(2, "[telemetry] linux-use sends anonymous usage counts: tool, version,\n")
	write(2, "[telemetry] os/arch, which verb ran, and whether it failed. No identity,\n")
	write(2, "[telemetry] arguments or data. See `linux-use telemetry` for the exact payload.\n")
	write(2, "[telemetry] Disable: LINUX_USE_TELEMETRY=0 (or DO_NOT_TRACK=1)\n")
	write_file(nf, "1")
}

func tel_payload(event, verb, exit_class) (p) {
	_, osr, _ := exec("uname -s")
	_, arr, _ := exec("uname -m")
	p = "{" + jkv("tool", jstr("linux-use")) + "," + jkv("version", jstr(VERSION)) + "," + jkv("event", jstr(event)) + "," + jkv("verb", jstr(verb)) + "," + jkv("os", jstr(to_lower(trim(osr)))) + "," + jkv("arch", jstr(trim(arr))) + "," + jkv("exit_class", str(exit_class)) + "," + jkv("ts", jstr(time_format_utc(now(), "%Y-%m-%dT%H:%M:%SZ"))) + "}"
}

func tel_send(event, verb, exit_class) {
	if !tel_enabled() {
		return
	}
	tel_notice()
	ik, _, _ := stat(state_dir() + "/telemetry-install-sent")
	actual := event
	if ik != 1 {
		actual = "install"
		write_file(state_dir() + "/telemetry-install-sent", "1")
	}
	tmp := "/tmp/linux-use-tel-" + to_hex(rand_bytes(4)) + ".json"
	write_file(tmp, tel_payload(actual, verb, exit_class))
	ep := env("LINUX_USE_TELEMETRY_URL")
	if len(ep) == 0 {
		ep = telemetry_endpoint
	}
	system("(curl -s -m 2 -X POST " + ep + " -H 'content-type: application/json' --data-binary @" + tmp + " >/dev/null 2>&1; rm -f " + tmp + ") >/dev/null 2>&1 &")
}

func tel_exit_class(code) (c) {
	c = 0
	if code >= 80 && code < 90 {
		c = 80
	}
	if code >= 90 && code < 100 {
		c = 90
	}
	if code >= 100 && code < 110 {
		c = 100
	}
	if code >= 110 {
		c = 110
	}
}

func tel_finish(code) {
	if !tel_enabled() {
		return
	}
	if code == 0 || code == 3 || code == 5 {
		tel_send("run", current_verb, tel_exit_class(code))
		return
	}
	tel_send("error", current_verb, tel_exit_class(code))
}

func tel_why_disabled() (r) {
	if env("DO_NOT_TRACK") == "1" {
		r = "DO_NOT_TRACK=1"
		return
	}
	t := env("LINUX_USE_TELEMETRY")
	if t == "0" || t == "false" || t == "off" || t == "no" {
		r = "LINUX_USE_TELEMETRY=" + t
		return
	}
	k, _, _ := stat(state_dir() + "/telemetry-off")
	if k == 1 {
		r = "disabled by config (linux-use telemetry --off)"
		return
	}
	if len(env("CI")) > 0 || len(env("CONTINUOUS_INTEGRATION")) > 0 || len(env("GITHUB_ACTIONS")) > 0 || len(env("GITLAB_CI")) > 0 || len(env("BUILDKITE")) > 0 {
		r = "CI detected"
		return
	}
	r = "unknown"
}

func cmd_telemetry(off) (out, code) {
	code = EX_OK
	if off {
		write_file(state_dir() + "/telemetry-off", "1")
		out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("data", "{" + jkv("enabled", "false") + "," + jkv("reason", jstr("disabled by config")) + "}") + "}"
		return
	}
	en := tel_enabled()
	ep := env("LINUX_USE_TELEMETRY_URL")
	if len(ep) == 0 {
		ep = telemetry_endpoint
	}
	nk, _, _ := stat(state_dir() + "/telemetry-notice-shown")
	reason := "enabled"
	ens := "true"
	if !en {
		reason = tel_why_disabled()
		ens = "false"
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("data", "{" + jkv("enabled", ens) + "," + jkv("reason", jstr(reason)) + "," + jkv("endpoint", jstr(ep)) + "," + jkv("next_payload", tel_payload("run", "telemetry", 0)) + "," + jkv("disable", jstr("LINUX_USE_TELEMETRY=0")) + "," + jkv("notice_shown", jbool(nk == 1)) + "}") + "}"
}

// ---------------------------------------------------------------- update (cli-update-spec)
// Content-hash self-update: the server is the GitHub Pages docs site serving
// version.json ({ok,version,download,sha256}); the artifact lives on GitHub
// Releases. verify sha256[:12] -> smoke test -> atomic swap with .bak.

var update_server = "https://javimosch.github.io/linux-use"

func bin_self() (p) {
	// Ask the kernel which binary is running. args()[0] is only what the user
	// typed: for a PATH lookup it is a bare name, which readlink would resolve
	// against the CURRENT DIRECTORY and so point update/install at another file.
	_, abs, _ := exec("readlink /proc/" + str(getpid()) + "/exe")
	p = trim(abs)
	if len(p) == 0 {
		p = args()[0]
	}
}

func dirname(p) (d) {
	d = "."
	i := len(p) - 1
	while i >= 0 {
		if substr(p, i, i+1) == "/" {
			break
		}
		i = i - 1
	}
	if i < 0 {
		d = "."
		return
	}
	if i == 0 {
		d = "/"
		return
	}
	d = substr(p, 0, i)
}

func local_version(bin) (v) {
	vf := dirname(bin) + "/VERSION"
	_, vs, _ := stat(vf)
	if vs > 0 {
		v = trim(read_file(vf))
		if len(v) > 0 {
			return
		}
	}
	b := read_file_bytes(bin)
	if len(b) == 0 {
		v = ""
		return
	}
	v = substr(to_hex(sha256_bytes(b)), 0, 12)
}

func strip_quotes(s) (r) {
	r = s
	if len(s) >= 2 && substr(s, 0, 1) == "\"" && substr(s, len(s)-1, len(s)) == "\"" {
		r = substr(s, 1, len(s)-1)
	}
}

func update_base() (b) {
	b = env("LINUX_USE_SERVER")
	if len(b) == 0 {
		b = update_server
	}
}

func cmd_update(check, force) (out, code) {
	code = EX_OK
	bin := bin_self()
	lv := local_version(bin)
	status, body, e := http_get(update_base() + "/version.json")
	if len(e) > 0 || status != 200 {
		code = EX_EXT
		out = errjson(EX_EXT, "update_unreachable", "cannot fetch " + update_base() + "/version.json (status=" + str(status) + " err=" + e + ")", true, []string{"check network connectivity", "check: curl -sI " + update_base() + "/version.json"})
		return
	}
	rv, verr := json_get(body, ".version")
	dl, derr := json_get(body, ".download")
	fs2, _ := json_get(body, ".sha256")
	if len(verr) > 0 || len(derr) > 0 {
		code = EX_EXT
		out = errjson(EX_EXT, "version_parse_failed", "version.json is missing .version or .download", true, []string{"report it: linux-use feedback \"version.json broken\""})
		return
	}
	rv = strip_quotes(rv)
	dl = strip_quotes(dl)
	fs2 = strip_quotes(fs2)
	if lv == rv && !force {
		out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("updated", "false") + "," + jkv("version", jstr(rv)) + "," + jkv("up_to_date", "true") + "}"
		return
	}
	if check {
		out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("updated", "false") + "," + jkv("local", jstr(lv)) + "," + jkv("remote", jstr(rv)) + "," + jkv("up_to_date", "false") + "}"
		code = 5
		return
	}
	tmp := "/tmp/linux-use-update-" + to_hex(rand_bytes(4))
	mkdir(tmp)
	newbin := tmp + "/linux-use"
	durl := dl
	if has_prefix(durl, "/") {
		durl = update_base() + durl
	}
	write(2, "[update] downloading " + durl + "\n")
	dc, _, dle := exec("curl -sS -L -f -o " + newbin + " " + durl)
	if dc != 0 {
		code = EX_EXT
		out = errjson(EX_EXT, "download_failed", "download failed: " + trim(dle), true, []string{"check network connectivity", "retry: linux-use update"})
		return
	}
	nb := read_file_bytes(newbin)
	if len(nb) == 0 {
		code = EX_EXT
		out = errjson(EX_EXT, "download_empty", "downloaded artifact is empty", true, []string{"retry: linux-use update"})
		return
	}
	dh := to_hex(sha256_bytes(nb))
	if substr(dh, 0, 12) != rv || (len(fs2) > 0 && dh != fs2) {
		remove(newbin)
		code = EX_EXT
		out = errjson(EX_EXT, "verification_failed", "downloaded hash does not match the advertised version " + rv, true, []string{"a partial publish can cause this — retry: linux-use update"})
		return
	}
	system("chmod +x " + newbin)
	sc, so, _ := exec(newbin + " version")
	if sc != 0 {
		code = EX_EXT
		out = errjson(EX_EXT, "smoke_test_failed", "new binary failed the `version` smoke test", true, []string{"the download is self-consistent but broken — report it: linux-use feedback \"update smoke test failed\""})
		return
	}
	_ = so
	bak := bin + ".bak"
	system("mv " + bin + " " + bak + " 2>/dev/null")
	mc, _, mv_err := exec("mv " + newbin + " " + bin)
	if mc != 0 {
		system("mv " + bak + " " + bin + " 2>/dev/null")
		code = EX_EXT
		out = errjson(EX_EXT, "swap_failed", "cannot move the new binary into place: " + trim(mv_err), true, []string{"check filesystem permissions on " + bin})
		return
	}
	system("chmod +x " + bin)
	write_file(dirname(bin) + "/VERSION", rv)
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("updated", "true") + "," + jkv("from", jstr(lv)) + "," + jkv("to", jstr(rv)) + "," + jkv("bak", jstr(bak)) + "}"
}

// version_nudge (cli-update-spec §4): at most once/hour, stderr only, silent
// on failure, never auto-updates.
func version_nudge() {
	if env("LINUX_USE_NO_NUDGE") == "1" || env("DO_NOT_TRACK") == "1" {
		return
	}
	if len(env("CI")) > 0 || len(env("GITHUB_ACTIONS")) > 0 || len(env("GITLAB_CI")) > 0 || len(env("BUILDKITE")) > 0 {
		return
	}
	cf := state_dir() + "/version-cache"
	_, _, last := stat(cf)
	if last > 0 && now() - last < 3600 {
		return
	}
	write_file(cf, str(now()))
	nc, body, _ := exec("curl -sf -m 3 \"" + update_base() + "/version.json\"")
	if nc != 0 {
		return
	}
	rv, verr := json_get(body, ".version")
	if len(verr) > 0 {
		return
	}
	rv = strip_quotes(rv)
	lv := local_version(bin_self())
	if len(lv) > 0 && lv != rv {
		write(2, "[update] a newer linux-use is available (" + lv + " → " + rv + "). Run: linux-use update\n")
	}
}

// ---------------------------------------------------------------- install (cli-update-spec §6)

func cmd_install(prefix) (out, code) {
	code = EX_OK
	bin := bin_self()
	system("mkdir -p \"" + prefix + "\"")
	target := prefix + "/linux-use"
	cc, _, ce := exec("cp \"" + bin + "\" \"" + target + "\" && chmod +x \"" + target + "\"")
	if cc != 0 {
		code = EX_RSS_LIMIT
		out = errjson(EX_RSS_LIMIT, "permission_denied", "cannot write " + target + ": " + trim(ce), false, []string{"choose a writable prefix: linux-use install --prefix ~/bin"})
		return
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("installed", jstr(target)) + "}"
	pp := env("PATH")
	if index(pp, prefix) < 0 {
		write(2, "[install] note: " + prefix + " is not on PATH\n")
	}
}

func cmd_uninstall(prefix) (out, code) {
	code = EX_OK
	target := prefix + "/linux-use"
	k, _, _ := stat(target)
	if k != 1 {
		out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("removed", "false") + "," + jkv("path", jstr(target)) + "}"
		return
	}
	remove(target)
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("removed", "true") + "," + jkv("path", jstr(target)) + "}"
}

// ---------------------------------------------------------------- dispatch

func need_a11y() (out, code) {
	out = ""
	code = EX_OK
	if !a11y_up() {
		code = EX_NO_A11Y
		out = errjson(EX_NO_A11Y, "no_a11y", "cannot reach the AT-SPI accessibility bus", false, []string{"run: linux-use doctor", "enable it: gsettings set org.gnome.desktop.interface toolkit-accessibility true"})
	}
}

func run_cmd(argv) (out, code) {
	out = ""
	code = EX_OK
	if len(argv) < 2 {
		code = EX_USAGE
		out = errjson(EX_USAGE, "no_command", "no command given", true, []string{"run: linux-use guide", "or: linux-use help-json"})
		return
	}
	cmd := argv[1]
	rest := argv[1:len(argv)]

	fs := new_flags("linux-use")
	fs = flag_str(fs, "app", "a", "", "target application name")
	fs = flag_str(fs, "role", "r", "", "filter by accessible role")
	fs = flag_int(fs, "depth", "d", "64", "maximum tree depth")
	fs = flag_int(fs, "max-nodes", "", "20000", "node budget for a walk")
	fs = flag_int(fs, "max-events", "", "0", "stop after N events (0 = unlimited)")
	fs = flag_int(fs, "duration", "", "0", "stop after N ms (0 = unlimited)")
	fs = flag_int(fs, "max-rss", "", "0", "watch: exit 90 above this RSS in kB (0 = unlimited)")
	fs = flag_str(fs, "events", "e", "", "comma-separated AT-SPI event types")
	fs = flag_str(fs, "via", "", "", "sendtext mechanism: auto|clipboard|atspi")
	fs = flag_str(fs, "host", "", "", "serve/daemon bind host (default 127.0.0.1, env LINUX_USE_HOST)")
	fs = flag_int(fs, "port", "p", "0", "daemon port (default 7777, env LINUX_USE_PORT)")
	fs = flag_int(fs, "pid", "", "0", "disambiguate --app by process id")
	fs = flag_int(fs, "x", "", "-1", "pointer x")
	fs = flag_int(fs, "y", "", "-1", "pointer y")
	fs = flag_int(fs, "button", "b", "1", "mouse button")
	fs = flag_int(fs, "action", "", "0", "action index")
	fs = flag_int(fs, "timeout", "t", "8000", "timeout in ms")
	fs = flag_str(fs, "wait-for", "w", "", "app name to wait for after launch")
	fs = flag_bool(fs, "all", "", "include non-interactive nodes")
	fs = flag_bool(fs, "dry-run", "", "key: resolve the combo without sending it")
	fs = flag_bool(fs, "no-restore", "", "paste: do not restore the previous clipboard")
	fs = flag_bool(fs, "walk", "", "force the recursive tree walk")
	fs = flag_bool(fs, "collection", "", "force a server-side collection query")
	fs = flag_bool(fs, "replace", "", "replace existing text instead of inserting")
	fs = flag_bool(fs, "allow-password", "", "permit typing into a password field")
	fs = flag_bool(fs, "expand", "", "state/find: scroll through the app and merge realized nodes")
	fs = flag_int(fs, "expand-passes", "", "25", "expand: maximum scroll passes")
	fs = flag_int(fs, "expand-wait", "", "400", "expand: extra settle ms when a pass shows nothing new")
	fs = flag_int(fs, "last", "", "200", "stats: metrics window size")
	fs = flag_str(fs, "format", "", "json", "output format: json|lines")
	fs = flag_bool(fs, "human", "", "human-readable output (guide only)")
	fs = flag_str(fs, "kind", "", "note", "feedback kind: bug|idea|praise|note")
	fs = flag_str(fs, "context", "", "", "feedback: what you were doing")
	fs = flag_str(fs, "prefix", "", "", "install/uninstall target dir (default ~/.local/bin)")
	fs = flag_bool(fs, "check", "", "update: check only, exit 5 if stale")
	fs = flag_bool(fs, "force", "", "update: re-download even if current")
	fs = flag_bool(fs, "off", "", "telemetry: persist the opt-out")
	fs = flag_str(fs, "injector", "", "", "input backend: auto|xtest (env LINUX_USE_INJECTOR)")
	fs = parse_flags(fs, rest)
	pos := flag_args(fs)

	wantAll = flag_on(fs, "all")
	wantInjector = flag_get(fs, "injector")
	// Policy, from measurement: a collection query wins in proportion to how
	// SELECTIVE it is (9x with a --role filter on a big app; a wash when asking
	// for every interactive role, where per-match path reconstruction eats the
	// gain and some matches come back unpathable). So: collection when a role
	// filter narrows it, the walk otherwise. Either can be forced.
	// v0.4: with the climb memoized, a collection query is 2-5x faster than the
	// walk, so it is tried FIRST for every query. If any match comes back
	// without a provable ref, the query is re-run as a walk — a complete answer
	// beats a fast one. --collection keeps the fast result (with ref_ok:false
	// entries); --walk skips the query entirely.
	forceCollection = flag_on(fs, "collection")
	forceWalk = flag_on(fs, "walk") || flag_on(fs, "all")
	wantRole = flag_get(fs, "role")
	wantText = ""
	wantExpand = flag_on(fs, "expand")
	wantExpandMax = flag_int_val(fs, "expand-passes")
	wantExpandWait = flag_int_val(fs, "expand-wait")
	wantFormat = flag_get(fs, "format")
	depth := flag_int_val(fs, "depth")
	maxnodes := flag_int_val(fs, "max-nodes")
	wantPid = flag_int_val(fs, "pid")
	port := flag_int_val(fs, "port")
	if port <= 0 {
		ep := env("LINUX_USE_PORT")
		if len(ep) > 0 {
			port = parse_int(ep)
		}
	}
	if port <= 0 {
		port = 7777
	}
	host := flag_get(fs, "host")
	if len(host) == 0 {
		host = env("LINUX_USE_HOST")
	}
	if len(host) == 0 {
		host = "127.0.0.1"
	}

	if cmd == "guide" {
		if flag_on(fs, "human") {
			out = guide_human()
			return
		}
		out = guide_json()
		return
	}
	if cmd == "help-json" {
		out = helpjson()
		return
	}
	if cmd == "version" {
		out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("tool", jstr("linux-use")) + "," + jkv("version", jstr(VERSION)) + "}"
		return
	}
	if cmd == "roles" {
		e2, c2 := need_a11y()
		if c2 != EX_OK {
			out = e2
			code = c2
			return
		}
		out, code = cmd_roles()
		return
	}
	if cmd == "doctor" {
		out, code = cmd_doctor()
		return
	}
	if cmd == "serve" {
		out, code = cmd_serve(host, port)
		return
	}
	if cmd == "daemon" {
		sub := "status"
		if len(pos) > 0 {
			sub = pos[0]
		}
		out, code = cmd_daemon(sub, host, port)
		return
	}
	if cmd == "feedback" {
		msg := ""
		if len(pos) > 0 {
			msg = pos[0]
		}
		out, code = cmd_feedback(msg, flag_get(fs, "kind"), flag_get(fs, "context"))
		return
	}
	if cmd == "telemetry" {
		out, code = cmd_telemetry(flag_on(fs, "off"))
		return
	}
	if cmd == "update" {
		out, code = cmd_update(flag_on(fs, "check"), flag_on(fs, "force"))
		return
	}
	if cmd == "install" || cmd == "uninstall" {
		prefix := flag_get(fs, "prefix")
		if len(prefix) == 0 {
			prefix = env("HOME") + "/.local/bin"
		}
		if cmd == "install" {
			out, code = cmd_install(prefix)
		} else {
			out, code = cmd_uninstall(prefix)
		}
		return
	}
	if cmd == "pointer" {
		out, code = cmd_pointer()
		return
	}
	if cmd == "sendtext" {
		e2, c2 := need_a11y()
		if c2 != EX_OK {
			out = e2
			code = c2
			return
		}
		t := ""
		if len(pos) > 0 {
			t = pos[0]
		}
		out, code = cmd_sendtext(t, flag_get(fs, "via"))
		return
	}
	if cmd == "paste" {
		t := ""
		if len(pos) > 0 {
			t = pos[0]
		}
		out, code = cmd_paste(t, !flag_on(fs, "no-restore"))
		return
	}
	if cmd == "key" {
		if len(pos) < 1 {
			code = EX_USAGE
			out = errjson(EX_USAGE, "missing_arg", "key needs a combo", true, []string{"example: linux-use key ctrl+shift+t"})
			return
		}
		out, code = cmd_key(pos[0], flag_on(fs, "dry-run"))
		return
	}

	// everything below needs the accessibility bus
	e, c := need_a11y()
	if c != EX_OK {
		out = e
		code = c
		return
	}

	if cmd == "apps" {
		out, code = cmd_apps()
		return
	}
	if cmd == "windows" {
		out, code = cmd_windows(flag_get(fs, "app"))
		return
	}
	if cmd == "state" {
		appname := flag_get(fs, "app")
		if len(appname) == 0 && len(pos) > 0 {
			appname = pos[0]
		}
		if len(appname) == 0 {
			code = EX_USAGE
			out = errjson(EX_USAGE, "missing_app", "state needs --app <name>", true, []string{"run: linux-use apps"})
			return
		}
		if wantFormat != "json" && wantFormat != "lines" {
			code = EX_USAGE
			out = errjson(EX_USAGE, "bad_format", "--format must be 'json' or 'lines'", true, []string{"example: linux-use state --app gnome-calculator --format lines"})
			return
		}
		if flag_get(fs, "via") == "cdp" {
			out, code = cmd_state_cdp(appname)
			return
		}
		out, code = cmd_state(appname, depth, maxnodes)
		return
	}
	if cmd == "watch" {
		out, code = cmd_watch(flag_get(fs, "app"), flag_get(fs, "role"), flag_get(fs, "events"), flag_int_val(fs, "max-events"), flag_int_val(fs, "duration"), flag_int_val(fs, "max-rss"))
		return
	}
	if cmd == "find" {
		if len(pos) < 1 {
			code = EX_USAGE
			out = errjson(EX_USAGE, "missing_query", "find needs a query string", true, []string{"example: linux-use find Save --app gedit"})
			return
		}
		if wantFormat != "json" && wantFormat != "lines" {
			code = EX_USAGE
			out = errjson(EX_USAGE, "bad_format", "--format must be 'json' or 'lines'", true, []string{"example: linux-use find Save --format lines"})
			return
		}
		out, code = cmd_find(pos[0], flag_get(fs, "app"), depth, maxnodes)
		return
	}
	if cmd == "stats" {
		out, code = cmd_stats(flag_int_val(fs, "last"))
		return
	}
	if cmd == "act" {
		if len(pos) < 1 {
			code = EX_USAGE
			out = errjson(EX_USAGE, "missing_ref", "act needs a ref", true, []string{"get one from: linux-use state --app <app>"})
			return
		}
		out, code = cmd_act(pos[0], flag_get(fs, "action"))
		return
	}
	if cmd == "read" {
		if len(pos) < 1 {
			code = EX_USAGE
			out = errjson(EX_USAGE, "missing_ref", "read needs a ref", true, []string{"get one from: linux-use state --app <app>"})
			return
		}
		out, code = cmd_read(pos[0])
		return
	}
	if cmd == "type" {
		if len(pos) < 2 {
			code = EX_USAGE
			out = errjson(EX_USAGE, "missing_arg", "type needs <ref> <text>", true, []string{"example: linux-use type 'gedit:/0/1#123' hello"})
			return
		}
		out, code = cmd_type(pos[0], pos[1], flag_on(fs, "replace"), flag_on(fs, "allow-password"))
		return
	}
	if cmd == "click" {
		ref := ""
		if len(pos) > 0 {
			ref = pos[0]
		}
		px := flag_int_val(fs, "x")
		py := flag_int_val(fs, "y")
		if len(ref) == 0 && (px < 0 || py < 0) {
			code = EX_USAGE
			out = errjson(EX_USAGE, "missing_target", "click needs a <ref> or --x/--y", true, []string{"example: linux-use click --x 100 --y 200"})
			return
		}
		out, code = cmd_click(ref, px, py, flag_int_val(fs, "button"))
		return
	}
	if cmd == "launch" {
		if len(pos) < 1 {
			code = EX_USAGE
			out = errjson(EX_USAGE, "missing_command", "launch needs a command", true, []string{"example: linux-use launch gnome-calculator --wait-for gnome-calculator"})
			return
		}
		out, code = cmd_launch(pos[0], flag_get(fs, "wait-for"), flag_int_val(fs, "timeout"))
		return
	}

	code = EX_USAGE
	out = errjson(EX_USAGE, "unknown_command", "no such command '"+cmd+"'", true, []string{"run: linux-use help-json"})
}

func nudge_ok(cmd) (b) {
	b = cmd == "apps" || cmd == "windows" || cmd == "state" || cmd == "find" || cmd == "stats" || cmd == "doctor" || cmd == "roles"
}

func main() {
	argv := args()
	current_verb = "none"
	if len(argv) > 1 {
		current_verb = argv[1]
	}
	out, code := run_cmd(argv)
	if len(out) > 0 {
		println(out)
	}
	if nudge_ok(current_verb) {
		version_nudge()
	}
	tel_finish(code)
	exit(code)
}
