// linux-use — agent-first GUI control for Linux desktops.
//
// Perception: AT-SPI2 accessibility tree. Actuation: AT-SPI actions first,
// XTEST synthetic input as fallback. No LLM inside — the agent is the loop.
//
// Composed with framework/machweb.src + framework/flags.src by build.sh.

extern "atspi" {
	cflags "-I/usr/include/at-spi-2.0 -I/usr/include/dbus-1.0 -I/usr/lib/x86_64-linux-gnu/dbus-1.0/include -I/usr/include/glib-2.0 -I/usr/lib/x86_64-linux-gnu/glib-2.0/include"
	link "atspi"
	header "atspi/atspi.h"
	fn atspi_init() i32
	fn atspi_exit() i32
	fn atspi_get_desktop(i32) ptr
	fn atspi_accessible_get_child_count(ptr, ptr) i32
	fn atspi_accessible_get_child_at_index(ptr, i32, ptr) ptr
	fn atspi_accessible_get_name(ptr, ptr) ptr
	fn atspi_accessible_get_role_name(ptr, ptr) ptr
	fn atspi_accessible_get_description(ptr, ptr) ptr
	fn atspi_accessible_get_state_set(ptr) ptr
	fn atspi_state_set_contains(ptr, i32) bool
	fn atspi_accessible_get_component_iface(ptr) ptr
	fn atspi_component_get_extents(ptr, i32, ptr) ptr
	fn atspi_component_grab_focus(ptr, ptr) bool
	fn atspi_accessible_get_action_iface(ptr) ptr
	fn atspi_action_get_n_actions(ptr, ptr) i32
	fn atspi_action_get_action_name(ptr, i32, ptr) ptr
	fn atspi_action_do_action(ptr, i32, ptr) bool
	fn atspi_accessible_get_text_iface(ptr) ptr
	fn atspi_text_get_character_count(ptr, ptr) i32
	fn atspi_text_get_text(ptr, i32, i32, ptr) ptr
	fn atspi_text_get_caret_offset(ptr, ptr) i32
	fn atspi_accessible_get_editable_text_iface(ptr) ptr
	fn atspi_editable_text_set_text_contents(ptr, string, ptr) bool
	fn atspi_editable_text_insert_text(ptr, i32, string, i32, ptr) bool
	fn atspi_generate_keyboard_event(i64, string, i32, ptr) bool
	fn atspi_accessible_get_parent(ptr, ptr) ptr
	fn atspi_accessible_get_index_in_parent(ptr, ptr) i32
	fn atspi_accessible_get_id(ptr, ptr) i32
	fn atspi_accessible_get_process_id(ptr, ptr) u32
	fn atspi_accessible_get_toolkit_name(ptr, ptr) ptr
	fn atspi_role_get_name(i32) ptr
	fn atspi_event_listener_new(cb(ptr, ptr), ptr, ptr) ptr
	fn atspi_event_listener_register(ptr, string, ptr) bool
	fn atspi_event_main()
	fn atspi_event_quit()
}

extern "glib" {
	cflags "-I/usr/include/glib-2.0 -I/usr/lib/x86_64-linux-gnu/glib-2.0/include"
	link "gobject-2.0" link "glib-2.0"
	header "glib-object.h"
	fn g_object_ref(ptr) ptr
	fn g_object_unref(ptr)
	fn g_free(ptr)
	fn g_timeout_add(u32, cb(ptr) bool, ptr) u32
}

extern "lu" {
	cflags "-I. -I/usr/include/at-spi-2.0 -I/usr/include/dbus-1.0 -I/usr/lib/x86_64-linux-gnu/dbus-1.0/include -I/usr/include/glib-2.0 -I/usr/lib/x86_64-linux-gnu/glib-2.0/include"
	header "lu_helpers.h"
	fn lu_cstr(ptr) string
	fn lu_ev_type(ptr) string
	fn lu_ev_source(ptr) ptr
	fn lu_ev_detail1(ptr) i32
	fn lu_ev_detail2(ptr) i32
	fn lu_roles_new() ptr
	fn lu_roles_add(ptr, i32)
	fn lu_role_from_name(string) i32
	fn lu_rule_new(ptr, i32) ptr
	fn lu_matches(ptr, ptr, i32) ptr
	fn lu_arr_len(ptr) i32
	fn lu_arr_get(ptr, i32) ptr
	fn lu_arr_free(ptr)
	fn lu_rule_free(ptr)
	fn lu_roles_free(ptr)
	fn lu_role_count() i32
	fn lu_rss_kb() i32
	fn lu_role_name_of(ptr) string
}

extern "x11" {
	link "X11" link "Xtst"
	header "X11/extensions/XTest.h"
	fn XOpenDisplay(string) ptr
	fn XCloseDisplay(ptr) i32
	fn XFlush(ptr) i32
	fn XSync(ptr, bool) i32
	fn XDefaultRootWindow(ptr) u64
	fn XQueryPointer(ptr, u64, ptr, ptr, ptr, ptr, ptr, ptr, ptr) bool
	fn XTestFakeMotionEvent(ptr, i32, i32, i32, u64) i32
	fn XTestFakeButtonEvent(ptr, u32, i32, u64) i32
	fn XTestFakeKeyEvent(ptr, u32, i32, u64) i32
	fn XStringToKeysym(string) u64
	fn XKeysymToKeycode(ptr, u64) u32
}

// ---------------------------------------------------------------- constants

// Exit codes (cli-output-spec: semantic, 80-119).
var EX_OK = 0
var EX_USAGE = 80
var EX_NO_A11Y = 81
var EX_APP_NOT_FOUND = 82
var EX_REF_STALE = 83
var EX_REF_NOT_FOUND = 84
var EX_NO_CAPABILITY = 85
var EX_ACTION_FAILED = 86
var EX_NO_DISPLAY = 87
var EX_DAEMON = 88
var EX_REFUSED = 89
var EX_RSS_LIMIT = 90

// AT-SPI enum ordinals (verified against atspi-constants.h on 2.44).
var ST_ACTIVE = 1
var ST_EDITABLE = 7
var ST_ENABLED = 8
var ST_FOCUSABLE = 11
var ST_FOCUSED = 12
var ST_SENSITIVE = 24
var ST_SHOWING = 25
var ST_VISIBLE = 30
var COORD_SCREEN = 0
var KEY_STRING = 4

var VERSION = "0.6.3"
var SCHEMA = "linux-use/v1"

// ---------------------------------------------------------------- json utils

func jesc(s) (r) {
	r = ""
	i := 0
	while i < len(s) {
		c := charat(s, i)
		if c == "\"" {
			r = r + "\\\""
		} else {
			if c == "\\" {
				r = r + "\\\\"
			} else {
				if c == "\n" {
					r = r + "\\n"
				} else {
					if c == "\t" {
						r = r + "\\t"
					} else {
						if c == "\r" {
							r = r + "\\r"
						} else {
							r = r + c
						}
					}
				}
			}
		}
		i = i + 1
	}
}

func jstr(s) (r) {
	r = "\"" + jesc(s) + "\""
}

func jkv(k, v) (r) {
	r = jstr(k) + ":" + v
}

func jarr(items) (r) {
	r = "[" + join(items, ",") + "]"
}

func jbool(b) (r) {
	r = "false"
	if b {
		r = "true"
	}
}

// ---------------------------------------------------------------- errors

// errjson builds the cli-output-spec error envelope.
func errjson(code, msg, recoverable, suggestions) (r) {
	sg := []string{}
	i := 0
	while i < len(suggestions) {
		sg = append(sg, jstr(suggestions[i]))
		i = i + 1
	}
	r = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "false") + "," + jkv("error", "{" + jkv("code", jstr(code)) + "," + jkv("message", jstr(msg)) + "," + jkv("recoverable", jbool(recoverable)) + "," + jkv("suggestions", jarr(sg)) + "}") + "}"
}

// ---------------------------------------------------------------- fingerprints

// fp is a stable-ish identity for a node: role + name, hashed. Element refs
// carry it so a stale ref is DETECTED rather than silently acting on the
// wrong widget.
func fp(role, name) (r) {
	b := bytes(role + "|" + name)
	h := 2166136261
	i := 0
	n := len(role) + 1 + len(name)
	while i < n {
		h = (h*131 + byte_at(b, i)) % 1000000007
		i = i + 1
	}
	r = str(h)
}

func mkref(app, path, role, name) (r) {
	r = app + ":" + path + "#" + fp(role, name)
}

// splitref returns (app, path, wantfp).
func splitref(ref) (app, path, want) {
	app = ""
	path = ""
	want = ""
	hp := split(ref, "#")
	left := hp[0]
	if len(hp) > 1 {
		want = hp[1]
	}
	parts := split(left, ":")
	if len(parts) < 2 {
		return
	}
	path = parts[len(parts)-1]
	app = join(parts[0:len(parts)-1], ":")
}

// ---- geometry refs -------------------------------------------------------
//
// Some toolkits break parent/child reciprocity: a node's get_parent() returns
// a container that does NOT list it among its children (observed in
// gnome-control-center/libadwaita, where a `filler` reports a parent panel
// with children=1 that does not contain it, and index_in_parent = -1). Such a
// node is reachable top-down but has no provable child-index path, so a
// path-shaped ref is impossible — not merely unknown.
//
// Those nodes get a GEOMETRY ref instead:
//     app:@<roleId>~<x>,<y>,<w>,<h>#<fingerprint>
// resolved by a collection query for that role, matched on exact extents and
// verified by the same role+name fingerprint. Ambiguity (two widgets with the
// same role at the same rectangle) is reported, never guessed.

func geomref(app, roleid, x, y, w, h, role, name) (r) {
	r = app + ":@" + str(roleid) + "~" + str(x) + "," + str(y) + "," + str(w) + "," + str(h) + "#" + fp(role, name)
}

func is_geom(path) (b) {
	b = has_prefix(path, "@")
}

// resolve_geom finds the unique showing node of the given role at exactly the
// given rectangle. Returns (node, count) — count != 1 means ambiguous/absent.
func resolve_geom(app, spec) (node, found) {
	node = 0
	found = 0
	body := substr(spec, 1, len(spec))
	parts := split(body, "~")
	if len(parts) < 2 {
		return
	}
	roleid := parse_int(parts[0])
	nums := split(parts[1], ",")
	if len(nums) < 4 {
		return
	}
	wx := parse_int(nums[0])
	wy := parse_int(nums[1])
	ww := parse_int(nums[2])
	wh := parse_int(nums[3])

	ra := lu_roles_new()
	lu_roles_add(ra, roleid)
	rule := lu_rule_new(ra, 1)
	nwin := atspi_accessible_get_child_count(app, 0)
	i := 0
	while i < nwin {
		win := atspi_accessible_get_child_at_index(app, i, 0)
		if win != 0 {
			arr := lu_matches(win, rule, 20000)
			if arr != 0 {
				cnt := lu_arr_len(arr)
				j := 0
				while j < cnt {
					c := lu_arr_get(arr, j)
					if c != 0 {
						x, y, w, h := extents(c)
						if x == wx && y == wy && w == ww && h == wh {
							found = found + 1
							if found == 1 {
								node = g_object_ref(c)
							}
						}
					}
					j = j + 1
				}
				lu_arr_free(arr)
			}
			g_object_unref(win)
		}
		i = i + 1
	}
	lu_rule_free(rule)
	lu_roles_free(ra)
	if found != 1 && node != 0 {
		g_object_unref(node)
		node = 0
	}
}

// ---------------------------------------------------------------- atspi core

var desktop = 0
var wantPid = 0
var appAmbiguous = 0

func a11y_up() (ok) {
	ok = false
	if desktop != 0 {
		ok = true
		return
	}
	rc := atspi_init()
	if rc < 0 {
		return
	}
	desktop = atspi_get_desktop(0)
	if desktop == 0 {
		return
	}
	ok = true
}

// takestr consumes a heap `gchar*` from AT-SPI: alias it, copy it into an
// owned MFL string, then free the original. A `string` returned across the FFI
// boundary ALIASES the C buffer rather than copying it, so the copy here is
// load-bearing — without it the value dangles the moment the pointer is freed.
// takestr_borrowed copies a C string the caller does NOT own (so no free).
func takestr_borrowed(v) (r) {
	r = bytes_str(bytes(v))
}

func takestr(p) (r) {
	r = ""
	if p == 0 {
		return
	}
	// bytes_str(bytes(...)) forces a MATERIALIZED copy. substr()/len() on an
	// FFI-aliased string are lazy enough that the g_free below would otherwise
	// leave the result reading freed memory (observed as silently TRUNCATED
	// strings, not a crash).
	r = bytes_str(bytes(lu_cstr(p)))
	g_free(p)
}

func nodename(node) (r) {
	r = takestr(atspi_accessible_get_name(node, 0))
}

func noderole(node) (r) {
	r = takestr(atspi_accessible_get_role_name(node, 0))
}

func hasstate(node, st) (b) {
	b = false
	ss := atspi_accessible_get_state_set(node)
	if ss != 0 {
		b = atspi_state_set_contains(ss, st)
		g_object_unref(ss)
	}
}

// app_matches reports whether an application satisfies a --app/--pid filter,
// honouring the "<name>#pid<PID>" form so windows/find filter the same way
// findapp resolves.
func app_matches(a, nm, filter) (b) {
	sel := filter
	pid := wantPid
	hp := split(filter, "#pid")
	if len(hp) == 2 {
		sel = hp[0]
		pid = parse_int(hp[1])
	}
	b = len(sel) == 0 || nm == sel
	if b && pid > 0 {
		b = atspi_accessible_get_process_id(a, 0) == pid
	}
}

// findapp resolves an application selector to a NEW ref (caller unrefs), or 0.
//
// The selector is either a plain accessible name, or "<name>#pid<PID>" to
// disambiguate when two processes publish the same name (two browser windows
// of different profiles both call themselves "Microsoft Edge"). `wantPid` set
// non-zero has the same effect and wins.
//
// A plain name matching MORE THAN ONE application is REFUSED (appAmbiguous is
// set and 0 returned) rather than silently resolving to whichever comes first
// in the desktop's child list — picking one at random is exactly the kind of
// confident wrong answer this tool refuses to give.
func findapp(want) (app) {
	app = 0
	appAmbiguous = 0
	sel := want
	pid := wantPid
	hp := split(want, "#pid")
	if len(hp) == 2 {
		sel = hp[0]
		pid = parse_int(hp[1])
	}
	matches := 0
	n := atspi_accessible_get_child_count(desktop, 0)
	i := 0
	while i < n {
		a := atspi_accessible_get_child_at_index(desktop, i, 0)
		if a != 0 {
			hit := nodename(a) == sel
			if hit && pid > 0 {
				hit = atspi_accessible_get_process_id(a, 0) == pid
			}
			if hit {
				matches = matches + 1
				if app == 0 {
					app = a
				} else {
					g_object_unref(a)
				}
			} else {
				g_object_unref(a)
			}
		}
		i = i + 1
	}
	if matches > 1 {
		appAmbiguous = matches
		g_object_unref(app)
		app = 0
	}
}

// resolve walks a slash path from app. Returns a NEW ref, or 0.
func resolve(app, path) (node) {
	node = app
	first := true
	segs := split(path, "/")
	i := 0
	while i < len(segs) {
		s := segs[i]
		if len(s) > 0 {
			c := atspi_accessible_get_child_at_index(node, parse_int(s), 0)
			if !first {
				g_object_unref(node)
			}
			first = false
			node = c
			if node == 0 {
				return
			}
		}
		i = i + 1
	}
	if first {
		// path was empty: hand back an owned ref to the app itself
		node = atspi_accessible_get_child_at_index(app, 0, 0)
	}
}

// extents returns (x, y, w, h); w<=0 means unknown.
func extents(node) (x, y, w, h) {
	x = 0
	y = 0
	w = 0
	h = 0
	comp := atspi_accessible_get_component_iface(node)
	if comp == 0 {
		return
	}
	r := atspi_component_get_extents(comp, COORD_SCREEN, 0)
	if r != 0 {
		x = peek_i32(r, 0)
		y = peek_i32(r, 4)
		w = peek_i32(r, 8)
		h = peek_i32(r, 12)
		free(r)
	}
	g_object_unref(comp)
}

func interactive(role) (b) {
	b = false
	rs := interactive_roles()
	i := 0
	while i < len(rs) {
		if rs[i] == role {
			b = true
			return
		}
		i = i + 1
	}
}

// interactive_roles is the default element filter, as role NAMES. The walk
// matches these by string; the collection query converts them to AtspiRole
// ordinals and lets the server do the matching.
func interactive_roles() (r) {
	r = []string{}
	r = append(r, "push button")
	r = append(r, "toggle button")
	r = append(r, "check box")
	r = append(r, "radio button")
	r = append(r, "menu item")
	r = append(r, "check menu item")
	r = append(r, "radio menu item")
	r = append(r, "entry")
	r = append(r, "text")
	r = append(r, "password text")
	r = append(r, "combo box")
	r = append(r, "link")
	r = append(r, "list item")
	r = append(r, "page tab")
	r = append(r, "slider")
	r = append(r, "menu")
	r = append(r, "table cell")
	r = append(r, "spin button")
}

// collect runs a server-side collection query and returns JSON rows. ok=false
// means the app exposes no Collection interface and the caller must fall back
// to walking. Unmatched roles are reported so a typo is not silent.
func collect(appname, app, rolefilter, maxnodes) (out, n, ok, unknown, unpathed) {
	out = []string{}
	n = 0
	ok = false
	unknown = ""
	unpathed = 0
	geomrefs = 0
	cacheOn = true
	pcache_reset()
	names := interactive_roles()
	if len(rolefilter) > 0 {
		names = []string{rolefilter}
	}
	ra := lu_roles_new()
	added := 0
	i := 0
	while i < len(names) {
		rid := lu_role_from_name(names[i])
		if rid >= 0 {
			lu_roles_add(ra, rid)
			added = added + 1
		} else {
			if len(unknown) == 0 {
				unknown = names[i]
			}
		}
		i = i + 1
	}
	if added == 0 {
		lu_roles_free(ra)
		return
	}
	rule := lu_rule_new(ra, 1)
	// The Collection interface does not traverse down from an APPLICATION
	// node — it is implemented per top-level window. Query each window.
	nwin := atspi_accessible_get_child_count(app, 0)
	w := 0
	while w < nwin {
		win := atspi_accessible_get_child_at_index(app, w, 0)
		if win != 0 {
			arr := lu_matches(win, rule, maxnodes)
			if arr != 0 {
				ok = true
				cnt := lu_arr_len(arr)
				i = 0
				while i < cnt {
					node := lu_arr_get(arr, i)
					if node != 0 {
						role := noderole(node)
						name := nodename(node)
						if len(wantText) == 0 || contains(to_lower(name), to_lower(wantText)) {
							x, y, wd, ht := extents(node)
							if wd > 0 && ht > 0 {
								// A match whose path cannot be rebuilt is still a
								// real element: emit it with ref_ok:false rather
								// than silently dropping it from the answer.
								path, an, pok := pathof(node)
								refok := pok && an == appname
								if !refok {
									// No provable path (broken parent/child
									// reciprocity). Addressable by geometry
									// instead of unusable.
									rid := lu_role_from_name(role)
									if rid >= 0 && wd > 0 && ht > 0 {
										geomrefs = geomrefs + 1
										out = append(out, nodegeomjson(appname, node, rid, x, y, wd, ht, role, name))
										n = n + 1
									} else {
										unpathed = unpathed + 1
										out = append(out, nodejson(appname, node, path, role, name, false))
										n = n + 1
									}
								} else {
									out = append(out, nodejson(appname, node, path, role, name, true))
									n = n + 1
								}
							}
						}
					}
					i = i + 1
				}
				lu_arr_free(arr)
			}
			g_object_unref(win)
		}
		w = w + 1
	}
	lu_rule_free(rule)
	lu_roles_free(ra)
}

// ---------------------------------------------------------------- tree walk

var rows = []string{}
var budget = 0
var visited = 0
var deepest = 0
var depthCut = false
var forceWalk = false
var forceCollection = false
var geomrefs = 0
var findMethod = "collection"
var wantAll = false
var wantRole = ""
var wantText = ""

func nodejson(appname, node, path, role, name, refok) (r) {
	x, y, w, h := extents(node)
	nacts := 0
	act0 := ""
	ai := atspi_accessible_get_action_iface(node)
	if ai != 0 {
		nacts = atspi_action_get_n_actions(ai, 0)
		if nacts > 0 {
			act0 = takestr(atspi_action_get_action_name(ai, 0, 0))
		}
		g_object_unref(ai)
	}
	fields := []string{}
	rf := ""
	if refok {
		rf = mkref(appname, path, role, name)
	}
	fields = append(fields, jkv("ref", jstr(rf)))
	fields = append(fields, jkv("ref_ok", jbool(refok)))
	fields = append(fields, jkv("ref_kind", jstr("path")))
	fields = append(fields, jkv("role", jstr(role)))
	fields = append(fields, jkv("name", jstr(name)))
	fields = append(fields, jkv("x", str(x)))
	fields = append(fields, jkv("y", str(y)))
	fields = append(fields, jkv("w", str(w)))
	fields = append(fields, jkv("h", str(h)))
	fields = append(fields, jkv("cx", str(x+w/2)))
	fields = append(fields, jkv("cy", str(y+h/2)))
	fields = append(fields, jkv("actions", str(nacts)))
	fields = append(fields, jkv("action", jstr(act0)))
	fields = append(fields, jkv("enabled", jbool(hasstate(node, ST_ENABLED))))
	fields = append(fields, jkv("focused", jbool(hasstate(node, ST_FOCUSED))))
	fields = append(fields, jkv("editable", jbool(hasstate(node, ST_EDITABLE))))
	r = "{" + join(fields, ",") + "}"
}

func nodegeomjson(appname, node, roleid, x, y, w, h, role, name) (r) {
	nacts := 0
	act0 := ""
	ai := atspi_accessible_get_action_iface(node)
	if ai != 0 {
		nacts = atspi_action_get_n_actions(ai, 0)
		if nacts > 0 {
			act0 = takestr(atspi_action_get_action_name(ai, 0, 0))
		}
		g_object_unref(ai)
	}
	f := []string{}
	f = append(f, jkv("ref", jstr(geomref(appname, roleid, x, y, w, h, role, name))))
	f = append(f, jkv("ref_ok", "true"))
	f = append(f, jkv("ref_kind", jstr("geometry")))
	f = append(f, jkv("role", jstr(role)))
	f = append(f, jkv("name", jstr(name)))
	f = append(f, jkv("x", str(x)))
	f = append(f, jkv("y", str(y)))
	f = append(f, jkv("w", str(w)))
	f = append(f, jkv("h", str(h)))
	f = append(f, jkv("cx", str(x+w/2)))
	f = append(f, jkv("cy", str(y+h/2)))
	f = append(f, jkv("actions", str(nacts)))
	f = append(f, jkv("action", jstr(act0)))
	f = append(f, jkv("enabled", jbool(hasstate(node, ST_ENABLED))))
	f = append(f, jkv("focused", jbool(hasstate(node, ST_FOCUSED))))
	f = append(f, jkv("editable", jbool(hasstate(node, ST_EDITABLE))))
	r = "{" + join(f, ",") + "}"
}

func keep(role, name) (b) {
	b = true
	if !wantAll {
		b = interactive(role)
	}
	if b && len(wantRole) > 0 {
		b = role == wantRole
	}
	if b && len(wantText) > 0 {
		b = contains(to_lower(name), to_lower(wantText))
	}
}

// walk consumes `node` (does NOT unref it — the caller owns it).
func walk(appname, node, path, depth, maxdepth) {
	if budget <= 0 {
		return
	}
	if depth > maxdepth {
		// A subtree was cut off by --depth. Silently returning a SHALLOW
		// answer is the dangerous failure (an agent concludes "no such
		// widget"), so record it and surface it in the envelope.
		depthCut = true
		return
	}
	budget = budget - 1
	visited = visited + 1
	if depth > deepest {
		deepest = depth
	}
	role := noderole(node)
	name := nodename(node)
	if keep(role, name) && hasstate(node, ST_SHOWING) {
		x, y, w, h := extents(node)
		if w > 0 && h > 0 {
			rows = append(rows, nodejson(appname, node, path, role, name, true))
		}
	}
	n := atspi_accessible_get_child_count(node, 0)
	i := 0
	while i < n {
		c := atspi_accessible_get_child_at_index(node, i, 0)
		if c != 0 {
			walk(appname, c, path+"/"+str(i), depth+1, maxdepth)
			g_object_unref(c)
		}
		i = i + 1
	}
}

// ---------------------------------------------------------------- commands

func cmd_apps() (out, code) {
	code = EX_OK
	items := []string{}
	names := []string{}
	dupes := []string{}
	n := atspi_accessible_get_child_count(desktop, 0)
	i := 0
	while i < n {
		a := atspi_accessible_get_child_at_index(desktop, i, 0)
		if a != 0 {
			nm := nodename(a)
			kids := atspi_accessible_get_child_count(a, 0)
			pid := atspi_accessible_get_process_id(a, 0)
			tk := takestr(atspi_accessible_get_toolkit_name(a, 0))
			// A name shared by two applications is ambiguous for --app, so say
			// so rather than letting the caller silently address the wrong one.
			j := 0
			while j < len(names) {
				if names[j] == nm {
					seen := false
					k := 0
					while k < len(dupes) {
						if dupes[k] == nm {
							seen = true
						}
						k = k + 1
					}
					if !seen {
						dupes = append(dupes, nm)
					}
				}
				j = j + 1
			}
			names = append(names, nm)
			items = append(items, "{"+jkv("name", jstr(nm))+","+jkv("pid", str(pid))+","+jkv("toolkit", jstr(tk))+","+jkv("windows", str(kids))+","+jkv("ref", jstr(nm+"#pid"+str(pid)))+"}")
			g_object_unref(a)
		}
		i = i + 1
	}
	dj := []string{}
	i = 0
	while i < len(dupes) {
		dj = append(dj, jstr(dupes[i]))
		i = i + 1
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("applications", jarr(items)) + "," + jkv("count", str(len(items))) + "," + jkv("ambiguous_names", jarr(dj)) + "}"
	if len(dupes) > 0 {
		write(2, "warning: " + str(len(dupes)) + " application name(s) are shared by more than one process; address them as '<name>#pid<PID>' or with --pid\n")
	}
}

func cmd_windows(appfilter) (out, code) {
	code = EX_OK
	items := []string{}
	n := atspi_accessible_get_child_count(desktop, 0)
	i := 0
	while i < n {
		a := atspi_accessible_get_child_at_index(desktop, i, 0)
		if a != 0 {
			nm := nodename(a)
			if app_matches(a, nm, appfilter) {
				wc := atspi_accessible_get_child_count(a, 0)
				j := 0
				while j < wc {
					w := atspi_accessible_get_child_at_index(a, j, 0)
					if w != 0 {
						wr := noderole(w)
						wn := nodename(w)
						x, y, ww, wh := extents(w)
						f := []string{}
						f = append(f, jkv("app", jstr(nm)))
						f = append(f, jkv("ref", jstr(mkref(nm, "/"+str(j), wr, wn))))
						f = append(f, jkv("title", jstr(wn)))
						f = append(f, jkv("role", jstr(wr)))
						f = append(f, jkv("x", str(x)))
						f = append(f, jkv("y", str(y)))
						f = append(f, jkv("w", str(ww)))
						f = append(f, jkv("h", str(wh)))
						f = append(f, jkv("active", jbool(hasstate(w, ST_ACTIVE))))
						items = append(items, "{"+join(f, ",")+"}")
						g_object_unref(w)
					}
					j = j + 1
				}
			}
			g_object_unref(a)
		}
		i = i + 1
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("windows", jarr(items)) + "," + jkv("count", str(len(items))) + "}"
}

func cmd_state(appname, maxdepth, maxnodes) (out, code) {
	code = EX_OK
	out = ""
	app := findapp(appname)
	if app == 0 {
		if appAmbiguous > 1 {
			code = EX_USAGE
			out = errjson("app_ambiguous", str(appAmbiguous)+" applications are named '"+appname+"'", true, []string{"disambiguate with the pid: --app '" + appname + "#pid<PID>' or --pid <PID>", "list pids with: linux-use apps"})
			return
		}
		code = EX_APP_NOT_FOUND
		out = errjson("app_not_found", "no application named '"+appname+"' in the accessibility tree", true, []string{"run: linux-use apps", "the app may not be running, or may not export accessibility (see: linux-use doctor)"})
		return
	}
	rows = []string{}
	budget = maxnodes
	visited = 0
	deepest = 0
	depthCut = false
	method := "collection"
	unknown := ""
	geomCount := 0
	t0 := now_ms()
	cok := false
	if !forceWalk {
		crows, _, okc, unk, unp := collect(appname, app, wantRole, maxnodes)
		unknown = unk
		cok = okc
		geomUsed := geomrefs
		if okc {
			rows = crows
			geomCount = geomUsed
			// A collection match whose path could not be proven has no ref.
			// Unless the caller explicitly asked for the collection path,
			// prefer a complete answer over a fast one and re-run as a walk.
			if unp > 0 && !forceCollection {
				cok = false
				method = "collection+walk"
				rows = []string{}
			}
		}
	}
	if !cok {
		if method == "collection" {
			method = "walk"
		}
		walk(appname, app, "", 0, maxdepth)
	}
	ms := now_ms() - t0
	g_object_unref(app)
	trunc := budget <= 0
	f := []string{}
	f = append(f, jkv("schema", jstr(SCHEMA)))
	f = append(f, jkv("ok", "true"))
	f = append(f, jkv("app", jstr(appname)))
	f = append(f, jkv("elements", jarr(rows)))
	f = append(f, jkv("count", str(len(rows))))
	f = append(f, jkv("walk_ms", str(ms)))
	f = append(f, jkv("nodes_visited", str(visited)))
	f = append(f, jkv("deepest", str(deepest)))
	f = append(f, jkv("depth_limit", str(maxdepth)))
	f = append(f, jkv("depth_limited", jbool(depthCut)))
	f = append(f, jkv("truncated", jbool(trunc)))
	f = append(f, jkv("method", jstr(method)))
	f = append(f, jkv("geometry_refs", str(geomCount)))
	out = "{" + join(f, ",") + "}"
	if len(unknown) > 0 {
		write(2, "warning: unknown role '" + unknown + "' — it matched nothing; check: linux-use roles\n")
	}
	if trunc {
		write(2, "warning: node budget exhausted — results are TRUNCATED; narrow with --role/--app or raise --max-nodes\n")
	}
	if depthCut && method == "walk" {
		write(2, "warning: subtrees were cut at --depth " + str(maxdepth) + " — deeper widgets are NOT in this result; raise --depth\n")
	}
}

func cmd_find(query, appfilter, maxdepth, maxnodes) (out, code) {
	code = EX_OK
	wantText = query
	findMethod = "collection"
	all := []string{}
	visited = 0
	deepest = 0
	depthCut = false
	t0 := now_ms()
	n := atspi_accessible_get_child_count(desktop, 0)
	i := 0
	while i < n {
		a := atspi_accessible_get_child_at_index(desktop, i, 0)
		if a != 0 {
			nm := nodename(a)
			if app_matches(a, nm, appfilter) {
				rows = []string{}
				budget = maxnodes
				cok := false
				if !forceWalk {
					crows, _, okc, _, unp := collect(nm, a, wantRole, maxnodes)
					cok = okc
					if okc {
						rows = crows
						if unp > 0 && !forceCollection {
							cok = false
							findMethod = "collection+walk"
							rows = []string{}
						}
					}
				}
				if !cok {
					findMethod = "walk"
					walk(nm, a, "", 0, maxdepth)
				}
				j := 0
				while j < len(rows) {
					all = append(all, rows[j])
					j = j + 1
				}
			}
			g_object_unref(a)
		}
		i = i + 1
	}
	ms := now_ms() - t0
	f := []string{}
	f = append(f, jkv("schema", jstr(SCHEMA)))
	f = append(f, jkv("ok", "true"))
	f = append(f, jkv("query", jstr(query)))
	f = append(f, jkv("matches", jarr(all)))
	f = append(f, jkv("count", str(len(all))))
	f = append(f, jkv("search_ms", str(ms)))
	f = append(f, jkv("nodes_visited", str(visited)))
	f = append(f, jkv("deepest", str(deepest)))
	f = append(f, jkv("depth_limited", jbool(depthCut)))
	f = append(f, jkv("method", jstr(findMethod)))
	out = "{" + join(f, ",") + "}"
	if depthCut && findMethod == "walk" {
		write(2, "warning: subtrees were cut at --depth " + str(maxdepth) + "; raise --depth if the target is missing\n")
	}
}

// getnode resolves a ref and VERIFIES its fingerprint. Returns (node, errjson, code).
// node is a new ref the caller must unref when code == EX_OK.
func getnode(ref) (node, out, code) {
	node = 0
	out = ""
	code = EX_OK
	appname, path, want := splitref(ref)
	if len(appname) == 0 {
		code = EX_USAGE
		out = errjson("bad_ref", "ref must look like 'app:/0/1/2#fingerprint'", true, []string{"take refs verbatim from: linux-use state --app <app>"})
		return
	}
	app := findapp(appname)
	if app == 0 {
		if appAmbiguous > 1 {
			code = EX_USAGE
			out = errjson("app_ambiguous", str(appAmbiguous)+" applications are named '"+appname+"'", true, []string{"disambiguate with the pid: '" + appname + "#pid<PID>'", "list pids with: linux-use apps"})
			return
		}
		code = EX_APP_NOT_FOUND
		out = errjson("app_not_found", "no application named '"+appname+"'", true, []string{"run: linux-use apps"})
		return
	}
	if is_geom(path) {
		n2, cnt := resolve_geom(app, path)
		g_object_unref(app)
		node = n2
		if cnt == 0 {
			code = EX_REF_NOT_FOUND
			out = errjson("ref_not_found", "no widget of that role at that rectangle in "+appname, true, []string{"the UI moved or closed; re-run: linux-use state --app " + appname})
			return
		}
		if cnt > 1 {
			code = EX_REF_STALE
			out = errjson("ref_ambiguous", str(cnt)+" widgets share that role and rectangle in "+appname, true, []string{"the layout changed; re-run: linux-use state --app " + appname})
			return
		}
	} else {
		node = resolve(app, path)
		g_object_unref(app)
		if node == 0 {
			code = EX_REF_NOT_FOUND
			out = errjson("ref_not_found", "path '"+path+"' does not exist in "+appname, true, []string{"the UI changed; re-run: linux-use state --app " + appname})
			return
		}
	}
	if len(want) > 0 {
		got := fp(noderole(node), nodename(node))
		if got != want {
			g_object_unref(node)
			node = 0
			code = EX_REF_STALE
			out = errjson("ref_stale", "ref points at a different widget than when it was captured", true, []string{"the UI changed; re-run: linux-use state --app " + appname, "then use the fresh ref"})
			return
		}
	}
}

func cmd_act(ref, which) (out, code) {
	node, out, code := getnode(ref)
	if code != EX_OK {
		return
	}
	role := noderole(node)
	name := nodename(node)
	ai := atspi_accessible_get_action_iface(node)
	if ai == 0 {
		g_object_unref(node)
		code = EX_NO_CAPABILITY
		out = errjson("no_action", "'"+role+"' exposes no accessible action", true, []string{"use: linux-use click " + ref + " (synthetic pointer fallback)"})
		return
	}
	nacts := atspi_action_get_n_actions(ai, 0)
	idx := 0
	if len(which) > 0 {
		idx = parse_int(which)
	}
	if idx >= nacts {
		g_object_unref(ai)
		g_object_unref(node)
		code = EX_USAGE
		out = errjson("bad_action_index", "action "+str(idx)+" out of range (element has "+str(nacts)+")", true, []string{"omit --action to use action 0"})
		return
	}
	an := takestr(atspi_action_get_action_name(ai, idx, 0))
	ok := atspi_action_do_action(ai, idx, 0)
	g_object_unref(ai)
	g_object_unref(node)
	if !ok {
		code = EX_ACTION_FAILED
		out = errjson("action_failed", "the toolkit refused action '"+an+"'", true, []string{"use: linux-use click " + ref})
		return
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("ref", jstr(ref)) + "," + jkv("role", jstr(role)) + "," + jkv("name", jstr(name)) + "," + jkv("action", jstr(an)) + "}"
}

func cmd_read(ref) (out, code) {
	node, out, code := getnode(ref)
	if code != EX_OK {
		return
	}
	role := noderole(node)
	name := nodename(node)
	txt := ""
	nc := 0
	ti := atspi_accessible_get_text_iface(node)
	if ti != 0 {
		nc = atspi_text_get_character_count(ti, 0)
		if nc > 0 {
			txt = takestr(atspi_text_get_text(ti, 0, nc, 0))
		}
		g_object_unref(ti)
	}
	desc := takestr(atspi_accessible_get_description(node, 0))
	g_object_unref(node)
	f := []string{}
	f = append(f, jkv("schema", jstr(SCHEMA)))
	f = append(f, jkv("ok", "true"))
	f = append(f, jkv("ref", jstr(ref)))
	f = append(f, jkv("role", jstr(role)))
	f = append(f, jkv("name", jstr(name)))
	f = append(f, jkv("description", jstr(desc)))
	f = append(f, jkv("chars", str(nc)))
	f = append(f, jkv("text", jstr(txt)))
	out = "{" + join(f, ",") + "}"
}

func cmd_type(ref, text, replace, allowpw) (out, code) {
	node, out, code := getnode(ref)
	if code != EX_OK {
		return
	}
	role := noderole(node)
	if role == "password text" && !allowpw {
		g_object_unref(node)
		code = EX_REFUSED
		out = errjson("refused_password_field", "refusing to type into a password field", false, []string{"pass --allow-password if this is genuinely intended"})
		return
	}
	method := ""
	ok := false
	et := atspi_accessible_get_editable_text_iface(node)
	if et != 0 {
		if replace {
			ok = atspi_editable_text_set_text_contents(et, text, 0)
			method = "editable_text.set_contents"
		} else {
			pos := 0
			ti := atspi_accessible_get_text_iface(node)
			if ti != 0 {
				pos = atspi_text_get_caret_offset(ti, 0)
				g_object_unref(ti)
			}
			ok = atspi_editable_text_insert_text(et, pos, text, len(text), 0)
			method = "editable_text.insert"
		}
		g_object_unref(et)
	}
	if !ok {
		// Fallback: focus the widget, then synthesize the string.
		//
		// VERIFY the focus landed before typing. grab_focus silently does
		// nothing on some web elements (Chromium), and synthesizing a string
		// into an unknown focus is genuinely dangerous: a space character
		// presses whatever button happens to be focused. That is not
		// hypothetical — it closed a browser during testing.
		comp := atspi_accessible_get_component_iface(node)
		if comp != 0 {
			atspi_component_grab_focus(comp, 0)
			g_object_unref(comp)
			sleep(120)
		}
		if !hasstate(node, ST_FOCUSED) {
			g_object_unref(node)
			code = EX_NO_CAPABILITY
			out = errjson("focus_refused", "could not focus '"+role+"', so typing would go somewhere unknown", true, []string{"click it first: linux-use click " + ref, "then verify focused:true in: linux-use state --app <app>", "then: linux-use sendtext '<text>'"})
			return
		}
		// Focus is verified, so prefer the clipboard route: AT-SPI key
		// synthesis crashes a11y-forced Chromium (issue #4).
		if has_xclip() {
			ok, _ = clip_paste(text, true)
			method = "clipboard+ctrl_v(focus-verified)"
		} else {
			ok = atspi_generate_keyboard_event(0, text, KEY_STRING, 0)
			method = "keyboard.string(focus-verified)"
			write(2, "warning: xclip not found, used AT-SPI key synthesis — crashes a11y-forced Chromium (issue #4)\n")
		}
	}
	g_object_unref(node)
	if !ok {
		code = EX_ACTION_FAILED
		out = errjson("type_failed", "could not insert text into '"+role+"'", true, []string{"try: linux-use click " + ref + " then linux-use key <keys>"})
		return
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("ref", jstr(ref)) + "," + jkv("method", jstr(method)) + "," + jkv("chars", str(len(text))) + "}"
}

// ---------------------------------------------------------------- X11 input

func xopen() (dpy) {
	dpy = XOpenDisplay(env("DISPLAY"))
}

func keysym_alias(tok) (name, found) {
	name = ""
	found = true
	if tok == "ctrl" || tok == "control" {
		name = "Control_L"
	} else {
		if tok == "shift" {
			name = "Shift_L"
		} else {
			if tok == "alt" {
				name = "Alt_L"
			} else {
				if tok == "altgr" {
					name = "ISO_Level3_Shift"
				} else {
					if tok == "super" || tok == "meta" || tok == "cmd" || tok == "win" {
						name = "Super_L"
					} else {
						if tok == "enter" || tok == "return" {
							name = "Return"
						} else {
							if tok == "esc" || tok == "escape" {
								name = "Escape"
							} else {
								if tok == "tab" {
									name = "Tab"
								} else {
									if tok == "space" {
										name = "space"
									} else {
										if tok == "backspace" {
											name = "BackSpace"
										} else {
											if tok == "delete" || tok == "del" {
												name = "Delete"
											} else {
												if tok == "insert" || tok == "ins" {
													name = "Insert"
												} else {
													name = keysym_alias2(tok)
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
	if len(name) == 0 {
		found = false
	}
}

// keysym_alias2 is the tail of the alias table, split out only because MFL has
// no switch and the nesting would otherwise get silly.
func keysym_alias2(tok) (name) {
	name = ""
	if tok == "up" {
		name = "Up"
		return
	}
	if tok == "down" {
		name = "Down"
		return
	}
	if tok == "left" {
		name = "Left"
		return
	}
	if tok == "right" {
		name = "Right"
		return
	}
	if tok == "home" {
		name = "Home"
		return
	}
	if tok == "end" {
		name = "End"
		return
	}
	if tok == "pageup" || tok == "pgup" {
		name = "Prior"
		return
	}
	if tok == "pagedown" || tok == "pgdn" {
		name = "Next"
		return
	}
	if tok == "printscreen" || tok == "prtsc" || tok == "print" {
		name = "Print"
		return
	}
	if tok == "menu" {
		name = "Menu"
		return
	}
	if tok == "pause" {
		name = "Pause"
		return
	}
	if tok == "capslock" {
		name = "Caps_Lock"
		return
	}
	if tok == "numlock" {
		name = "Num_Lock"
		return
	}
	if tok == "scrolllock" || tok == "scroll_lock" {
		name = "Scroll_Lock"
		return
	}
	// f1..f24 in either case: the X keysyms are F1..F24
	if len(tok) >= 2 && len(tok) <= 3 {
		if charat(tok, 0) == "f" {
			n := parse_int(substr(tok, 1, len(tok)))
			if n >= 1 && n <= 24 {
				name = "F" + str(n)
			}
		}
	}
}

// capitalise upper-cases the first character only, turning "print" into "Print"
// and "f4" into "F4" — the shape most X keysym names take.
func capitalise(t) (r) {
	r = t
	if len(t) == 0 {
		return
	}
	r = to_upper(substr(t, 0, 1)) + substr(t, 1, len(t))
}

// resolve_keysym tries, in order: the alias table (case-insensitive), the token
// EXACTLY as written, then the token capitalised. X keysym names are
// CASE-SENSITIVE, so lowercasing the whole combo before lookup — as this used
// to do — made every capitalised name ("F4", "Print", "Menu") unresolvable.
func resolve_keysym(tok) (name, ks) {
	name = ""
	ks = 0
	alias, found := keysym_alias(to_lower(tok))
	if found {
		ks = XStringToKeysym(alias)
		if ks != 0 {
			name = alias
			return
		}
	}
	ks = XStringToKeysym(tok)
	if ks != 0 {
		name = tok
		return
	}
	cap := capitalise(tok)
	ks = XStringToKeysym(cap)
	if ks != 0 {
		name = cap
		return
	}
	name = tok
	ks = 0
}

func cmd_sendtext(text, via) (out, code) {
	code = EX_OK
	if len(text) == 0 {
		code = EX_USAGE
		out = errjson("missing_text", "sendtext needs a string", true, []string{"example: linux-use sendtext 'hello'"})
		return
	}
	mech := via
	if mech == "" {
		mech = "auto"
	}
	if mech != "auto" && mech != "clipboard" && mech != "atspi" {
		code = EX_USAGE
		out = errjson("bad_via", "--via takes auto|clipboard|atspi", true, []string{"omit --via for the safe default"})
		return
	}
	if mech == "auto" {
		if has_xclip() {
			mech = "clipboard"
		} else {
			mech = "atspi"
			write(2, "warning: xclip not found, falling back to AT-SPI key synthesis — this CRASHES Chromium/Edge started with --force-renderer-accessibility (issue #4). Install xclip to avoid it.\n")
		}
	}
	if mech == "clipboard" {
		if !has_xclip() {
			code = EX_NO_CAPABILITY
			out = errjson("xclip_missing", "--via clipboard needs xclip on PATH", true, []string{"sudo apt install xclip"})
			return
		}
		ok, restored := clip_paste(text, true)
		if !ok {
			code = EX_ACTION_FAILED
			out = errjson("sendtext_failed", "clipboard paste failed", true, []string{"run: linux-use doctor"})
			return
		}
		out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("chars", str(len(text))) + "," + jkv("method", jstr("clipboard+ctrl_v")) + "," + jkv("clipboard_restored", jbool(restored)) + "}"
		return
	}
	ok := atspi_generate_keyboard_event(0, text, KEY_STRING, 0)
	if !ok {
		code = EX_ACTION_FAILED
		out = errjson("sendtext_failed", "the a11y registry refused to synthesize the string", true, []string{"check: linux-use doctor"})
		return
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("chars", str(len(text))) + "," + jkv("method", jstr("keyboard.string")) + "," + jkv("warning", jstr("AT-SPI key synthesis crashes a11y-forced Chromium")) + "}"
}

// cmd_paste puts text on the clipboard and presses ctrl+v via XTEST.
//
// This exists because atspi_generate_keyboard_event (what `sendtext` uses)
// CRASHES Chromium/Edge launched with --force-renderer-accessibility —
// reproduced on a bare <input> page with focus verified, so it is not
// app-specific. The clipboard route never touches the AT-SPI device-event
// controller, so it is the safe way to put text into an a11y-forced browser.
//
// The text goes to the clipboard via a temp FILE, never through a shell
// argument, so quotes/newlines/$ in the payload cannot be reinterpreted.
func has_xclip() (b) {
	b = system("command -v xclip >/dev/null 2>&1") == 0
}

// clip_paste puts text on the CLIPBOARD selection and sends ctrl+v via XTEST.
// Returns (ok, restored). It deliberately avoids the AT-SPI input controller,
// which crashes Chromium built with forced renderer accessibility (issue #4).
// The payload is staged through a FILE, never a shell argument, so quotes,
// newlines and $ in the text cannot be reinterpreted.
func clip_paste(text, restore) (ok, restored) {
	ok = false
	restored = false
	tmp := "/tmp/.linux-use-clip"
	old := ""
	if restore {
		_, o, _ := exec("xclip -selection clipboard -o 2>/dev/null")
		old = o
	}
	if write_file(tmp, text) < 0 {
		return
	}
	// xclip stays alive to OWN the selection, so it must be backgrounded —
	// a foreground system() call never returns.
	system("xclip -selection clipboard -i " + tmp + " >/dev/null 2>&1 &")
	sleep(200)

	dpy := xopen()
	if dpy == 0 {
		return
	}
	ctrl := XKeysymToKeycode(dpy, XStringToKeysym("Control_L"))
	v := XKeysymToKeycode(dpy, XStringToKeysym("v"))
	XTestFakeKeyEvent(dpy, ctrl, 1, 0)
	XTestFakeKeyEvent(dpy, v, 1, 0)
	XTestFakeKeyEvent(dpy, v, 0, 0)
	XTestFakeKeyEvent(dpy, ctrl, 0, 0)
	XSync(dpy, false)
	XCloseDisplay(dpy)
	sleep(250)
	ok = true

	if restore && len(old) > 0 {
		if write_file(tmp, old) >= 0 {
			system("xclip -selection clipboard -i " + tmp + " >/dev/null 2>&1 &")
			sleep(200)
			restored = true
		}
	}
}

func cmd_paste(text, restore) (out, code) {
	code = EX_OK
	if len(text) == 0 {
		code = EX_USAGE
		out = errjson("missing_text", "paste needs a string", true, []string{"example: linux-use paste 'hello'"})
		return
	}
	if !has_xclip() {
		code = EX_NO_CAPABILITY
		out = errjson("xclip_missing", "paste needs xclip on PATH", true, []string{"sudo apt install xclip", "or force the unsafe path: linux-use sendtext --via atspi '<text>'"})
		return
	}
	ok, restored := clip_paste(text, restore)
	if !ok {
		code = EX_ACTION_FAILED
		out = errjson("paste_failed", "could not set the clipboard or send ctrl+v", true, []string{"run: linux-use doctor"})
		return
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("chars", str(len(text))) + "," + jkv("method", jstr("clipboard+ctrl_v")) + "," + jkv("clipboard_restored", jbool(restored)) + "}"
}

func cmd_key(combo, dryrun) (out, code) {
	code = EX_OK
	dpy := xopen()
	if dpy == 0 {
		code = EX_NO_DISPLAY
		out = errjson("no_display", "cannot open X display '"+env("DISPLAY")+"'", false, []string{"this build injects input via XTEST and needs an X11 session", "run: linux-use doctor"})
		return
	}
	toks := split(combo, "+")
	codes := []int{}
	resolved := []string{}
	i := 0
	while i < len(toks) {
		t := trim(toks[i])
		if len(t) > 0 {
			nm, ks := resolve_keysym(t)
			if ks == 0 {
				XCloseDisplay(dpy)
				code = EX_USAGE
				out = errjson("unknown_key", "'"+t+"' is not a known key name", true, []string{"keysym names are CASE-SENSITIVE: F4 not f4 (f1-f12 are accepted either way)", "aliases: ctrl shift alt super enter esc tab space backspace delete insert up down left right home end pageup pagedown print menu pause", "list every valid name with: xmodmap -pke"})
				return
			}
			kc := XKeysymToKeycode(dpy, ks)
			if kc == 0 {
				XCloseDisplay(dpy)
				code = EX_USAGE
				out = errjson("unmapped_key", "'"+nm+"' has no keycode in the current layout", true, []string{"the active keyboard layout cannot produce this key"})
				return
			}
			codes = append(codes, kc)
			resolved = append(resolved, nm)
		}
		i = i + 1
	}
	if len(codes) == 0 {
		XCloseDisplay(dpy)
		code = EX_USAGE
		out = errjson("empty_combo", "no keys given", true, []string{"example: linux-use key ctrl+shift+t"})
		return
	}
	if dryrun {
		XCloseDisplay(dpy)
		q := []string{}
		i = 0
		while i < len(resolved) {
			q = append(q, jstr(resolved[i]))
			i = i + 1
		}
		out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("combo", jstr(combo)) + "," + jkv("keys", jarr(q)) + "," + jkv("sent", "false") + "}"
		return
	}
	i = 0
	while i < len(codes) {
		XTestFakeKeyEvent(dpy, codes[i], 1, 0)
		i = i + 1
	}
	i = len(codes) - 1
	while i >= 0 {
		XTestFakeKeyEvent(dpy, codes[i], 0, 0)
		i = i - 1
	}
	XSync(dpy, false)
	XCloseDisplay(dpy)
	q := []string{}
	i = 0
	while i < len(resolved) {
		q = append(q, jstr(resolved[i]))
		i = i + 1
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("combo", jstr(combo)) + "," + jkv("keys", jarr(q)) + "}"
}

func clickxy(x, y, button) (ok) {
	ok = false
	dpy := xopen()
	if dpy == 0 {
		return
	}
	XTestFakeMotionEvent(dpy, -1, x, y, 0)
	XSync(dpy, false)
	sleep(40)
	XTestFakeButtonEvent(dpy, button, 1, 0)
	XTestFakeButtonEvent(dpy, button, 0, 0)
	XSync(dpy, false)
	XCloseDisplay(dpy)
	ok = true
}

func cmd_click(ref, px, py, button) (out, code) {
	code = EX_OK
	x := px
	y := py
	label := "coordinates"
	if len(ref) > 0 {
		node, e, c := getnode(ref)
		if c != EX_OK {
			out = e
			code = c
			return
		}
		ex, ey, w, h := extents(node)
		g_object_unref(node)
		if w <= 0 || h <= 0 {
			code = EX_NO_CAPABILITY
			out = errjson("no_extents", "element has no on-screen geometry to click", true, []string{"use: linux-use act " + ref})
			return
		}
		x = ex + w/2
		y = ey + h/2
		label = ref
	}
	if !clickxy(x, y, button) {
		code = EX_NO_DISPLAY
		out = errjson("no_display", "cannot open X display", false, []string{"run: linux-use doctor"})
		return
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("target", jstr(label)) + "," + jkv("x", str(x)) + "," + jkv("y", str(y)) + "," + jkv("button", str(button)) + "}"
}

func cmd_launch(command, waitfor, timeoutms) (out, code) {
	code = EX_OK
	rc := system(command + " >/dev/null 2>&1 &")
	appeared := false
	waited := 0
	if len(waitfor) > 0 {
		while waited < timeoutms {
			a := findapp(waitfor)
			if a != 0 {
				g_object_unref(a)
				appeared = true
				waited = timeoutms
			} else {
				sleep(200)
				waited = waited + 200
			}
		}
		if !appeared {
			code = EX_APP_NOT_FOUND
			out = errjson("launch_timeout", "'"+waitfor+"' did not appear in the accessibility tree within "+str(timeoutms)+"ms", true, []string{"the app may be slow to start, or may not export accessibility", "run: linux-use apps"})
			return
		}
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("command", jstr(command)) + "," + jkv("spawn_rc", str(rc)) + "," + jkv("appeared", jbool(appeared)) + "}"
}

// cmd_roles lists every role name the toolkit knows, flagging the ones in the
// default interactive filter. --role takes these verbatim.
func cmd_roles() (out, code) {
	code = EX_OK
	items := []string{}
	n := lu_role_count()
	i := 0
	while i <= n {
		nm := takestr(atspi_role_get_name(i))
		if len(nm) > 0 {
			items = append(items, "{" + jkv("role", jstr(nm)) + "," + jkv("interactive", jbool(interactive(nm))) + "}")
		}
		i = i + 1
	}
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("roles", jarr(items)) + "," + jkv("count", str(len(items))) + "}"
}

func cmd_doctor() (out, code) {
	code = EX_OK
	f := []string{}
	f = append(f, jkv("schema", jstr(SCHEMA)))
	f = append(f, jkv("session_type", jstr(env("XDG_SESSION_TYPE"))))
	f = append(f, jkv("display", jstr(env("DISPLAY"))))
	f = append(f, jkv("wayland_display", jstr(env("WAYLAND_DISPLAY"))))

	_, tk, _ := exec("gsettings get org.gnome.desktop.interface toolkit-accessibility 2>/dev/null")
	tkon := contains(tk, "true")
	f = append(f, jkv("toolkit_accessibility", jbool(tkon)))

	a11y := a11y_up()
	f = append(f, jkv("atspi", jbool(a11y)))
	napps := 0
	if a11y {
		napps = atspi_accessible_get_child_count(desktop, 0)
	}
	f = append(f, jkv("applications", str(napps)))

	dpy := xopen()
	xok := dpy != 0
	if xok {
		XCloseDisplay(dpy)
	}
	f = append(f, jkv("xtest", jbool(xok)))
	xc := has_xclip()
	f = append(f, jkv("clipboard_backend", jbool(xc)))
	f = append(f, jkv("text_entry_default", jstr("clipboard+ctrl_v")))
	if !xc {
		f = append(f, jkv("text_entry_actual", jstr("atspi.keystring (UNSAFE for a11y-forced Chromium)")))
	} else {
		f = append(f, jkv("text_entry_actual", jstr("clipboard+ctrl_v")))
	}

	probs := []string{}
	if !tkon {
		probs = append(probs, jstr("toolkit-accessibility is off — Qt/Java/Electron apps may expose nothing. Fix: gsettings set org.gnome.desktop.interface toolkit-accessibility true"))
	}
	if !a11y {
		probs = append(probs, jstr("the AT-SPI bus is unreachable — perception will not work at all"))
	}
	if !xc {
		probs = append(probs, jstr("xclip is missing, so text entry falls back to AT-SPI key synthesis, which CRASHES Chromium/Edge started with --force-renderer-accessibility (issue #4). Fix: sudo apt install xclip"))
	}
	if !xok {
		probs = append(probs, jstr("no X display — click/key actuation unavailable (Wayland is not supported in v0.1; AT-SPI actions still work)"))
	}
	if env("XDG_SESSION_TYPE") == "wayland" {
		probs = append(probs, jstr("Wayland session: XTEST cannot reach native Wayland clients. Prefer 'act' over 'click'."))
	}
	f = append(f, jkv("ok", jbool(len(probs) == 0)))
	f = append(f, jkv("problems", jarr(probs)))
	out = "{" + join(f, ",") + "}"
	if len(probs) > 0 {
		code = EX_NO_A11Y
		if a11y {
			code = EX_OK
		}
	}
}

func cmd_pointer() (out, code) {
	code = EX_OK
	dpy := xopen()
	if dpy == 0 {
		code = EX_NO_DISPLAY
		out = errjson("no_display", "cannot open X display", false, []string{"run: linux-use doctor"})
		return
	}
	root := XDefaultRootWindow(dpy)
	buf := alloc(64)
	XQueryPointer(dpy, root, buf, buf+8, buf+16, buf+20, buf+24, buf+28, buf+32)
	x := peek_i32(buf, 16)
	y := peek_i32(buf, 20)
	free(buf)
	XCloseDisplay(dpy)
	out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("x", str(x)) + "," + jkv("y", str(y)) + "}"
}

// ---------------------------------------------------------------- watch

// The AT-SPI callback is compiled to a raw C function pointer, so it must be
// CAPTURELESS — every knob it reads is a package global.
var wchApp = ""
var wchRole = ""
var wchSeen = 0
var wchMax = 0
var wchMaxRss = 0

// pathof reconstructs an actionable ref by walking UP from an event source to
// its application, collecting child indices. Events give us a node, not a path.
// indexof is atspi_accessible_get_index_in_parent with a fallback. Some nodes
// report -1; silently DROPPING such a level builds a path that looks valid but
// resolves to the wrong widget, so scan the parent's children instead.
// sameobj tests accessible identity by POINTER only. atspi_accessible_get_id
// was tried as a fallback and rejected: it is not unique per object here and
// produced false matches, i.e. confidently WRONG refs. A ref we cannot prove
// is better reported as unusable than guessed.
func sameobj(a, b) (r) {
	r = a == b
}

var icache = make(map[string]string)

func indexof(node) (idx) {
	idx = -1
	ck := ""
	cv := ""
	if cacheOn {
		ck = str(node)
		cv = icache[ck]
	}
	if len(cv) > 0 {
		idx = parse_int(cv) - 1
		return
	}
	par := atspi_accessible_get_parent(node, 0)
	if par == 0 {
		return
	}
	// index_in_parent is a HINT, not the truth: it can return a non-negative
	// value that disagrees with get_child_at_index (observed in
	// gnome-control-center, where it said 0 for a child actually at 1).
	// Refs are resolved with get_child_at_index, so that is the authority —
	// take the hint only when it verifies against it.
	hint := atspi_accessible_get_index_in_parent(node, 0)
	if hint >= 0 {
		c := atspi_accessible_get_child_at_index(par, hint, 0)
		if c != 0 {
			same := sameobj(c, node)
			g_object_unref(c)
			if same {
				idx = hint
				if cacheOn {
					icache[ck] = str(idx + 1)
				}
				g_object_unref(par)
				return
			}
		}
	}
	n := atspi_accessible_get_child_count(par, 0)
	i := 0
	while i < n {
		c := atspi_accessible_get_child_at_index(par, i, 0)
		if c != 0 {
			same := sameobj(c, node)
			g_object_unref(c)
			if same {
				idx = i
				if cacheOn {
					icache[ck] = str(idx + 1)
				}
				g_object_unref(par)
				return
			}
		}
		i = i + 1
	}
	g_object_unref(par)
}

// pcache memoizes "path from the application root" per accessible, keyed by
// pointer. Collection matches are siblings in a tree: each one climbs through
// the SAME ancestors, so without memoization the climb is re-walked once per
// match and eats the whole benefit of the server-side query.
//
// Lifetime is ONE query. Paths are only valid for the tree as it was; keeping
// entries across a UI change would resurrect the exact bug this tool exists to
// avoid — a ref that resolves to the wrong widget.
var pcache = make(map[string]string)
var cacheOn = false

func pcache_reset() {
	pcache = make(map[string]string)
	icache = make(map[string]string)
}

// pathof reconstructs a ref by walking UP to the application, memoizing every
// ancestor it passes. ok=false means an ancestor index could not be determined
// — the ref would be WRONG, so it is reported as unusable rather than emitted
// as a plausible lie.
func pathof(node) (path, appname, ok) {
	path = ""
	appname = ""
	ok = false
	keys := []string{}
	idxs := []int{}
	prefix := ""
	cur := node
	owned := false
	hops := 0
	basePath := ""
	baseApp := ""
	done := false
	bad := false
	while !done && !bad && hops < 64 {
		k := ""
		cv := ""
		if cacheOn {
			k = str(cur)
			cv = pcache[k]
		}
		if len(cv) > 0 {
			parts := split(cv, "\t")
			baseApp = parts[0]
			basePath = parts[1]
			done = true
		} else {
			if noderole(cur) == "application" {
				baseApp = nodename(cur)
				basePath = ""
				if cacheOn {
					pcache[k] = baseApp + "\t"
				}
				done = true
			} else {
				idx := indexof(cur)
				if idx < 0 {
					bad = true
				} else {
					if cacheOn {
						keys = append(keys, k)
						idxs = append(idxs, idx)
					} else {
						// Uncached (watch): accumulate directly. The two arrays
						// exist only to backfill the cache, and allocating them
						// per event is a slow leak in a long-lived listener.
						prefix = "/" + str(idx) + prefix
					}
					nxt := atspi_accessible_get_parent(cur, 0)
					if owned {
						g_object_unref(cur)
					}
					cur = nxt
					owned = true
					if cur == 0 {
						bad = true
					}
					hops = hops + 1
				}
			}
		}
	}
	if owned && cur != 0 {
		g_object_unref(cur)
	}
	if bad || !done {
		return
	}
	appname = baseApp
	if !cacheOn {
		path = basePath + prefix
		ok = true
		return
	}
	acc := basePath
	j := len(keys) - 1
	while j >= 0 {
		acc = acc + "/" + str(idxs[j])
		pcache[keys[j]] = appname + "\t" + acc
		j = j - 1
	}
	path = acc
	ok = true
}

// on_event runs for the life of the process, so every allocation it makes
// would accumulate. The body lives in an `arena` block whose memory is
// reclaimed in bulk at the end of each event; nothing escapes it (the JSON is
// written to stdout inside the block), so the reclamation is safe.
// NOTE: no `return` may appear inside an arena block (it would skip cleanup),
// hence the `emit` flag instead of early returns.
func on_event(ev, data) {
	src := lu_ev_source(ev)
	if src == 0 {
		return
	}
	if wchMax > 0 && wchSeen >= wchMax {
		return
	}
	// No path cache here: one event means one climb, so the cache would buy
	// nothing — and its maps are allocated OUTSIDE the arena below, so they
	// would leak once per event. (Measured at ~17 kB/event before the arena.)
	cacheOn = false
	arena {
		emit := true
		etype := takestr_borrowed(lu_ev_type(ev))
		path, appname, pathok := pathof(src)
		if len(wchApp) > 0 && appname != wchApp {
			emit = false
		}
		if emit && len(wchRole) > 0 {
			if noderole(src) != wchRole {
				emit = false
			}
		}
		if emit {
			role := noderole(src)
			name := nodename(src)
			f := []string{}
			f = append(f, jkv("event", jstr(etype)))
			f = append(f, jkv("app", jstr(appname)))
			f = append(f, jkv("role", jstr(role)))
			f = append(f, jkv("name", jstr(name)))
			rf := ""
			if pathok {
				rf = mkref(appname, path, role, name)
			}
			f = append(f, jkv("ref", jstr(rf)))
			f = append(f, jkv("ref_ok", jbool(pathok)))
			f = append(f, jkv("detail1", str(lu_ev_detail1(ev))))
			f = append(f, jkv("detail2", str(lu_ev_detail2(ev))))
			f = append(f, jkv("ts", str(now_ms())))
			println("{" + join(f, ",") + "}")
			flush()
			wchSeen = wchSeen + 1
		}
	}
	if wchMax > 0 && wchSeen >= wchMax {
		atspi_event_quit()
	}
	// libatspi's event delivery grows ~0.14 kB per event on at-spi2-core 2.44,
	// independent of what this callback does (measured with a no-op callback).
	// It is not ours to fix, so make it BOUNDED: exit cleanly at a ceiling and
	// let a supervisor restart, rather than growing without limit.
	if wchMaxRss > 0 {
		if wchSeen % 64 == 0 {
			if lu_rss_kb() > wchMaxRss {
				write(2, "linux-use watch: rss ceiling reached (" + str(lu_rss_kb()) + " kB > " + str(wchMaxRss) + " kB) after " + str(wchSeen) + " events; exiting " + str(EX_RSS_LIMIT) + " for a supervisor to restart\n")
				flush()
				exit(EX_RSS_LIMIT)
			}
		}
	}
}

func default_events() (r) {
	r = []string{}
	r = append(r, "object:state-changed:focused")
	r = append(r, "object:text-changed:insert")
	r = append(r, "object:text-changed:delete")
	r = append(r, "object:selection-changed")
	r = append(r, "window:activate")
	r = append(r, "window:deactivate")
	r = append(r, "window:create")
	r = append(r, "window:destroy")
}

func cmd_watch(appfilter, rolefilter, evspec, maxev, duration, maxrss) (out, code) {
	code = EX_OK
	out = ""
	wchApp = appfilter
	wchRole = rolefilter
	wchMaxRss = maxrss
	wchSeen = 0
	wchMax = maxev

	evs := default_events()
	if len(evspec) > 0 {
		evs = split(evspec, ",")
	}

	lst := atspi_event_listener_new(func(ev, data) { on_event(ev, data) }, 0, 0)
	if lst == 0 {
		code = EX_NO_A11Y
		out = errjson("watch_unavailable", "could not create an AT-SPI event listener", false, []string{"run: linux-use doctor"})
		return
	}
	reg := []string{}
	i := 0
	while i < len(evs) {
		e := trim(evs[i])
		if len(e) > 0 {
			if atspi_event_listener_register(lst, e, 0) {
				reg = append(reg, jstr(e))
			} else {
				write(2, "warning: could not register for '" + e + "'\n")
			}
		}
		i = i + 1
	}
	if len(reg) == 0 {
		code = EX_USAGE
		out = errjson("no_events_registered", "none of the requested event types could be registered", true, []string{"omit --events for the default set"})
		return
	}
	// Banner on stderr so stdout stays pure NDJSON.
	banner := "linux-use watch: " + str(len(reg)) + " event types registered; NDJSON on stdout"
	if wchMaxRss > 0 {
		banner = banner + "; rss ceiling " + str(wchMaxRss) + " kB (exit " + str(EX_RSS_LIMIT) + ")"
	}
	write(2, banner + "\n")
	if duration > 0 {
		g_timeout_add(duration, func(d) { atspi_event_quit()  return false }, 0)
	}
	atspi_event_main()
}

// ---------------------------------------------------------------- guide

func guide_json() (r) {
	c := []string{}
	c = append(c, jkv("tool", jstr("linux-use")))
	c = append(c, jkv("version", jstr(VERSION)))
	c = append(c, jkv("schema", jstr(SCHEMA)))
	c = append(c, jkv("purpose", jstr("Control a Linux desktop GUI at the accessibility layer. Perception and actuation only — there is no LLM inside; you are the loop.")))

	m := []string{}
	m = append(m, jstr("Every GUI app publishes a tree of widgets over AT-SPI2. linux-use reads that tree and acts on it. You do NOT need screenshots or pixel coordinates for most work."))
	m = append(m, jstr("An element ref looks like 'gnome-calculator:/0/1/0/3#824713' — application name, child-index path, and a fingerprint of role+name. Pass refs back verbatim; never construct or edit one by hand."))
	m = append(m, jstr("Two applications can publish the SAME accessible name (two browser profiles both called \"Microsoft Edge\"). A plain --app matching more than one is REFUSED with app_ambiguous rather than picking one; disambiguate with --app 'Name#pid1234' or --pid 1234. 'linux-use apps' lists each pid and flags ambiguous_names."))
	m = append(m, jstr("A ref comes in two kinds, and ref_kind says which. A PATH ref (app:/0/1/2#fp) addresses a node by child indices. A GEOMETRY ref (app:@<roleId>~x,y,w,h#fp) addresses it by role and on-screen rectangle, and is issued when a node has no provable path — some toolkits report a parent that does not list the node among its children, so climbing to it is impossible, not merely unknown. Both are used identically: pass them back verbatim."))
	m = append(m, jstr("A geometry ref is tied to screen position, so moving or resizing the window invalidates it — you get exit 84, never a silent hit on the wrong widget. If two widgets share a role and rectangle the ref is refused as ambiguous rather than guessed."))
	m = append(m, jstr("Refs go stale when the UI changes. That is DETECTED, not silently ignored: you get exit 83 ref_stale. The fix is always to re-run 'state' and use fresh refs."))
	m = append(m, jstr("Prefer 'act' over 'click'. 'act' invokes the widget's own accessible action — it needs no focus, no pointer, and works even when the window is fully occluded by another window. 'click' synthesizes a real pointer event and is the fallback for widgets that expose no action."))
	c = append(c, jkv("mental_model", jarr(m)))

	l := []string{}
	l = append(l, jstr("1. linux-use apps            — what is running and exposes accessibility"))
	l = append(l, jstr("2. linux-use state --app X   — the interactive elements of that app, with refs"))
	l = append(l, jstr("3. linux-use act <ref>       — act on one; or type/key/click as needed"))
	l = append(l, jstr("4. linux-use read <ref> or state again — VERIFY the effect before the next step"))
	l = append(l, jstr("Instead of polling step 4 in a sleep loop, run: linux-use watch --app X --duration 5000 (NDJSON, one event per line). Use --max-events N to stop after exactly N."))
	c = append(c, jkv("loop", jarr(l)))

	g := []string{}
	g = append(g, jstr("SHOWING does not mean visible. An element can be SHOWING while completely hidden behind another window. Never tell a user 'you can see X' based on this tool."))
	g = append(g, jstr("Coverage is not universal. GTK/Qt/Chromium/Electron expose good trees. Java needs java-atk-wrapper. Flutter, games, and canvas-drawn UIs may expose almost nothing — 'state' returning 0 elements means no accessibility, not an empty window."))
	g = append(g, jstr("state is filtered to interactive roles by default. Use --all for the full tree (labels, panels) when you need to READ the UI rather than act on it."))
	g = append(g, jstr("CHROMIUM CRASH (issue #4): AT-SPI key synthesis CRASHES Chromium/Edge launched with --force-renderer-accessibility — reproduced on a bare input page with focus verified. Since 0.6.2 text entry therefore goes through the CLIPBOARD by default (set CLIPBOARD, send ctrl+v via XTEST): 'paste', 'sendtext' and the 'type' fallback are all safe out of the box. 'sendtext --via atspi' opts back into the crashing path deliberately; 'linux-use doctor' reports which backend is actually in use."))
	g = append(g, jstr("SAFETY: 'type <ref>' now verifies the element actually took focus before synthesizing keystrokes, and fails with focus_refused rather than typing into an unknown target. 'sendtext' does NOT — it types wherever focus is, by design, so confirm focus yourself (check focused:true in state) before using it. A stray space presses whatever button is focused."))
	g = append(g, jstr("'type' uses the editable-text interface when available (deterministic, no focus needed) and falls back to synthesized keystrokes. It REFUSES password fields unless --allow-password."))
	g = append(g, jstr("X keysym names are CASE-SENSITIVE: 'F4' resolves and plain 'f4' would not — except f1-f12 are accepted in either case, alongside aliases (ctrl shift alt super enter esc tab space backspace delete insert up down left right home end pageup pagedown print menu pause). Check a combo without firing it: 'linux-use key alt+F4 --dry-run'."))
	g = append(g, jstr("'key' needs X11: it maps keysyms through the active keyboard layout via XTEST. On Wayland it will fail — use 'act' instead."))
	g = append(g, jstr("state/find run a SERVER-SIDE collection query when you pass --role (measured ~9x faster on a large app: 5ms vs 47ms) and a recursive tree walk otherwise. The `method` field says which ran; force either with --collection / --walk."))
	g = append(g, jstr("A collection result may contain elements with ref_ok:false — matched, on screen, but their path could not be proven, so no ref is given. They are still listed rather than dropped. Use --walk if you need a ref for every element."))
	g = append(g, jstr("Valid --role names come from `linux-use roles` (130 of them, 18 interactive by default). An unrecognised role matches nothing and warns on stderr."))
	g = append(g, jstr("watch's memory grows ~0.14 kB per event — that is libatspi's event delivery on at-spi2-core 2.44, not linux-use (a no-op callback leaks identically). For a long-lived listener pass --max-rss <kB> and restart on exit 90, or bound the run with --duration/--max-events."))
	g = append(g, jstr("watch takes --role too, which is the cheapest way to cut event noise: filtering to one role took a sample run from 54 events to the 6 that mattered."))
	g = append(g, jstr("watch emits a ref plus ref_ok. ref_ok:false means the path could not be reconstructed reliably — use the app/role/name fields, do not fabricate a ref."))
	g = append(g, jstr("For a label whose NAME IS ITS TEXT, the fingerprint changes whenever the text changes, so a ref captured from an event will report ref_stale on the next read. That is the mechanism working: the staleness IS the signal that the content changed. Re-run state, or drop the #fingerprint to address the path alone."))
	g = append(g, jstr("OBSERVER EFFECT: reading the tree (state/find) can itself make toolkits emit accessibility events. If you run 'watch' while also polling 'state', expect self-induced noise — especially object:state-changed:*, which is why it is not in the default event set."))
	g = append(g, jstr("Large apps (browsers) have huge trees. Use --role, --depth, or 'find' rather than dumping everything; a truncated walk warns on stderr and sets truncated:true."))
	c = append(c, jkv("gotchas", jarr(g)))

	e := []string{}
	e = append(e, jstr("0 ok | 80 usage | 81 no_a11y | 82 app_not_found | 83 ref_stale | 84 ref_not_found | 85 no_capability | 86 action_failed | 87 no_display | 88 daemon | 89 refused | 90 rss_limit (watch hit --max-rss; restart it)"))
	c = append(c, jkv("exit_codes", jarr(e)))

	o := []string{}
	o = append(o, jstr("stdout is JSON only — the answer. stderr carries warnings and progress. Branch on the exit code and error.code, never on message text."))
	o = append(o, jstr("Errors carry recoverable:true/false and a suggestions[] array telling you what to do next. Follow the suggestion before retrying."))
	c = append(c, jkv("output_contract", jarr(o)))

	d := []string{}
	d = append(d, jstr("Each invocation connects to the AT-SPI bus from cold. For repeated calls run 'linux-use daemon start' and the registry stays warm."))
	c = append(c, jkv("daemon", jarr(d)))

	r = "{" + join(c, ",") + "}"
}

func guide_human() (r) {
	ls := []string{}
	ls = append(ls, "linux-use " + VERSION + " — GUI control for Linux at the accessibility layer.")
	ls = append(ls, "")
	ls = append(ls, "THE LOOP")
	ls = append(ls, "  apps  ->  state --app X  ->  act/type/key/click  ->  read/state (verify)")
	ls = append(ls, "")
	ls = append(ls, "REFS")
	ls = append(ls, "  'gnome-calculator:/0/1/0/3#824713' = app : child-path # fingerprint(role+name).")
	ls = append(ls, "  Pass them back verbatim. Stale refs are detected (exit 83), never guessed at.")
	ls = append(ls, "")
	ls = append(ls, "ACT vs CLICK")
	ls = append(ls, "  act   — the widget's own accessible action. No focus, no pointer, works occluded.")
	ls = append(ls, "  click — synthetic XTEST pointer. Fallback for widgets exposing no action.")
	ls = append(ls, "")
	ls = append(ls, "GOTCHAS")
	ls = append(ls, "  SHOWING != visible to the user (an occluded widget is still SHOWING).")
	ls = append(ls, "  0 elements means 'no accessibility', not 'empty window'.")
	ls = append(ls, "  key needs X11. Wayland: use act.")
	ls = append(ls, "")
	ls = append(ls, "Run 'linux-use guide' for the full JSON version, 'linux-use help-json' for the surface.")
	r = join(ls, "\n")
}

func helpjson() (r) {
	cmds := []string{}
	cmds = append(cmds, "{"+jkv("name", jstr("apps"))+","+jkv("args", jarr([]string{}))+","+jkv("summary", jstr("list applications with pid, toolkit and window count; flags ambiguous names"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("windows"))+","+jkv("args", jarr([]string{jstr("--app")}))+","+jkv("summary", jstr("list top-level windows with geometry and active state"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("state"))+","+jkv("args", jarr([]string{jstr("--app (required)"), jstr("--depth"), jstr("--role"), jstr("--all")}))+","+jkv("summary", jstr("interactive elements of an app, with refs"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("find"))+","+jkv("args", jarr([]string{jstr("<query>"), jstr("--app"), jstr("--role"), jstr("--depth")}))+","+jkv("summary", jstr("search elements by name substring"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("act"))+","+jkv("args", jarr([]string{jstr("<ref>"), jstr("--action N")}))+","+jkv("summary", jstr("invoke the element's accessible action (preferred)"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("read"))+","+jkv("args", jarr([]string{jstr("<ref>")}))+","+jkv("summary", jstr("read an element's text, name and description"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("type"))+","+jkv("args", jarr([]string{jstr("<ref>"), jstr("<text>"), jstr("--replace"), jstr("--allow-password")}))+","+jkv("summary", jstr("insert text via the editable-text interface"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("paste"))+","+jkv("args", jarr([]string{jstr("<text>"), jstr("--no-restore")}))+","+jkv("summary", jstr("put text on the clipboard and ctrl+v it — the safe way to type into Chromium"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("sendtext"))+","+jkv("args", jarr([]string{jstr("<text>"), jstr("--via auto|clipboard|atspi")}))+","+jkv("summary", jstr("type a literal string at the current focus (no ref; works without a11y)"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("key"))+","+jkv("args", jarr([]string{jstr("<combo>"), jstr("--dry-run")}))+","+jkv("summary", jstr("send a key combo via XTEST, e.g. ctrl+shift+t"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("click"))+","+jkv("args", jarr([]string{jstr("<ref>"), jstr("--x"), jstr("--y"), jstr("--button")}))+","+jkv("summary", jstr("synthetic pointer click at an element or coordinates"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("launch"))+","+jkv("args", jarr([]string{jstr("<command>"), jstr("--wait-for"), jstr("--timeout")}))+","+jkv("summary", jstr("spawn a program, optionally waiting for it to register"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("watch"))+","+jkv("args", jarr([]string{jstr("--app"), jstr("--role"), jstr("--events"), jstr("--max-events"), jstr("--duration"), jstr("--max-rss")}))+","+jkv("summary", jstr("stream AT-SPI events as NDJSON — block on UI change instead of polling"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("pointer"))+","+jkv("args", jarr([]string{}))+","+jkv("summary", jstr("current pointer position"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("roles"))+","+jkv("args", jarr([]string{}))+","+jkv("summary", jstr("every valid --role name, with which are interactive by default"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("doctor"))+","+jkv("args", jarr([]string{}))+","+jkv("summary", jstr("environment health: session type, a11y bus, XTEST"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("serve"))+","+jkv("args", jarr([]string{jstr("--port")}))+","+jkv("summary", jstr("run the warm-registry HTTP daemon in the foreground"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("daemon"))+","+jkv("args", jarr([]string{jstr("start|stop|status"), jstr("--port")}))+","+jkv("summary", jstr("manage the background daemon"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("guide"))+","+jkv("args", jarr([]string{jstr("--human")}))+","+jkv("summary", jstr("the full operator manual"))+"}")
	cmds = append(cmds, "{"+jkv("name", jstr("version"))+","+jkv("args", jarr([]string{}))+","+jkv("summary", jstr("version string"))+"}")
	r = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("tool", jstr("linux-use")) + "," + jkv("version", jstr(VERSION)) + "," + jkv("commands", jarr(cmds)) + "}"
}

// ---------------------------------------------------------------- daemon

var srv_port = 7777

func health_json() (r) {
	napps := 0
	if desktop != 0 {
		napps = atspi_accessible_get_child_count(desktop, 0)
	}
	r = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("tool", jstr("linux-use")) + "," + jkv("version", jstr(VERSION)) + "," + jkv("warm", jbool(desktop != 0)) + "," + jkv("applications", str(napps)) + "," + jkv("port", str(srv_port)) + "}"
}

func lu_route(req) (res) {
	if req.path == "/_health" {
		res = ok_json(health_json())
		return
	}
	if req.path == "/_shutdown" {
		if req.method != "POST" {
			res = response("405 Method Not Allowed", "application/json", errjson("method_not_allowed", "POST required", true, []string{"use POST /_shutdown"}))
			return
		}
		write(2, "linux-use: shutdown requested\n")
		res = ok_json("{" + jkv("ok", "true") + "," + jkv("stopping", "true") + "}")
		flush()
		exit(0)
		return
	}
	if has_prefix(req.path, "/v1/") {
		rest := param(req.path, "/v1/")
		argv := []string{"linux-use"}
		parts := split(rest, "/")
		i := 0
		while i < len(parts) {
			if len(parts[i]) > 0 {
				argv = append(argv, replace(parts[i], "%20", " "))
			}
			i = i + 1
		}
		out, code := run_cmd(argv)
		if code == EX_OK {
			res = ok_json(out)
		} else {
			res = response("400 Bad Request", "application/json", out)
		}
		return
	}
	res = response("404 Not Found", "application/json", errjson("not_found", "no such endpoint", true, []string{"GET /_health", "POST /_shutdown", "GET /v1/<command>/<arg>/..."}))
}

func cmd_serve(port) (out, code) {
	code = EX_OK
	out = ""
	if !a11y_up() {
		write(2, "linux-use: WARNING starting without an AT-SPI connection\n")
	}
	write(2, "linux-use " + VERSION + " serving on 127.0.0.1:" + str(port) + " (warm registry)\n")
	serve(port, func(req) { return lu_route(req) })
}

func daemon_health(port) (up, body) {
	st, b, e := http_get("http://127.0.0.1:" + str(port) + "/_health")
	up = st == 200 && len(e) == 0
	body = b
}

func cmd_daemon(sub, port) (out, code) {
	code = EX_OK
	if sub == "status" {
		up, body := daemon_health(port)
		if up {
			out = body
			return
		}
		out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "false") + "," + jkv("running", "false") + "," + jkv("port", str(port)) + "}"
		return
	}
	if sub == "start" {
		up, body := daemon_health(port)
		if up {
			out = body
			return
		}
		self := args()[0]
		system(self + " serve --port " + str(port) + " >>/tmp/linux-use-daemon.log 2>&1 &")
		waited := 0
		while waited < 5000 {
			sleep(200)
			waited = waited + 200
			u2, b2 := daemon_health(port)
			if u2 {
				out = b2
				return
			}
		}
		code = EX_DAEMON
		out = errjson("daemon_start_failed", "daemon did not become healthy within 5s", true, []string{"check /tmp/linux-use-daemon.log", "try: linux-use serve --port " + str(port) + " (foreground)"})
		return
	}
	if sub == "stop" {
		up, _ := daemon_health(port)
		if !up {
			out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("stopped", "true") + "," + jkv("was_running", "false") + "}"
			return
		}
		_, _, _ = http_request("POST", "http://127.0.0.1:"+str(port)+"/_shutdown", []string{}, "")
		waited := 0
		while waited < 3000 {
			sleep(200)
			waited = waited + 200
			u2, _ := daemon_health(port)
			if !u2 {
				out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("ok", "true") + "," + jkv("stopped", "true") + "," + jkv("was_running", "true") + "}"
				return
			}
		}
		code = EX_DAEMON
		out = errjson("daemon_stop_failed", "daemon still healthy after shutdown request", true, []string{"kill it manually: pkill -f 'linux-use serve'"})
		return
	}
	code = EX_USAGE
	out = errjson("bad_subcommand", "daemon takes start|stop|status", true, []string{"linux-use daemon status"})
}

// ---------------------------------------------------------------- dispatch

func need_a11y() (out, code) {
	out = ""
	code = EX_OK
	if !a11y_up() {
		code = EX_NO_A11Y
		out = errjson("no_a11y", "cannot reach the AT-SPI accessibility bus", false, []string{"run: linux-use doctor", "enable it: gsettings set org.gnome.desktop.interface toolkit-accessibility true"})
	}
}

func run_cmd(argv) (out, code) {
	out = ""
	code = EX_OK
	if len(argv) < 2 {
		code = EX_USAGE
		out = errjson("no_command", "no command given", true, []string{"run: linux-use guide", "or: linux-use help-json"})
		return
	}
	cmd := argv[1]
	rest := argv[1:len(argv)]

	fs := new_flags("linux-use")
	fs = flag_str(fs, "app", "a", "", "target application name")
	fs = flag_str(fs, "role", "r", "", "filter by accessible role")
	fs = flag_int(fs, "depth", "d", "64", "maximum tree depth")
	fs = flag_int(fs, "max-nodes", "", "20000", "node budget for a walk")
	fs = flag_int(fs, "max-events", "", "0", "stop after N events (0 = unlimited)")
	fs = flag_int(fs, "duration", "", "0", "stop after N ms (0 = unlimited)")
	fs = flag_int(fs, "max-rss", "", "0", "watch: exit 90 above this RSS in kB (0 = unlimited)")
	fs = flag_str(fs, "events", "e", "", "comma-separated AT-SPI event types")
	fs = flag_str(fs, "via", "", "", "sendtext mechanism: auto|clipboard|atspi")
	fs = flag_int(fs, "port", "p", "7777", "daemon port")
	fs = flag_int(fs, "pid", "", "0", "disambiguate --app by process id")
	fs = flag_int(fs, "x", "", "-1", "pointer x")
	fs = flag_int(fs, "y", "", "-1", "pointer y")
	fs = flag_int(fs, "button", "b", "1", "mouse button")
	fs = flag_int(fs, "action", "", "0", "action index")
	fs = flag_int(fs, "timeout", "t", "8000", "timeout in ms")
	fs = flag_str(fs, "wait-for", "w", "", "app name to wait for after launch")
	fs = flag_bool(fs, "all", "", "include non-interactive nodes")
	fs = flag_bool(fs, "dry-run", "", "key: resolve the combo without sending it")
	fs = flag_bool(fs, "no-restore", "", "paste: do not restore the previous clipboard")
	fs = flag_bool(fs, "walk", "", "force the recursive tree walk")
	fs = flag_bool(fs, "collection", "", "force a server-side collection query")
	fs = flag_bool(fs, "replace", "", "replace existing text instead of inserting")
	fs = flag_bool(fs, "allow-password", "", "permit typing into a password field")
	fs = flag_bool(fs, "human", "", "human-readable output (guide only)")
	fs = parse_flags(fs, rest)
	pos := flag_args(fs)

	wantAll = flag_on(fs, "all")
	// Policy, from measurement: a collection query wins in proportion to how
	// SELECTIVE it is (9x with a --role filter on a big app; a wash when asking
	// for every interactive role, where per-match path reconstruction eats the
	// gain and some matches come back unpathable). So: collection when a role
	// filter narrows it, the walk otherwise. Either can be forced.
	// v0.4: with the climb memoized, a collection query is 2-5x faster than the
	// walk, so it is tried FIRST for every query. If any match comes back
	// without a provable ref, the query is re-run as a walk — a complete answer
	// beats a fast one. --collection keeps the fast result (with ref_ok:false
	// entries); --walk skips the query entirely.
	forceCollection = flag_on(fs, "collection")
	forceWalk = flag_on(fs, "walk") || flag_on(fs, "all")
	wantRole = flag_get(fs, "role")
	wantText = ""
	depth := flag_int_val(fs, "depth")
	maxnodes := flag_int_val(fs, "max-nodes")
	wantPid = flag_int_val(fs, "pid")
	port := flag_int_val(fs, "port")

	if cmd == "guide" {
		if flag_on(fs, "human") {
			out = guide_human()
			return
		}
		out = guide_json()
		return
	}
	if cmd == "help-json" {
		out = helpjson()
		return
	}
	if cmd == "version" {
		out = "{" + jkv("schema", jstr(SCHEMA)) + "," + jkv("tool", jstr("linux-use")) + "," + jkv("version", jstr(VERSION)) + "}"
		return
	}
	if cmd == "roles" {
		e2, c2 := need_a11y()
		if c2 != EX_OK {
			out = e2
			code = c2
			return
		}
		out, code = cmd_roles()
		return
	}
	if cmd == "doctor" {
		out, code = cmd_doctor()
		return
	}
	if cmd == "serve" {
		out, code = cmd_serve(port)
		return
	}
	if cmd == "daemon" {
		sub := "status"
		if len(pos) > 0 {
			sub = pos[0]
		}
		out, code = cmd_daemon(sub, port)
		return
	}
	if cmd == "pointer" {
		out, code = cmd_pointer()
		return
	}
	if cmd == "sendtext" {
		e2, c2 := need_a11y()
		if c2 != EX_OK {
			out = e2
			code = c2
			return
		}
		t := ""
		if len(pos) > 0 {
			t = pos[0]
		}
		out, code = cmd_sendtext(t, flag_get(fs, "via"))
		return
	}
	if cmd == "paste" {
		t := ""
		if len(pos) > 0 {
			t = pos[0]
		}
		out, code = cmd_paste(t, !flag_on(fs, "no-restore"))
		return
	}
	if cmd == "key" {
		if len(pos) < 1 {
			code = EX_USAGE
			out = errjson("missing_arg", "key needs a combo", true, []string{"example: linux-use key ctrl+shift+t"})
			return
		}
		out, code = cmd_key(pos[0], flag_on(fs, "dry-run"))
		return
	}

	// everything below needs the accessibility bus
	e, c := need_a11y()
	if c != EX_OK {
		out = e
		code = c
		return
	}

	if cmd == "apps" {
		out, code = cmd_apps()
		return
	}
	if cmd == "windows" {
		out, code = cmd_windows(flag_get(fs, "app"))
		return
	}
	if cmd == "state" {
		appname := flag_get(fs, "app")
		if len(appname) == 0 && len(pos) > 0 {
			appname = pos[0]
		}
		if len(appname) == 0 {
			code = EX_USAGE
			out = errjson("missing_app", "state needs --app <name>", true, []string{"run: linux-use apps"})
			return
		}
		out, code = cmd_state(appname, depth, maxnodes)
		return
	}
	if cmd == "watch" {
		out, code = cmd_watch(flag_get(fs, "app"), flag_get(fs, "role"), flag_get(fs, "events"), flag_int_val(fs, "max-events"), flag_int_val(fs, "duration"), flag_int_val(fs, "max-rss"))
		return
	}
	if cmd == "find" {
		if len(pos) < 1 {
			code = EX_USAGE
			out = errjson("missing_query", "find needs a query string", true, []string{"example: linux-use find Save --app gedit"})
			return
		}
		out, code = cmd_find(pos[0], flag_get(fs, "app"), depth, maxnodes)
		return
	}
	if cmd == "act" {
		if len(pos) < 1 {
			code = EX_USAGE
			out = errjson("missing_ref", "act needs a ref", true, []string{"get one from: linux-use state --app <app>"})
			return
		}
		out, code = cmd_act(pos[0], flag_get(fs, "action"))
		return
	}
	if cmd == "read" {
		if len(pos) < 1 {
			code = EX_USAGE
			out = errjson("missing_ref", "read needs a ref", true, []string{"get one from: linux-use state --app <app>"})
			return
		}
		out, code = cmd_read(pos[0])
		return
	}
	if cmd == "type" {
		if len(pos) < 2 {
			code = EX_USAGE
			out = errjson("missing_arg", "type needs <ref> <text>", true, []string{"example: linux-use type 'gedit:/0/1#123' hello"})
			return
		}
		out, code = cmd_type(pos[0], pos[1], flag_on(fs, "replace"), flag_on(fs, "allow-password"))
		return
	}
	if cmd == "click" {
		ref := ""
		if len(pos) > 0 {
			ref = pos[0]
		}
		px := flag_int_val(fs, "x")
		py := flag_int_val(fs, "y")
		if len(ref) == 0 && (px < 0 || py < 0) {
			code = EX_USAGE
			out = errjson("missing_target", "click needs a <ref> or --x/--y", true, []string{"example: linux-use click --x 100 --y 200"})
			return
		}
		out, code = cmd_click(ref, px, py, flag_int_val(fs, "button"))
		return
	}
	if cmd == "launch" {
		if len(pos) < 1 {
			code = EX_USAGE
			out = errjson("missing_command", "launch needs a command", true, []string{"example: linux-use launch gnome-calculator --wait-for gnome-calculator"})
			return
		}
		out, code = cmd_launch(pos[0], flag_get(fs, "wait-for"), flag_int_val(fs, "timeout"))
		return
	}

	code = EX_USAGE
	out = errjson("unknown_command", "no such command '"+cmd+"'", true, []string{"run: linux-use help-json"})
}

func main() {
	out, code := run_cmd(args())
	if len(out) > 0 {
		println(out)
	}
	exit(code)
}
